  {k: "llm-v1:H4:564:A1", r: "ba8d9dd3-5268-314c-8903-1a8c587cf84e", act: "other", obj: "Kammergerichtsurteil Eppstein-Königstein gegen Kaspar Reyprecht", y: null, ev: "beurkundet das Kammergerichtsurteil im Prozeß Eberhards von Eppstein-Königstein", f: "Summary"},
