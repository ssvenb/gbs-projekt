UNWIND [
  {k: "llm-v1:H4:1047:A1", r: "bde6db42-db68-339c-b643-6e12c9fb25f2", act: "commission", obj: "Prozeß This uff dem Berg gegen Johann von Stralen", y: null, ev: "eine Kommission zur Entscheidung des Prozesses", f: "Summary"}
