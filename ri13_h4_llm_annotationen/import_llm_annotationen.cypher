  {k: "llm-v1:H4:6:A1", r: "f786ada4-0716-3c82-97e8-6d14efff5c82", act: "communication", obj: null, y: null, ev: "Kg. F. schreibt an Gf. Johann von Nassau und die Stadt Wetzlar.", f: "Summary"},
