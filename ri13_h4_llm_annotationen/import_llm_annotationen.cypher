  {k: "llm-v1:H4:590:A1", r: "54ff77bb-b8bc-30ea-81f0-ebcb28bfe4d2", act: "summons", obj: "verlegter Augsburger Tag (6. Januar 1474)", y: null, ev: "ihre bevollmächtigte Botschaft an diesem Tag bei ihm in Augsburg zu haben", f: "Summary"},
