  {k: "llm-v1:H4:28:A1", r: "03c20ad7-9810-3118-a3b8-8ebb42d2f770", act: "communication", obj: "Nachricht von der Krönung in Aachen", y: null, ev: "Kg. F. benachrichtigt Bürgermeister, Schöffen und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:28:A2", r: "03c20ad7-9810-3118-a3b8-8ebb42d2f770", act: "credential", obj: null, y: null, ev: "beglaubigt seinen Diener Hans von Tirna", f: "Summary"},
  {k: "llm-v1:H4:29:A1", r: "3f7ecac1-ab68-3765-a027-e6487532f585", act: "commission", obj: "Lossprechung Rostocks von der Acht", y: null, ev: "ermächtigt ihn, diese von der durch K. Sigmund über sie verhängten Acht und Aberacht loszusprechen", f: "Summary"},
  {k: "llm-v1:H4:30:A1", r: "e12b41dc-3b24-3bc0-9bbc-e0c7121fb735", act: "privilege_confirmation", obj: "Privilegien der Stadt Oppenheim", y: null, ev: "Kg. F. bestätigt die Privilegien", f: "Summary"},
  {k: "llm-v1:H4:31:A1", r: "6d3e7039-b8eb-3ef9-b97a-2016d1cac590", act: "privilege_confirmation", obj: "zwei Jahresmessen und alle Privilegien der Vorgänger", y: null, ev: "Kg. F. bestätigt und erneuert Bürgermeistern, Schöffen, Rat und allen Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:32:A1", r: "2994e2b0-4679-395f-b263-d6b31428c990", act: "commission", obj: "Schutz Katharinas von Ingelheim gegen ihren Bruder Wilhelm", y: null, ev: "Katharina in ihren Rechten zu schützen", f: "Summary"},
  {k: "llm-v1:H4:33:A1", r: "e0879a1d-9428-3bef-993a-affc6c4814d4", act: "privilege_confirmation", obj: "Freiheiten der Frankfurter Juden", y: null, ev: "konfirmierten Freiheiten", f: "Summary"},
  {k: "llm-v1:H4:34:A1", r: "dffd63b3-f204-3113-a08c-73f1b85752cb", act: "enfeoffment", obj: "Dorf Bornheim und sechs Huben Land zu Karben", y: null, ev: "Kg. F. belehnt Sebold Schelm von Bergen", f: "Summary"},
  {k: "llm-v1:H4:35:A1", r: "eb9916c6-2d0b-3ec0-baab-c5cd99582aca", act: "ban_enforcement", obj: "Acht gegen Lüttich, Huy, St. Trond, Hasselt, Tongern und Maastricht", y: null, ev: "verhängte und immer noch bestehende Acht und Aberacht", f: "Summary"},
  {k: "llm-v1:H4:36:A1", r: "66f5a391-917c-3f5f-83db-48a91687e23c", act: "ban_enforcement", obj: "Acht gegen Hans von Hemstet und holländische Städte", y: null, ev: "verhängte und immer noch bestehende Acht und Aberacht", f: "Summary"},
  {k: "llm-v1:H4:37:A1", r: "68130cdc-d2d8-31ad-ba57-f777bcfb41f4", act: "privilege_confirmation", obj: "Freiheit von auswärtigen Gerichten", y: null, ev: "gewährte Freiheit von auswärtigen Gerichten", f: "Summary"},
  {k: "llm-v1:H4:38:A1", r: "6be4eb71-3cbe-3c8d-b63e-9a2e92dd7dc1", act: "consent", obj: "Verkauf eines Anteils an Schloß Rödelheim an die Stadt Frankfurt", y: null, ev: "erteilt auf Ersuchen Wenzels von Cleen seine Zustimmung", f: "Summary"},
  {k: "llm-v1:H4:39:A1", r: "925c9a3f-cc96-36b6-b2a3-433d655fdfb5", act: "ban_release", obj: "Lösung Rostocks aus der Acht", y: null, ev: "von des heiligen reichs aht und aberaht frei", f: "Summary"},
  {k: "llm-v1:H4:40:A1", r: "0d1d480d-697d-36fb-8062-edb057dbaed2", act: "privilege_confirmation", obj: "Privilegien des Bartholomäusstifts und geistlicher Gerichtsstand", y: null, ev: "alle ihre von seinen Vorgängern und ihm redlich erlangten", f: "Summary"},
  {k: "llm-v1:H4:41:A1", r: "95acbab9-a38f-304b-93af-87bee190e58d", act: "public_peace", obj: "Königliche Reformation (Reformatio Friderici)", y: null, ev: "Reformatio Friderici", f: "Summary"},
  {k: "llm-v1:H4:42:A1", r: "1716ad6e-8942-3aa0-99bb-dd5ea453eda4", act: "mandate", obj: "Umsiedlung der Juden und Abriß der Synagoge", y: null, ev: "die Juden binnen Jahresfrist an einer anderen Stelle der Stadt anzusiedeln", f: "Summary"},
  {k: "llm-v1:H4:43:A1", r: "3e4a788a-a55f-385f-b2d7-522f3f079bd4", act: "commission", obj: "Beilegung des Streits zwischen Eberhard von Eppstein-Königstein und Sulzbach und Soden", y: null, ev: "erteilt Schenk Konrad von Erbach eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:44:A1", r: "1ecb6449-b112-3001-9f89-ed10f8ec15d7", act: "mandate", obj: "Masmünster nicht weiter zu beschweren", y: null, ev: "Er gebietet ihnen deshalb, die von Masmünster nicht länger", f: "Summary"},
  {k: "llm-v1:H4:45:A1", r: "abd8e07d-a3f0-3467-86cb-e34984c46c7c", act: "request", obj: "Unwillen gegen Frankfurt abzustellen", y: null, ev: "bittet er den Ldgf. seinen Unwillen gegen die Frankfurter", f: "Summary"},
  {k: "llm-v1:H4:46:A1", r: "d69ba2d1-230d-386a-843e-13f1e8a61916", act: "consent", obj: "Verkauf von 25 Mark auf der Frankfurter Judenbede an die Stadt", y: null, ev: "seine Einwilligung zu dem Verkauf von 25 Mark Geld", f: "Summary"},
  {k: "llm-v1:H4:47:A1", r: "2583e29b-3969-3439-882e-bf67a7b6bdbe", act: "consent", obj: "Verkauf eines Hauses am Bruckenhof in Frankfurt", y: null, ev: "seine Zustimmung zu dem von jenem an diesen vorgenommenen Verkauf", f: "Summary"},
  {k: "llm-v1:H4:48:A1", r: "9e75bc18-3864-3933-bbf5-1efa16fb68ff", act: "prohibition", obj: "Prozeß Frankfurt gegen Neumarkt um Zollfreiheit", y: null, ev: "nichts mehr zu unternehmen, was den Frankfurtern zum Schaden gereicht", f: "Summary"},
  {k: "llm-v1:H4:49:A1", r: "4271d6ea-3987-346f-86c9-940ba45f2078", act: "prohibition", obj: "wie n. 48", y: null, ev: "Kg. F. desgleichen an Bürgermeister und Rat der Stadt Neumarkt.", f: "Summary"},
  {k: "llm-v1:H4:50:A1", r: "0f7f5d0f-5824-3027-a370-143a95d2906f", act: "mandate", obj: "Verfahren ruhen lassen und Henne Salmensnyder freilassen", y: null, ev: "die Sache am Landgericht so ruhen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:51:A1", r: "e48e6627-e002-3ffb-97f9-3eab78ad8cb6", act: "communication", obj: "Inhalt des Mandats an das Landgericht Nürnberg im Zollstreit Frankfurt – Neumarkt", y: null, ev: "ausführlich den Inhalt seines am gleichen Tag", f: "Summary"},
  {k: "llm-v1:H4:51:A2", r: "e48e6627-e002-3ffb-97f9-3eab78ad8cb6", act: "request", obj: "Durchsetzung des Mandats beim Landrichter", y: null, ev: "bittet den Mgf. dafür zu sorgen", f: "Summary"},
  {k: "llm-v1:H4:52:A1", r: "0f1bf4fc-0e53-34ab-85f1-21e045b5ca01", act: "consent", obj: "Verkauf eines Anteils an Schloß Rödelheim an die Stadt Frankfurt", y: null, ev: "seine Zustimmung zu dem von diesem und seiner Frau", f: "Summary"},
  {k: "llm-v1:H4:53:A1", r: "2ac5e14a-355d-3213-a297-957c4aaccf1d", act: "prohibition", obj: "Prozeß des Freistuhls Freienhagen gegen Frankfurt", y: null, ev: "die Ladung und die gesamte Prozeßführung gegen die unsern von Frankfurt abzustellen", f: "Summary"},
  {k: "llm-v1:H4:54:A1", r: "d64da678-60ba-3920-964b-02aeaab7203d", act: "prohibition", obj: "Verfolgung Frankfurts durch die heimlichen Gerichte", y: null, ev: "die Prozeßführung gänzlich abzustellen", f: "Summary"},
  {k: "llm-v1:H4:54:A2", r: "d64da678-60ba-3920-964b-02aeaab7203d", act: "summons", obj: "Rechttag nach dem 14. Februar 1443", y: null, ev: "setzt beiden Parteien mit diesem Brief einen Termin", f: "Summary"},
  {k: "llm-v1:H4:55:A1", r: "1734a38a-dfa3-3f9b-aa1c-2560f3d1ade7", act: "request", obj: "Förderung des Hans Frideregger", y: null, ev: "Kg. F. bittet Bürgermeister und Rat der Stadt Frankfurt um Förderung", f: "Summary"},
  {k: "llm-v1:H4:56:A1", r: "728f8340-a868-3e16-871a-914cb82f85a8", act: "communication", obj: "Ungültigkeit des Freistuhlverfahrens gegen Frankfurt", y: null, ev: "Kg. F. teilt allen Kff. besonders Eb. Dietrich von Köln", f: "Summary"},
  {k: "llm-v1:H4:56:A2", r: "728f8340-a868-3e16-871a-914cb82f85a8", act: "mandate", obj: "Schutz Frankfurts gegen Übergriffe", y: null, ev: "die Frankfurter gegen jeden durch den Ldgf. durch Mangold oder jemand anderen vorgenommenen Übergriff", f: "Summary"},
  {k: "llm-v1:H4:57:A1", r: "b3714476-196b-3616-a92c-6ded08e7aac7", act: "communication", obj: "Ungültigkeit der Prozeßführung am Landgericht Nürnberg gegen Frankfurt", y: null, ev: "erklärt Kg. F. die gesamte am Nürnberger Landgericht vorgenommene Prozeßführung für ungültig", f: "Summary"},
  {k: "llm-v1:H4:57:A2", r: "b3714476-196b-3616-a92c-6ded08e7aac7", act: "mandate", obj: "Schutz Frankfurts", y: null, ev: "den jederzeitigen Schutz Frankfurts gegen mögliche Angriffe", f: "Summary"},
  {k: "llm-v1:H4:58:A1", r: "fb56b9ca-bdb7-31a8-a8e5-6dad08fa4f70", act: "prohibition", obj: "Vorgehen des Dortmunder Freistuhls gegen Frankfurt", y: null, ev: "jegliches Vorgehen unser(s) und des reichs stul(s) in Dortmund gegen die Frankfurter abzustellen", f: "Summary"},
  {k: "llm-v1:H4:59:A1", r: "8c64694c-eb8b-3694-b11e-8aaa082675e2", act: "commission", obj: "Prozeß gegen den Freigrafen Mangold", y: null, ev: "Er ernennt Dietrich deshalb zum Kommissar und Richter in dieser Sache", f: "Summary"},
  {k: "llm-v1:H4:60:A1", r: "4af8a95f-1684-3063-83b8-e62adea15fdd", act: "commission", obj: "Klage gegen Mangold als Prokuratoren des Fiskus", y: null, ev: "als unser procuratores fisci", f: "Summary"},
  {k: "llm-v1:H4:61:A1", r: "48641204-5b0a-355f-953e-5aa5c8446bcb", act: "commission", obj: "Erhebung einer Krönungssteuer von den Juden", y: null, ev: "beauftragt Lic. iur. Ulrich Riederer und Jakob Vaist", f: "Summary"},
  {k: "llm-v1:H4:62:A1", r: "ac09aa03-f646-3414-af32-48d18b543187", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "in unser und des reichs acht mit recht und urteil verurteilt", f: "Summary"},
  {k: "llm-v1:H4:63:A1", r: "0cbab8b4-7883-3529-a1dc-5fd2f71e6b7e", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "ausgesprochene und von ihm laut Achtbrief verkündete Acht zu vollziehen", f: "Summary"},
  {k: "llm-v1:H4:64:A1", r: "244dd582-e88e-3d26-9f38-22b36441640b", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Er ersucht ihn deshalb, das Urteil", f: "Summary"},
  {k: "llm-v1:H4:65:A1", r: "348a95df-5cfc-3f76-95ff-d50431c8295e", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "das Urteil zu befolgen", f: "Summary"},
  {k: "llm-v1:H4:66:A1", r: "b63e163f-e8e9-3c97-a86d-6a36822e79eb", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Achturteil gegen Ober-Rosbach mit.", f: "Summary"},
  {k: "llm-v1:H4:67:A1", r: "a894a32d-9612-34ac-bcf6-1391d3503e68", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Achturteil gegen Ober-Rosbach mit.", f: "Summary"},
  {k: "llm-v1:H4:68:A1", r: "cbe2313d-d6b9-3345-a161-f2bcb6aa4310", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Achturteil gegen Ober-Rosbach mit.", f: "Summary"},
  {k: "llm-v1:H4:69:A1", r: "3061670a-efbf-3738-a1fd-807676de7fb0", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Achturteil gegen Ober-Rosbach mit.", f: "Summary"},
  {k: "llm-v1:H4:70:A1", r: "aaaa5055-921d-3b0c-80e3-a99a210cc059", act: "ban_enforcement", obj: "Acht gegen Ober-Rosbach", y: null, ev: "Achturteil gegen Ober-Rosbach mit.", f: "Summary"},
  {k: "llm-v1:H4:71:A1", r: "bc1de63a-7895-3595-987c-563de87f7eee", act: "credential", obj: null, y: null, ev: "Kg. F. beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt Elogien von Naw", f: "Summary"},
  {k: "llm-v1:H4:71:A2", r: "bc1de63a-7895-3595-987c-563de87f7eee", act: "mandate", obj: "Zahlung der verfallenen Stadtsteuer an Elogien von Naw", y: null, ev: "fordert sie auf, diesem gegen Übergabe der königlichen Quittung", f: "Summary"},
  {k: "llm-v1:H4:72:A1", r: "6409a914-418a-321e-ae9f-e03225cf0581", act: "enfeoffment", obj: "Anteil an Dorf und Gericht Rödelheim", y: null, ev: "Kg. F. belehnt auf Frankfurter Ersuchen", f: "Summary"},
  {k: "llm-v1:H4:73:A1", r: "80129ba5-1baa-3bd8-ac23-379e68fac4fd", act: "receipt", obj: "Stadtsteuer", y: 1443, ev: "Kg. F. quittiert Bürgermeistern, Schöffen und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:74:A1", r: "ad9727b9-4877-33ad-aae2-c30de0e7dcc6", act: "communication", obj: "Ankunft in Passau und Reise zum Nürnberger Tag", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:74:A2", r: "ad9727b9-4877-33ad-aae2-c30de0e7dcc6", act: "summons", obj: "Tag zu Nürnberg (1444)", y: null, ev: "ihre Abgesandten unverzüglich und gut instruiert dorthin zu entsenden", f: "Summary"},
  {k: "llm-v1:H4:75:A1", r: "087c6bf7-a453-34a3-b7e9-aec9b0151479", act: "communication", obj: "Ankunft im Reich; Weiterleitung von Einladungen zum Nürnberger Tag", y: null, ev: "übersendet ihnen etliche Einladungsschreiben", f: "Summary"},
  {k: "llm-v1:H4:76:A1", r: "a1874dbd-deb3-3146-b225-cdc1a50e9b2f", act: "communication", obj: "Entsendung Wolfgang Ungnads", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:76:A2", r: "a1874dbd-deb3-3146-b225-cdc1a50e9b2f", act: "mandate", obj: "Zahlung der Stadtsteuer an Wolfgang Ungnad", y: null, ev: "ersucht sie, diesem ihre am sandt Marteins tag (November 11) fällige gewöhnliche Steuer", f: "Summary"},
  {k: "llm-v1:H4:77:A1", r: "e041c229-8148-3998-9e28-e98f31267eec", act: "commission", obj: "Abwehr der Eidgenossen gegen Zürich und das Haus Österreich", y: null, ev: "beauftragt seinen Bruder Hz. Albrecht (VI.) von Österreich", f: "Summary"},
  {k: "llm-v1:H4:78:A1", r: "bed62487-e6af-3cf7-84a3-0c04f5c00e92", act: "communication", obj: "Einfall der Armagnaken", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:78:A2", r: "bed62487-e6af-3cf7-84a3-0c04f5c00e92", act: "mandate", obj: "Stellung von 40 Reisigen nach Straßburg (Reichsanschlag)", y: null, ev: "Er gebietet ihnen, ihren Anteil an diesem Anschlag", f: "Summary"},
  {k: "llm-v1:H4:79:A1", r: "91f843db-fb42-3ada-a87e-282c9f531cfe", act: "mandate", obj: "Stellung von 500 Mann gegen die Armagnaken", y: null, ev: "fordert sie gleich jenen auf, die auf sie veranschlagten 500 person", f: "Summary"},
  {k: "llm-v1:H4:80:A1", r: "d91b7454-70a9-318c-b9ea-52279289005d", act: "mandate", obj: "Anschlag gegen die Armagnaken", y: null, ev: "Kg. F. befiehlt der Stadt Gelnhausen Erfüllung des Anschlags", f: "Summary"},
  {k: "llm-v1:H4:81:A1", r: "b8523689-e0df-30f2-a1a6-93a760d04151", act: "mandate", obj: "Anschlag gegen die Armagnaken", y: null, ev: "Kg. F. befiehlt der Stadt Friedberg Erfüllung des Anschlags", f: "Summary"},
  {k: "llm-v1:H4:82:A1", r: "cd8ac8f6-7b25-399a-a08b-9bde7cdb7b69", act: "mandate", obj: "Anschlag gegen die Armagnaken", y: null, ev: "Erfüllung des Anschlags gegen die Armagnaken", f: "Summary"},
  {k: "llm-v1:H4:83:A1", r: "897678a3-cdca-38dd-9d60-1e52d933c9c7", act: "appointment", obj: "Reichshauptmann gegen die Armagnaken", y: null, ev: "zu seinem und des Reichs Hauptmann", f: "Summary"},
  {k: "llm-v1:H4:83:A2", r: "897678a3-cdca-38dd-9d60-1e52d933c9c7", act: "mandate", obj: "Unterstützung des Reichshauptmanns", y: null, ev: "Kg. F. gebietet allen Kff. Fürsten, Gff. etc. allen Reichsstädten", f: "Summary"},
  {k: "llm-v1:H4:84:A1", r: "69e9713f-38ff-385d-a3e8-3c640e39dbea", act: "commission", obj: "Entscheidung der Appellation im Streit um die Pfandschaft Friedberg", y: null, ev: "ernennt er ihn (Gottfried) an seiner Statt zum Richter und commissarien", f: "Summary"},
  {k: "llm-v1:H4:85:A1", r: "cd98f22a-e6c9-3714-8ee5-03f013abdf45", act: "privilege_grant", obj: "Schutz der Reichsstraßen und Messebesucher durch Frankfurt ohne Haftung", y: null, ev: "die Einhaltung dieses durch gemeynes nutzes willen erteilten Privilegs", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 101–200
UNWIND [
  {k: "llm-v1:H4:86:A1", r: "6b98699e-742e-32ab-bf44-b61b2138e887", act: "privilege_confirmation", obj: "Zugehörigkeit von Sulzbach und Soden zum Reich und zu Frankfurt", y: null, ev: "Kg. F. bestätigt den Dörfern Sulzbach und Soden", f: "Summary"},
  {k: "llm-v1:H4:87:A1", r: "37511569-1c98-3720-8afa-b84e7d0250cb", act: "mandate", obj: "Hilfe für Hz. Albrecht VI. gegen die Eidgenossen", y: null, ev: "ermahnt er sie, ihr Versprechen einzulösen", f: "Summary"},
  {k: "llm-v1:H4:88:A1", r: "43df1271-f869-319e-ad18-1677962f6617", act: "prohibition", obj: "Veränderungen am Streitgegenstand während des Aufschubs", y: null, ev: "keinerlei Veränderungen am Gegenstand des noch nicht entschiedenen Prozesses vorzunehmen", f: "Summary"},
  {k: "llm-v1:H4:89:A1", r: "b62f8b7a-1410-30f7-bc24-10d47f5953cc", act: "ban_enforcement", obj: "Aberacht gegen Brügge, Gent, Ypern und das Freie", y: null, ev: "vom Hofgericht in die Aberacht erklärt worden sind", f: "Summary"},
  {k: "llm-v1:H4:90:A1", r: "5b31452b-70c4-37b1-a56d-2c6c4dd8a81d", act: "summons", obj: "Rechttag in der Friedberger Appellationssache (nach 6. März 1446)", y: null, ev: "Er lädt sie wie ihre Gegenpartei deshalb zum nächsten Rechttag", f: "Summary"},
  {k: "llm-v1:H4:90:A2", r: "5b31452b-70c4-37b1-a56d-2c6c4dd8a81d", act: "prohibition", obj: "Veränderungen am Stand der Dinge", y: null, ev: "Er verbietet ihnen wie ihren Prozeßgegnern", f: "Summary"},
  {k: "llm-v1:H4:91:A1", r: "b1d213dd-9c9c-358b-b4bd-d83a44ea4c71", act: "summons", obj: "Rechttag in der Friedberger Appellationssache (nach 6. März 1446)", y: null, ev: "zum nächsten Rechttag nach dem sontag Invocavit", f: "Summary"},
  {k: "llm-v1:H4:92:A1", r: "c1bc7cd1-d0e7-3422-b6e1-3b0ca97f97cb", act: "summons", obj: "Rechttag in der Friedberger Appellationssache (nach 6. März 1446)", y: null, ev: "fordert sie auf, ihre bevollmächtigte Botschaft dazu zu schicken", f: "Summary"},
  {k: "llm-v1:H4:93:A1", r: "ca517ebc-6bf4-3abc-85f3-19e9a972b17a", act: "commission", obj: "Eintreibung der Krönungssteuer und des goldenen Opferpfennigs von den Juden", y: null, ev: "bevollmächtigt seinen Bruder Hz. Albrecht (VI.) von Österreich", f: "Summary"},
  {k: "llm-v1:H4:94:A1", r: "0b1c86e4-4b2b-30c6-9d34-eaa0d57c123f", act: "commission", obj: "Entscheidung im Streit um die Einlösung der Karbener Pfandschaft", y: null, ev: "an seiner Statt beiden Parteien einen Tag vor sich an gelegenem Ort zu setzen", f: "Summary"},
  {k: "llm-v1:H4:95:A1", r: "92ca7339-b6e3-3e81-9d85-f8c0d677dd0a", act: "mandate", obj: "Befolgung der Ladung des Kommissars Reinhard von Hanau", y: null, ev: "der Ladung des Kommissars Folge zu leisten", f: "Summary"},
  {k: "llm-v1:H4:96:A1", r: "3a78ba2a-501e-34fe-8d7f-5bf6f57b83e5", act: "mandate", obj: "Befolgung der Ladung des Kommissars Reinhard von Hanau", y: null, ev: "fordert sie auf, der Ladung seines Kommissars Folge zu leisten", f: "Summary"},
  {k: "llm-v1:H4:97:A1", r: "3ddf3353-8157-30a7-a1e4-330077da6fae", act: "request", obj: "Vorauszahlung von 300 fl. aus der Stadtsteuer an Bf. Sylvester von Chiemsee", y: null, ev: "Er ersucht sie deshalb, seinem Kanzler von der künftigen unser stat stewr im voraus 300 fl. rh. zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:97:A2", r: "3ddf3353-8157-30a7-a1e4-330077da6fae", act: "receipt", obj: "Vorauszahlung auf die Stadtsteuer (300 fl.)", y: 1446, ev: "quittiert diese Zahlung mit diesem Brief", f: "Summary"},
  {k: "llm-v1:H4:98:A1", r: "d37d15c2-be32-3ef3-b830-acf6b7e1e9d6", act: "other", obj: "Beurkundung eines Kammergerichtsurteils (Aufschub in der Friedberger Appellationssache)", y: null, ev: "Kg. F. beurkundet das Urteil", f: "Summary"},
  {k: "llm-v1:H4:99:A1", r: "45084da5-cbad-3109-b0b2-1da6123472d3", act: "prohibition", obj: "Veränderungen am Sachverhalt während des Aufschubs", y: null, ev: "keinerlei Veränderungen am Sachverhalt vorzunehmen", f: "Summary"},
  {k: "llm-v1:H4:100:A1", r: "22ce6f89-5fda-3e7a-9f8d-2d77c0854a90", act: "communication", obj: "Dank für die Vorauszahlung an Bf. Sylvester", y: null, ev: "Kg. F. dankt Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:100:A2", r: "22ce6f89-5fda-3e7a-9f8d-2d77c0854a90", act: "request", obj: "Vorauszahlung des Rests der Stadtsteuer an Bf. Sylvester", y: null, ev: "den Rest der am sand Merteins tag (November 11) fälligen Steuer im voraus zu entrichten", f: "Summary"},
  {k: "llm-v1:H4:100:A3", r: "22ce6f89-5fda-3e7a-9f8d-2d77c0854a90", act: "credential", obj: null, y: null, ev: "beglaubigt Sylvester zu weiteren Mitteilungen", f: "Summary"},
  {k: "llm-v1:H4:101:A1", r: "09242a50-45cd-38c7-b60b-238ba86876a7", act: "receipt", obj: "Stadtsteuer", y: 1446, ev: "Kg. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:102:A1", r: "fc338fa4-3180-370a-8ea6-16e97bb20dfa", act: "mandate", obj: "Abbruch des Burgbaus zu Rödelheim", y: null, ev: "gebietet der Kg. ihm nachdrücklich bei schwerer Ungnade und Strafe, den Bau unverzüglich", f: "Summary"},
  {k: "llm-v1:H4:103:A1", r: "b474082e-85af-32cf-9a4d-addf6123f27c", act: "summons", obj: "Verschiebung des Rechttags in der Friedberger Appellationssache (nach 29. September 1446)", y: null, ev: "lädt beide Parteien in gleicher Weise wie zuvor", f: "Summary"},
  {k: "llm-v1:H4:104:A1", r: "33ef959b-9109-3b58-88ef-b4859187be24", act: "summons", obj: "wie n. 103", y: null, ev: "Kg. F. desgl. an die Burgmannen der Burg zu Friedberg.", f: "Summary"},
  {k: "llm-v1:H4:105:A1", r: "54bbc32d-de48-36ca-a732-13c6a21a0995", act: "communication", obj: "Verlegung des Rechttags mit den Friedberger Burgmannen", y: null, ev: "Kg. F. teilt Eb. Dietrich von Mainz mit", f: "Summary"},
  {k: "llm-v1:H4:106:A1", r: "2dd0edc4-e542-3ef3-b881-c1f7fc4f5aee", act: "mandate", obj: "Abbruch der Bauten zu Rödelheim bei Pön von 100 Mark Gold", y: null, ev: "seine Bauten unverzüglich nach dem Erhalt dieses Mandats abzubrechen", f: "Summary"},
  {k: "llm-v1:H4:107:A1", r: "0f26a9dc-c1fe-3f5b-aff1-5f13a8a87426", act: "mandate", obj: "Konrad von Steeg nicht von der Frankfurter Münze verdrängen zu lassen", y: null, ev: "Kg. F. befiehlt dem Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:108:A1", r: "b7b34c1b-fcc1-34c7-988e-5829be6a966e", act: "summons", obj: "Nürnberger Tag (19. März 1447) im Streit um den Bau zu Rödelheim", y: null, ev: "ihre bevollmächtigte Botschaft zu dem Nürnberger Tag zu schicken", f: "Summary"},
  {k: "llm-v1:H4:109:A1", r: "0a43303a-310b-39df-908c-3ffa75640d67", act: "summons", obj: "Nürnberger Tag (19. März 1447) im Streit um den Bau zu Rödelheim", y: null, ev: "Kg. F. lädt Frank d. A. von Kronberg", f: "Summary"},
  {k: "llm-v1:H4:110:A1", r: "db3d5827-7a04-3c4d-b177-b14ca732fbd3", act: "request", obj: "erstes freiwerdendes Gotteslehen in Frankfurt (Erste Bitte)", y: null, ev: "das erste freiwerdende Gotteslehen in ihrer Stadt zu verleihen", f: "Summary"},
  {k: "llm-v1:H4:111:A1", r: "d281adf3-3ecb-393e-ad63-64146dbfa92d", act: "request", obj: "Zulassung Stefan Walchers als Prokurator für Kaspar Gutentag", y: null, ev: "bittet sie, Stefan Walcher als dessen Prokurator zuzulassen", f: "Summary"},
  {k: "llm-v1:H4:112:A1", r: "a2959d14-ad41-3268-84ec-f73fb183ab8f", act: "other", obj: "Erklärung zur Zuständigkeit des Landgerichts Nürnberg im Prozeß Frankfurt – Neumarkt", y: null, ev: "Kg. F. erläßt zugunsten der Frankfurter eine clerunge", f: "Summary"},
  {k: "llm-v1:H4:113:A1", r: "82df49e0-507a-3eca-8104-118c927b7ae0", act: "commission", obj: "Vertretung des Königs auf dem Nürnberger Tag (19. März 1447)", y: null, ev: "als seine Vertreter zu dem auf Lätare", f: "Summary"},
  {k: "llm-v1:H4:114:A1", r: "4ab57414-b8aa-3e55-9a70-6df09c6f3646", act: "summons", obj: "Rechttag am 12./13. Juli 1447 wegen der Befestigung zu Rödelheim", y: null, ev: "Kg. F. lädt Frank nunmehr persönlich oder seinen Anwalt", f: "Summary"},
  {k: "llm-v1:H4:114:A2", r: "4ab57414-b8aa-3e55-9a70-6df09c6f3646", act: "prohibition", obj: "Veränderungen am strittigen Bau", y: null, ev: "keinerlei Veränderungen an dem strittigen Bau vorzunehmen", f: "Summary"},
  {k: "llm-v1:H4:115:A1", r: "a29567f9-bc92-3511-ba3b-df2668e7596a", act: "communication", obj: "Antwort zum Prozeß gegen Frank von Kronberg", y: null, ev: "Kg. F. antwortet Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:116:A1", r: "09968208-6d35-3f6e-a4b4-1c665484b678", act: "communication", obj: "Antwort zum Bau in Rödelheim; Hinweis auf den Rechttag", y: null, ev: "Kg. F. antwortet Frank (d. A.) von Kronberg", f: "Summary"},
  {k: "llm-v1:H4:117:A1", r: "3ae636e2-b260-3bbf-ab3d-71ff62e3e678", act: "summons", obj: "Verschiebung des Rechttags zu Rödelheim (nach 25. Januar 1448)", y: null, ev: "auf den nächsten Gerichtstag seines Kammergerichts nach sant Pauls tag conversionis", f: "Summary"},
  {k: "llm-v1:H4:118:A1", r: "3538c801-af19-3a32-bfbb-1b4336382d59", act: "mandate", obj: "Schonung Frankfurts und unbeteiligter Städte im Kölner Krieg", y: null, ev: "ermahnt ihn jedoch", f: "Summary"},
  {k: "llm-v1:H4:119:A1", r: "374d7714-c384-33da-8fb8-63904110f6a0", act: "mandate", obj: "Schonung Frankfurts und unbeteiligter Städte im Kölner Krieg", y: null, ev: "ermahnt er aber auch ihn (Wilhelm) dafür zu sorgen", f: "Summary"},
  {k: "llm-v1:H4:120:A1", r: "84373213-f471-3cbe-a92b-6b94d3a7a317", act: "mandate", obj: "Schonung Frankfurts und unbeteiligter Städte", y: null, ev: "Kg. F. ermahnt alle und jeglichen einzelnen der Hauptleute und Führer", f: "Summary"},
  {k: "llm-v1:H4:121:A1", r: "acf96a36-259b-3885-92d3-400726e428f8", act: "summons", obj: "Verschiebung des Rechttags in der Friedberger Appellationssache (nach 25. Januar 1448)", y: null, ev: "Der Kg. verschiebt diesen Rechttag", f: "Summary"},
  {k: "llm-v1:H4:122:A1", r: "13e02e26-41c8-3b1f-af9a-91e525f5e79e", act: "commission", obj: "gütliche Einigung in der Friedberger Appellationssache", y: null, ev: "beauftragt ihn, bis dahin zu versuchen, die Parteien gutlich und in recht zu versöhnen", f: "Summary"},
  {k: "llm-v1:H4:123:A1", r: "5cf8faa5-9731-3754-b5cf-373f84c99860", act: "request", obj: "Beförderung königlicher Briefe nach Oppenheim", y: null, ev: "bittet sie, diese durch ihren eigenen Boten zu befördern", f: "Summary"},
  {k: "llm-v1:H4:124:A1", r: "64a83bfc-8906-3c1a-970b-475c016b759f", act: "communication", obj: "Auseinandersetzungen mit dem Kessler in Oppenheim", y: null, ev: "Kg. F. schreibt an Pfgf. Ludwig (IV.)", f: "Summary"},
  {k: "llm-v1:H4:125:A1", r: "ef9d1971-a927-3bd9-8797-b14e98de0fe1", act: "communication", obj: "Kessler zu Oppenheim", y: null, ev: "Kg. F. schreibt an Pfgf. Otto von Mosbach", f: "Summary"},
  {k: "llm-v1:H4:126:A1", r: "9024ae2d-bdf3-3747-97a3-23ac89e9eef0", act: "communication", obj: null, y: null, ev: "Kg. F. schreibt an den Kessler zu Oppenheim und seine Gesellschaft.", f: "Summary"},
  {k: "llm-v1:H4:127:A1", r: "307c8942-e7dc-3a12-9c99-d64f93b40fa7", act: "other", obj: "Aufkündigung des Geleits für das Basler Konzil", y: null, ev: "sagt dem zu Basel gehaltenen Konzil das kgl. Geleit auf", f: "Summary"},
  {k: "llm-v1:H4:128:A1", r: "f3f5d15d-a017-31f4-81e6-8eac499a902d", act: "mandate", obj: "Aufkündigung des Geleits für das Basler Konzil", y: null, ev: "Kg. F. befiehlt der Stadt Basel, dem dortigen Konzil das Geleit aufzusagen.", f: "Summary"},
  {k: "llm-v1:H4:129:A1", r: "ce8ddfc1-44cf-3a18-a6ef-8fddcc7867c7", act: "communication", obj: "Obödienzerklärung für Papst Nikolaus V.", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:129:A2", r: "ce8ddfc1-44cf-3a18-a6ef-8fddcc7867c7", act: "mandate", obj: "Gehorsam gegenüber Papst Nikolaus V.", y: null, ev: "Er gebietet ihnen, die Entscheidung zu befolgen", f: "Summary"},
  {k: "llm-v1:H4:130:A1", r: "de45e063-b937-3049-bfef-c9302cded220", act: "commission", obj: "Entscheidung des Prozesses Rübsamen gegen Masmünster", y: null, ev: "überträgt seinem Bruder Hz. Albrecht (VI.) von Österreich an seiner Statt die rechtliche Entscheidung", f: "Summary"},
  {k: "llm-v1:H4:131:A1", r: "ccf4bb51-9754-3a8a-b8db-cec9960ab45a", act: "other", obj: "Bestätigung der Kommissarsurteile im Prozeß Rübsamen gegen Masmünster", y: null, ev: "bestätigt die von seinem Bruder Hz. Albrecht (VI.) von Österreich als seinem Kommissar gefällten Urteile", f: "Summary"},
  {k: "llm-v1:H4:132:A1", r: "6c10c392-86ab-3e5e-a221-c26206a7fbc9", act: "mandate", obj: "Unterbindung der Schmähungen Masmünsters und Hilfe bei der Eintreibung des Schadenersatzes", y: null, ev: "Der Kg. gebietet ihnen deshalb", f: "Summary"},
  {k: "llm-v1:H4:133:A1", r: "a0f9f350-ebe9-3f27-91f7-8ac4431b374b", act: "mandate", obj: "Geltung des Apfelguldens zu 24 Weißpfennigen", y: null, ev: "seine und des Reichs Gulden mit dem appfel weiterhin unbeschränkt im Wert von 24 Weißpfennigen", f: "Summary"},
  {k: "llm-v1:H4:134:A1", r: "49e4240d-9327-3129-b6a9-a3a65e164905", act: "mandate", obj: "Schadenersatz von 160 fl. an Kaspar Gutentag", y: null, ev: "Kg. F. fordert Bürgermeister und Rat der Stadt Aachen auf", f: "Summary"},
  {k: "llm-v1:H4:135:A1", r: "6dd574be-225a-392c-92e2-ac55ac9aaaf8", act: "receipt", obj: "Stadtsteuer", y: 1447, ev: "Kg. F. quittiert Bürgermeistern, Rat und Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:136:A1", r: "a00a9183-1315-366f-88e1-b91d10fe503d", act: "summons", obj: "Verschiebung des Rechttags Frankfurt gegen Frank von Kronberg (25. Juli 1448)", y: null, ev: "auf den nächsten Gerichtstag seines Kammergerichts", f: "Summary"},
  {k: "llm-v1:H4:137:A1", r: "423f791c-2c30-396e-992f-fc2699b66aee", act: "other", obj: "Kammergerichtsurteil: Schiedsspruch zur Friedberger Pfandschaft ungültig", y: null, ev: "Kg. F. beurkundet das Urteil seines Kammergerichts", f: "Summary"},
  {k: "llm-v1:H4:138:A1", r: "c30343a1-4401-39e6-b618-0d9092ba9db3", act: "mandate", obj: "Friedberger Bürger nicht mit dem ungültigen Spruch zu belangen", y: null, ev: "nicht länger mit dem für ungültig erklärten Spruch", f: "Summary"},
  {k: "llm-v1:H4:139:A1", r: "9096e875-8d06-3a09-b422-72ec19698d17", act: "communication", obj: "Antwort auf ein Schreiben", y: null, ev: "Kg. F. antwortet Ldgf. Ludwig (I.) von Hessen", f: "Summary"},
  {k: "llm-v1:H4:140:A1", r: "b4361100-fd15-3d2b-8eda-8e15467a3342", act: "request", obj: "Weiterleitung der Antwort an Ldgf. Ludwig von Hessen", y: null, ev: "bittet sie, diesem wiederum seine Antwort zustellen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:141:A1", r: "ca1f81af-8d0f-3a68-9715-eb1a0cc18e8d", act: "mandate", obj: "Schutz der Friedberger Bürger gegen die Burgmannen", y: null, ev: "die Friedberger Bürger von Kg. und Reichs wegen nach bestem Vermögen gegen diese Beschwerungen durch die Burgmannen zu schirmen", f: "Summary"},
  {k: "llm-v1:H4:142:A1", r: "5d0c802d-17ba-3e5e-9881-f6b2cdccaf54", act: "mandate", obj: "Ungehorsam aufzugeben; Friedberger Bürger nicht zu belangen", y: null, ev: "ihren wider das recht und unser gebot[1] verstoßenden Ungehorsam aufzugeben", f: "Summary"},
  {k: "llm-v1:H4:143:A1", r: "2dc7e299-1d7d-3eb5-a59d-c58c826776aa", act: "prohibition", obj: "Befolgung des ungültigen Spruchs Gf. Hessos von Leiningen", y: null, ev: "auf keinen Fall nachzukommen", f: "Summary"},
  {k: "llm-v1:H4:144:A1", r: "e2a6d398-c210-3377-b825-fe46174a23bb", act: "summons", obj: "Klage Frankfurts wegen Übergriffen auf Sulzbach", y: null, ev: "Kg. F. lädt (Eberhard von) Eppstein auf Klage Frankfurts", f: "Summary"},
  {k: "llm-v1:H4:145:A1", r: "7ad81780-47aa-3d99-a1cc-06dd27bc9fa5", act: "appointment", obj: "Kommissar im Streit in Oppenheim", y: null, ev: "Kg. F. ernennt Mgf. Jakob von Baden zu seinem Kommissar", f: "Summary"},
  {k: "llm-v1:H4:146:A1", r: "3c784873-f3ed-3ab2-ae92-14971d862978", act: "commission", obj: "Austrag des Oppenheimer Streits vor Mgf. Jakob von Baden", y: null, ev: "an Mgf. Jakob von Baden als seinen Kommissar", f: "Summary"},
  {k: "llm-v1:H4:147:A1", r: "92370941-6127-3821-b802-1f44fb13b9b1", act: "summons", obj: "rechtliche Verantwortung der Oppenheimer Aufrührer", y: null, ev: "Kg. F. lädt Wyprecht Kessler und seine Gesellschaft", f: "Summary"},
  {k: "llm-v1:H4:148:A1", r: "c20d5eee-69e4-3cd7-8232-37c63e6c75c5", act: "summons", obj: "Tag zu Worms (21. September 1448) wegen des Oppenheimer Aufruhrs", y: null, ev: "fordert auch sie (Frankfurt) auf, zwei ihrer Ratsboten dorthin zu entsenden", f: "Summary"},
  {k: "llm-v1:H4:149:A1", r: "b02a3249-bde9-320d-8afb-65e0b12895a1", act: "other", obj: "Bestätigung des Vergleichs um Schloß Rödelheim", y: null, ev: "bestätigt auf Ersuchen einer Botschaft beider Parteien den inserierten", f: "Summary"},
  {k: "llm-v1:H4:150:A1", r: "30a977a5-453a-3a26-8d79-a77caaf14322", act: "receipt", obj: "Stadtsteuer", y: 1448, ev: "Kg. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:151:A1", r: "fe64d746-d9f4-32c1-8416-4f8bb7224352", act: "other", obj: "Kammergerichtsurteil im Prozeß Frankfurt gegen den Bornheimer Berg", y: null, ev: "Kg. F. verkündet das Urteil seines Kammergerichts", f: "Summary"},
  {k: "llm-v1:H4:152:A1", r: "d46bf558-ab4d-36b5-a324-2e61a740582e", act: "communication", obj: "Aufbruch zum Romzug", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:152:A2", r: "d46bf558-ab4d-36b5-a324-2e61a740582e", act: "mandate", obj: "Stellung eines Kontingents für den Romzug", y: null, ev: "gebietet ihnen, da sie nach altem Herkommen verpflichtet sind", f: "Summary"},
  {k: "llm-v1:H4:153:A1", r: "d5f52c92-91c7-38ea-b250-79a37ffd1b1a", act: "mandate", obj: "wie n. 152 (Romzug)", y: null, ev: "Kg. F. desgleichen an die Stadt Köln.", f: "Summary"},
  {k: "llm-v1:H4:154:A1", r: "a1a05d16-0467-3936-9273-604e8c24df7e", act: "ban_enforcement", obj: "Aberacht gegen Würzburg", y: null, ev: "gebietet ihnen den Vollzug unser und des richs urteil", f: "Summary"},
  {k: "llm-v1:H4:155:A1", r: "1fec3dab-f6ac-3ce1-b7fd-205eaa59571d", act: "ban_enforcement", obj: "wie n. 154 (Aberacht gegen Würzburg)", y: null, ev: "Kg. F. desgleichen an alle Kff. Fürsten etc. und anderen Reichsuntertanen.", f: "Summary"},
  {k: "llm-v1:H4:156:A1", r: "9709a589-c95f-34ae-9ccd-2e33c5587aa1", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "die Frankfurter gegenüber jedem Angreifer von unnsern und des reichs wegen nach Vermögen zu beschützen", f: "Summary"},
  {k: "llm-v1:H4:157:A1", r: "90398bbe-b94c-30d8-8e6d-54bfa7c8b3d2", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Eb. Dietrich von Köln Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:158:A1", r: "3c445ce8-def9-399b-a003-b76a71964edf", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Eb. Jakob von Trier Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:159:A1", r: "f0850c13-f8a0-33e8-9673-88a143c2ec09", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Ldgf. Ludwig von Hessen Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:160:A1", r: "9cb9be73-38a2-36ad-b160-f2d3cf5f5f15", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Mgf. Albrecht von Brandenburg Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:161:A1", r: "bb670873-5212-3cd0-a418-d437538a4603", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Mgf. Jakob von Baden Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:162:A1", r: "c8855bc4-10d4-355f-a772-bfdde075c24a", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Pfgf. Ludwig bei Rhein Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:163:A1", r: "207c8627-59a4-3003-a8a3-3c14390af107", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Gf. von Katzenelnbogen Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:164:A1", r: "184fcf96-75ec-389f-9731-358492433090", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Gf. von Nassau Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:165:A1", r: "a226a3f3-7e77-39f9-bc64-ae3b701854cf", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Gf. von Hanau Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:166:A1", r: "1cde9202-f1bf-39ca-855a-14b10c743dd3", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Gf. von Solms Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:167:A1", r: "738e24fe-570e-3161-8f36-0a6ddbd4bb2d", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet Gf. von Isenburg-Büdingen Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:168:A1", r: "6887577e-851b-367f-a7d2-1f90179b6c27", act: "mandate", obj: "Schutz Frankfurts im Städtekrieg", y: null, ev: "Kg. F. gebietet den Herren von Eppstein Schutz der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:169:A1", r: "556dcc16-3242-36ce-ab42-1cef11e732e5", act: "appointment", obj: "Kommissare zur Beilegung des Städtekriegs", y: null, ev: "zu seinen Kommissaren zur Beilegung der Auseinandersetzungen", f: "Summary"},
  {k: "llm-v1:H4:170:A1", r: "87c42694-9847-3f6c-bdb4-70e78cc69f34", act: "communication", obj: "Ernennung von Kommissaren zur Beilegung der Fehden", y: null, ev: "Kg. F. teilt den Ebb. Dietrich von Köln", f: "Summary"},
  {k: "llm-v1:H4:170:A2", r: "87c42694-9847-3f6c-bdb4-70e78cc69f34", act: "summons", obj: "Verhandlungen vor den königlichen Kommissaren", y: null, ev: "von seinen Kommissaren zu Verhandlungen geladen werden", f: "Summary"},
  {k: "llm-v1:H4:171:A1", r: "e8944930-260f-3ee6-be5d-cf2d2ab5de44", act: "other", obj: "Freies Geleit zu den Friedensverhandlungen", y: null, ev: "freies Geleit zu den Verhandlungen", f: "Summary"},
  {k: "llm-v1:H4:172:A1", r: "b99efe69-5b89-3a29-8bb6-bb6b72ed8d47", act: "mandate", obj: "Rückgabe von zwei Saum Gewand durch Frankfurter Juden an Hans von Gera", y: null, ev: "fordert Bürgermeister und Rat der Stadt Frankfurt auf Ersuchen seines Dieners Hans von Gera auf", f: "Summary"},
  {k: "llm-v1:H4:173:A1", r: "cd913934-3bcb-357a-a5f2-68e8a2270c48", act: "receipt", obj: "Stadtsteuer", y: 1449, ev: "Kg. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:174:A1", r: "f81a7cb3-f69e-3886-85d4-8c058971057a", act: "request", obj: "Abstellung des Unwillens gegen Frankfurt", y: null, ev: "seinen Unwillen durch unsern (kgl.) willen aufzugeben", f: "Summary"},
  {k: "llm-v1:H4:174:A2", r: "f81a7cb3-f69e-3886-85d4-8c058971057a", act: "prohibition", obj: "Fehde gegen Frankfurt", y: null, ev: "die Frankfurter keinesfalls zu bekriegen", f: "Summary"},
  {k: "llm-v1:H4:175:A1", r: "772dd0c6-c210-39d7-b91b-ecb7a0aeeae8", act: "mandate", obj: "Schutz Frankfurts gegen den Erzbischof von Mainz", y: null, ev: "die Frankfurter von unsern und des richs wegen nach bestem Vermögen gegen jegliche Gewaltmaßnahme zu schützen", f: "Summary"},
  {k: "llm-v1:H4:176:A1", r: "6cdd2e6a-fa78-3281-b7e1-2adabc21d762", act: "mandate", obj: "Schutz Frankfurts gegen den Erzbischof von Mainz", y: null, ev: "Kg. F. gebietet Eb. Jakob von Trier Schutz Frankfurts", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

