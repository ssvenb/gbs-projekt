  {k: "llm-v1:H4:191:A1", r: "6b611803-6f7d-3d77-86cf-646d742850a4", act: "mandate", obj: "Schutz Frankfurts gegen den Erzbischof von Mainz", y: null, ev: "Kg. F. gebietet Jungherrn Werner von Falkenstein-Münzenberg Schutz Frankfurts", f: "Summary"},
  {k: "llm-v1:H4:192:A1", r: "ef718df1-bdec-3ac0-83e6-2ec36c8705b7", act: "mandate", obj: "Schutz Frankfurts gegen den Erzbischof von Mainz", y: null, ev: "Kg. F. gebietet Walter von Breuberg Schutz Frankfurts", f: "Summary"},
  {k: "llm-v1:H4:193:A1", r: "1ee026ff-1fac-356d-8db5-15c06996b459", act: "summons", obj: "Rechttag am Hof (11. Januar 1451) zur Beilegung des Städtekriegs", y: null, ev: "ihre Ratsfreunde rechtzeitig an den Hof zu senden", f: "Summary"},
  {k: "llm-v1:H4:194:A1", r: "2efcc1f4-3eb3-38f4-8eca-acb244d83a1f", act: "summons", obj: "Tag zwischen Fürsten und Städten", y: null, ev: "Kg. F. gebietet Speyer Besuch des Tags zwischen Fürsten und Städten.", f: "Summary"},
  {k: "llm-v1:H4:195:A1", r: "9baa3acb-ada3-3dcd-a825-725add7dfa9f", act: "summons", obj: "Tag zwischen Fürsten und Städten", y: null, ev: "Kg. F. gebietet Worms Besuch des Tags zwischen Fürsten und Städten.", f: "Summary"},
  {k: "llm-v1:H4:196:A1", r: "2964305a-b056-3a15-b3ed-ecae3f17d17a", act: "summons", obj: "Tag zwischen Fürsten und Städten", y: null, ev: "Kg. F. gebietet Regensburg Besuch des Tags zwischen Fürsten und Städten.", f: "Summary"},
  {k: "llm-v1:H4:197:A1", r: "6ca3a213-52f9-3c74-8c6d-9d28c87fa12a", act: "summons", obj: "Tag zwischen Fürsten und Städten", y: null, ev: "Kg. F. gebietet Straßburg Besuch des Tags zwischen Fürsten und Städten.", f: "Summary"},
  {k: "llm-v1:H4:198:A1", r: "320f28e9-7599-3ecc-b8b9-d942a6003d10", act: "mandate", obj: "Abstellung der Forderungen und des Banns gegen die Frankfurter Juden", y: null, ev: "seine Forderungen an die Frankfurter Juden und den gegen diese erlassenen Bann abzustellen", f: "Summary"},
  {k: "llm-v1:H4:199:A1", r: "d23c19b1-e9b6-30e3-9cf9-c240c3996fa0", act: "mandate", obj: "Abstellung des Unwillens gegen Frankfurt; keine Fehde", y: null, ev: "befiehlt er ihm nunmehr, von seinem Unwillen", f: "Summary"},
  {k: "llm-v1:H4:199:A2", r: "d23c19b1-e9b6-30e3-9cf9-c240c3996fa0", act: "prohibition", obj: "Fehde gegen Frankfurt", y: null, ev: "Frankfurt keinesfalls zu befehden", f: "Summary"},
  {k: "llm-v1:H4:200:A1", r: "4fba9b63-0769-3944-9892-4deb853fa95c", act: "mandate", obj: "Geleit für Frankfurter Kaufleute im Mainzer Gebiet", y: null, ev: "den Frankfurtern auf Ersuchen und nach Bedürfnis in dein und deins stiffts zü Mentze herrschafft und gebiete", f: "Summary"},
  {k: "llm-v1:H4:201:A1", r: "c12115d2-4bfb-31af-a25a-e90da0d05620", act: "commission", obj: "Verhör und Ehrenrettung der beschuldigten Frankfurter Ratsherren", y: null, ev: "befiehlt er dem Eb. beide Parteien vor sich zu laden", f: "Summary"},
  {k: "llm-v1:H4:202:A1", r: "e9658706-a220-3b27-9437-ade7a343d5a8", act: "summons", obj: "gütlicher Tag am Hof in der Fehde Brandenburg/Heideck – Nürnberg", y: null, ev: "setzt in der Fehde zwischen Mgf. Albrecht von Brandenburg, Konrad von Heideck und der Stadt Nürnberg einen gütlichen Tag", f: "Summary"},
  {k: "llm-v1:H4:203:A1", r: "511fb11b-5f6e-3cd0-be75-343a0497c348", act: "summons", obj: "gütlicher Tag am Hof (15. Juni 1451)", y: null, ev: "Kg. F. lädt die Stadt Worms", f: "Summary"},
  {k: "llm-v1:H4:204:A1", r: "d3e4edbc-fcc7-38a9-80ca-5c2140a51305", act: "receipt", obj: "Stadtsteuer", y: 1450, ev: "Kg. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:205:A1", r: "a88640e3-d92c-3bb9-898f-3386f5ad1cfe", act: "mandate", obj: "Kontingent für den Romzug nach Ferrara (25. November 1451)", y: null, ev: "gebietet ihnen, ihr wohlausgerüstetes Kontingent an sand Katherinen tag", f: "Summary"},
  {k: "llm-v1:H4:206:A1", r: "3d653d32-337a-3b37-a73a-da79408db0c5", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet Ulm und den Städten des Schwäbischen Städtebunds Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:207:A1", r: "15c0b87c-1c42-3487-a40a-8d13edac7cd9", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet Nürnberg Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:208:A1", r: "d6a0bdd7-ddd4-3396-8101-58c92909065f", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet Köln Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:209:A1", r: "89f487d1-a0ec-362b-9feb-443b4e8d5de2", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet Straßburg Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:210:A1", r: "829c531a-3af7-3df1-bef7-a359340e65f6", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet Augsburg Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:211:A1", r: "82f75d42-3a68-30bb-bb3b-c8e208805198", act: "mandate", obj: "Begleitung auf dem Romzug", y: null, ev: "Kg. F. gebietet anderen (noch nicht bekannten) Städten Begleitung auf dem Romzug.", f: "Summary"},
  {k: "llm-v1:H4:212:A1", r: "0c3b252d-a036-3834-9722-60e6ef7ca4d5", act: "other", obj: "Geleitbrief für den Hofprokurator Konrad Billung", y: null, ev: "ungehindert durch alle ihre Herrschaften ziehen zu lassen und ihm Hilfe und Geleit zu gewähren", f: "Summary"},
  {k: "llm-v1:H4:213:A1", r: "cba5ec6c-d149-311b-96cc-e9949bd30308", act: "ban_enforcement", obj: "Acht gegen holländische, seeländische und Utrechter Städte", y: null, ev: "künftig streng als Geächtete zu behandeln", f: "Summary"},
  {k: "llm-v1:H4:214:A1", r: "dfa139a3-e179-3750-b66a-946db4e414a8", act: "privilege_confirmation", obj: "alle Privilegien und die zwei Jahresmessen", y: null, ev: "K. F. bestätigt Bürgermeistern, Schöffen, Rat und allen Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:215:A1", r: "e3d6a6ec-2c01-39f8-a7f7-a431164c346a", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1451, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:216:A1", r: "e39f6c4d-af9d-302f-b726-bb2e0e13913a", act: "summons", obj: "Tag am Hof (11. November 1452)", y: null, ev: "lädt die Stadt Nürnberg auf den 11.November", f: "Summary"},
  {k: "llm-v1:H4:217:A1", r: "0202b2b3-50b5-38ca-8d0b-717e8a3b5958", act: "summons", obj: "Tag am Hof", y: null, ev: "lädt Esslingen an den Hof zu einem Tag.", f: "Summary"},
  {k: "llm-v1:H4:218:A1", r: "65290e76-ed5a-339d-88f6-7174589bf098", act: "summons", obj: "Tag am Hof", y: null, ev: "lädt Frankfurt an den Hof zu einem Tag.", f: "Summary"},
  {k: "llm-v1:H4:219:A1", r: "e7a83afd-c07b-3f08-9095-181de1c68b5f", act: "summons", obj: "Tag am Hof", y: null, ev: "lädt weitere (noch nicht bekannte) Reichsangehörige an den Hof zu einem Tag.", f: "Summary"},
  {k: "llm-v1:H4:220:A1", r: "cc76fb12-c5af-3372-8427-e1f154dabd1c", act: "ban_enforcement", obj: "Acht gegen Lüttich, Huy, St. Trond, Hasselt, Tongern und Maastricht", y: null, ev: "Acht und Aberacht gegen Bürgermeister, Räte und Bürger der Städte Lüttich", f: "Summary"},
  {k: "llm-v1:H4:221:A1", r: "b12416a2-c66c-33ca-9f3f-5eaff4b3def2", act: "communication", obj: "Krönungssteuer der Frankfurter Juden (dritter Pfennig)", y: null, ev: "K. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:221:A2", r: "b12416a2-c66c-33ca-9f3f-5eaff4b3def2", act: "request", obj: "geheime Auskunft über das Vermögen der Frankfurter Juden", y: null, ev: "ersucht sie, ihm bis dahin zur Wahrnehmung seiner Rechte insgeheim schriftlich Auskunft", f: "Summary"},
  {k: "llm-v1:H4:222:A1", r: "9d9f593f-99fd-3138-b3a0-522e5b651f16", act: "mandate", obj: "Zahlung der Krönungssteuer (dritter Pfennig) bis 24. August 1453", y: null, ev: "fordert die Juden zu Frankfurt bei Strafe auf", f: "Summary"},
  {k: "llm-v1:H4:223:A1", r: "5c8e2b76-9878-3dd2-84b7-1b1a358eb2ff", act: "credential", obj: "Verhandlungen über Reichslehen und Kammergut", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Rat und Kammerprokurator-Fiskal Meister Hartung von Kappel", f: "Summary"},
  {k: "llm-v1:H4:224:A1", r: "a97ec5c4-749f-3513-ad54-168383cdf657", act: "ban_enforcement", obj: "Acht gegen holländische, seeländische und Utrechter Städte", y: null, ev: "streng als Geächtete zu behandeln", f: "Summary"},
  {k: "llm-v1:H4:225:A1", r: "cab1ffc4-82e0-390b-a6df-a69cd7f0fde7", act: "ban_enforcement", obj: "Acht gegen Lüttich, Huy, St. Trond, Hasselt, Tongern und Maastricht", y: null, ev: "verhängte Acht und Aberacht zu vollziehen", f: "Summary"},
  {k: "llm-v1:H4:226:A1", r: "9a936d80-ceca-3a12-ab4c-3e0b4bd7708b", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1452, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:227:A1", r: "e5b81416-d033-3d7e-9dbf-d8ebd0f354f1", act: "commission", obj: "gütliche Einigung zwischen Frankfurt und Hanau um den Bornheimer Berg", y: null, ev: "K. F. beauftragt Frank d. A. von Kronberg mit der Vermittlung", f: "Summary"},
  {k: "llm-v1:H4:228:A1", r: "e5c1b3cd-376e-34e9-acac-d7ee7b54ed6a", act: "mandate", obj: "Einziehung von 2000 fl. bei den Frankfurter Juden", y: null, ev: "2000 fl. rh. und zusätzlich die dieser Summe entsprechenden Honorare", f: "Summary"},
  {k: "llm-v1:H4:229:A1", r: "bd34ec51-d072-394f-b65c-87bbc781ce93", act: "request", obj: "Provision des Nikolaus Militis mit der nächsten freien Pfründe am Leonhardsstift", y: null, ev: "den Nikolaus Militis, Presbyter der Diözese Mainz, mit der nächsten freiwerdenden Pfründe des Stifts providiert hat", f: "Summary"},
  {k: "llm-v1:H4:230:A1", r: "da15000e-6bc8-34c1-bbbe-5874cb91c7bf", act: "summons", obj: "Tag zu Regensburg (23. April 1454) zur Türkenabwehr", y: null, ev: "ihre bevollmächtigte Ratsbotschaft an sannd Jörgen tag (April 23) in Regensburg zu haben", f: "Summary"},
  {k: "llm-v1:H4:231:A1", r: "0dc76f2b-5c3b-3da7-88bf-8a8cbf02a968", act: "summons", obj: "wie n. 230 (Regensburger Tag)", y: null, ev: "K. F. desgleichen an Kg. Ladislaus (von Böhmen und Ungarn).", f: "Summary"},
  {k: "llm-v1:H4:232:A1", r: "69c465a7-9781-3e90-8005-cebddfb758d8", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1453, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:233:A1", r: "4cc8e5f0-715a-3cb3-9123-b9640ea5b019", act: "privilege_confirmation", obj: "Messeprivilegien (alte und neue Messe)", y: null, ev: "K. F. bestätigt Bürgermeistern, Schöffen und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:234:A1", r: "b62a8937-e327-3853-ae5b-66cf76558278", act: "other", obj: "Kammergerichtsurteil Gelnhausen gegen den Juden Isaak", y: null, ev: "K. F. beurkundet das Kammergerichtsurteil", f: "Summary"},
  {k: "llm-v1:H4:235:A1", r: "224ace95-aecf-31a9-9a43-e00c3843c44c", act: "mandate", obj: "Übergabe des Dorfs Sulzbach an Eberhard von Eppstein-Königstein", y: null, ev: "diesem das Dorf Sulzbach", f: "Summary"},
  {k: "llm-v1:H4:236:A1", r: "b0f269bb-f285-323d-b336-5ec575f24d63", act: "summons", obj: "gemeiner Tag zu Frankfurt (29. September 1454)", y: null, ev: "K. F. schreibt für den 29. September einen gemeinen Tag nach Frankfurt aus.", f: "Summary"},
  {k: "llm-v1:H4:237:A1", r: "f511755a-6359-303c-9ece-b64db9bdac40", act: "commission", obj: "Vertretung des Kaisers auf dem Frankfurter Tag", y: null, ev: "beauftragt seine Räte Bf. Eneas von Siena, Bf. Ulrich von Gurk und den Lehrer beider Rechte Meister Hartung von Cappel", f: "Summary"},
  {k: "llm-v1:H4:238:A1", r: "76aab362-18f8-3773-9f94-fd9ea6192ea2", act: "credential", obj: "mündliche Botschaft der kaiserlichen Räte", y: null, ev: "K. F. beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seine Räte", f: "Summary"},
  {k: "llm-v1:H4:239:A1", r: "d5c92c23-516a-3271-bfc4-5a11ad6c58f1", act: "request", obj: "Herberge für die kaiserlichen Räte zum Frankfurter Tag", y: null, ev: "bittet sie, den vom ksl. Hof aus abgesandten Räten eine gemeinsame Herberge", f: "Summary"},
  {k: "llm-v1:H4:240:A1", r: "8be37c6a-297e-3121-ad7b-056b441d6dab", act: "mandate", obj: "Türkenzug: 200 Reiter und 300 Mann zu Fuß", y: null, ev: "befiehlt ihnen, diese bestmöglich und wie vereinbart auszurüsten", f: "Summary"},
  {k: "llm-v1:H4:241:A1", r: "79910e26-319d-3f0f-90d2-d7cbe469f8bb", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1454, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:242:A1", r: "d90f5f9c-fccb-3226-9fdf-5eaafb1408bd", act: "commission", obj: "Entscheidung des Prozesses Erfurt gegen Hans Kreygenberg", y: null, ev: "beauftragt Eb. Dietrich von Mainz an seiner Statt mit der rechtlichen Entscheidung", f: "Summary"},
  {k: "llm-v1:H4:243:A1", r: "f8bca49d-5d33-33c0-8bf4-25b6b779d37d", act: "mandate", obj: "Abstellung geistlicher Urteile gegen Kreygenberg; Rechtsgewährung gegen Erfurt", y: null, ev: "dafür zu sorgen, daß die geistlichen Urteile gegen Kreygenberg abgestellt werden", f: "Summary"},
  {k: "llm-v1:H4:244:A1", r: "cd2992dd-46ac-3097-8482-d83c7f510331", act: "prohibition", obj: "Prozeß gegen Frankfurt vor dem Freigrafen zu Limburg", y: null, ev: "verbietet Gilbrecht Schadeck, gegen die Frankfurter weiterhin vor dem Freigrafen Johann Gardenwech zu Limburg zu prozessieren", f: "Summary"},
  {k: "llm-v1:H4:244:A2", r: "cd2992dd-46ac-3097-8482-d83c7f510331", act: "summons", obj: "Rechttag am kaiserlichen Hof", y: null, ev: "setzt ihm stattdessen einen Rechttag am ksl. Hof", f: "Summary"},
  {k: "llm-v1:H4:245:A1", r: "9dd3559f-ab10-310e-9778-b729b1387784", act: "prohibition", obj: "Vorgehen des Freigrafen gegen Frankfurt", y: null, ev: "noch irgend etwas gegen die Beklagten zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:246:A1", r: "f735bcca-7ea8-364f-9b9b-46a4f7383f63", act: "receipt", obj: "Stadtsteuer (Vorauszahlung, 928 fl. rh.)", y: 1455, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:247:A1", r: "75d60527-c145-34b5-9f3c-45b5a35636a7", act: "communication", obj: "Gesandtschaft des Papstes zum Türkenzug", y: null, ev: "K. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:247:A2", r: "75d60527-c145-34b5-9f3c-45b5a35636a7", act: "mandate", obj: "Rüstung zum Türkenzug im Frühjahr", y: null, ev: "ermahnt der K. sie, sich entsprechend dem Frankfurter Anschlag", f: "Summary"},
  {k: "llm-v1:H4:248:A1", r: "4c9f0791-ae77-321f-980b-918704140450", act: "summons", obj: "Kommen an den Hof", y: null, ev: "ersucht den Frankfurter Münzmeister Konrad von Steeg, in ettwas (ksl.) geschefften und notdurfften an den Hof zu kommen.", f: "Summary"},
  {k: "llm-v1:H4:249:A1", r: "cad44517-b359-30ca-85cf-fe44458ff25a", act: "mandate", obj: "Schutz des Münzmeisters Konrad von Steeg in seiner Abwesenheit", y: null, ev: "nicht zu gestatten, daß jemand die Abwesenheit des dortigen Münzmeisters Konrad von Steeg", f: "Summary"},
  {k: "llm-v1:H4:250:A1", r: "a2701167-8db2-32be-8bc6-60d9e5900a1e", act: "request", obj: "Entsendung zweier Büchsenmeister", y: null, ev: "bittet Bürgermeister und Rat der Stadt Frankfurt, ihm zur Kriegsführung ihre beiden besten Büchsenmeister", f: "Summary"},
  {k: "llm-v1:H4:251:A1", r: "ff6d788c-7af7-35fd-ac81-103d66468ba0", act: "request", obj: "Zusendung von Büchsenmeistern", y: null, ev: "K. F. ersucht die Stadt Ulm um die Zusendung von Büchsenmeistern.", f: "Summary"},
  {k: "llm-v1:H4:252:A1", r: "0f5e0b65-d55a-35be-b13a-1a01f6e8c4d4", act: "mandate", obj: "Beitrag zum Türkenzug nach den päpstlichen Plänen", y: null, ev: "fordert sie im Namen des christlichen Glaubens und des gemeinen Nutzens auf", f: "Summary"},
  {k: "llm-v1:H4:253:A1", r: "c3b7cb1b-f446-3664-ada6-6b015520cc62", act: "request", obj: "Förderung des Münzers Hans Haug", y: null, ev: "bittet sie um die Förderung von dessen Anliegen", f: "Summary"},
  {k: "llm-v1:H4:254:A1", r: "0dcc8cd0-c5c7-3028-a795-c90ab59c57c0", act: "mandate", obj: "Freilassung des Münzmeisters Konrad von Steeg", y: null, ev: "fordert von Eb. Dietrich von Mainz die Freilassung", f: "Summary"},
  {k: "llm-v1:H4:255:A1", r: "39940c95-7cef-3b6e-9aa8-7d33810e908a", act: "appointment", obj: "Verweser der kaiserlichen Münzstätte Frankfurt", y: null, ev: "zum Verweser der ksl. Frankfurter Münzstätte", f: "Summary"},
  {k: "llm-v1:H4:256:A1", r: "1d36286a-0d17-3030-b469-dff5a9d278a2", act: "summons", obj: "Rechttag Hans von Rechbergs gegen Ulm", y: null, ev: "setzt (Hans?) von Rechberg einen Rechttag gegen die Stadt Ulm", f: "Summary"},
  {k: "llm-v1:H4:257:A1", r: "6e69b50a-adb8-3c62-a242-29d4e0b08189", act: "enfeoffment", obj: "hanauische Reichslehen", y: null, ev: "K. F. belehnt Gf. Philipp d. Ä. von Hanau", f: "Summary"},
  {k: "llm-v1:H4:258:A1", r: "6e4ac838-2461-3d2c-964f-02001ea24ef8", act: "other", obj: "Urkunde zur Frankfurter Guldenmünzstätte", y: null, ev: "urkundet in Sachen der Frankfurter Guldenmünzstätte", f: "Summary"},
  {k: "llm-v1:H4:259:A1", r: "46673f36-9a1a-332f-b79f-f378b18663bf", act: "prohibition", obj: "Abhaltung des Nürnberger Kurfürstentags ohne kaiserliche Ladung", y: null, ev: "den von ihnen angesetzten Tag gütlich abzustellen", f: "Summary"},
  {k: "llm-v1:H4:259:A2", r: "46673f36-9a1a-332f-b79f-f378b18663bf", act: "commission", obj: "Vortrag der kaiserlichen Meinung auf dem Nürnberger Tag", y: null, ev: "damit beauftragt zu haben, ihnen seine Meinung ausführlich vorzutragen", f: "Summary"},
  {k: "llm-v1:H4:260:A1", r: "cf4d5c56-71ed-3fd2-be17-936a41fcb9e5", act: "communication", obj: "Antwort auf den eigenmächtig angesetzten Nürnberger Tag", y: null, ev: "K. F. setzt Bürgermeister und Räte seiner und des Reiches Städte", f: "Summary"},
  {k: "llm-v1:H4:260:A2", r: "cf4d5c56-71ed-3fd2-be17-936a41fcb9e5", act: "credential", obj: null, y: null, ev: "beglaubigt bei ihnen den Kardinal Bf. Peter von Augsburg", f: "Summary"},
  {k: "llm-v1:H4:261:A1", r: "3487791f-44c3-3b42-9c93-2dc8616a8437", act: "request", obj: "Münzen und Schutz für Friedrich Nachtrabe", y: null, ev: "zu dessen Vertreter ernannten Friedrich Nachtrabe[2] dort münzen zu lassen und ihn zu schützen", f: "Summary"},
  {k: "llm-v1:H4:262:A1", r: "9afdf189-fcae-3189-8250-865783d52630", act: "mandate", obj: "Freilassung des Münzmeisters Konrad von Steeg", y: null, ev: "erneut die Freilassung seines (K. F.) Frankfurter Münzmeisters", f: "Summary"},
  {k: "llm-v1:H4:263:A1", r: "b5aa9ff8-b82c-3781-9a21-a48bba4649b9", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1456, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:264:A1", r: "1e676fdf-7a3a-360b-a733-305d4f77feef", act: "communication", obj: "Empfang der Stadtsteuer über Erwin von Steeg; Übersendung der Quittung", y: 1456, ev: "daß er ihnen die entsprechende Quittung[2] durch ihren Boten übersendet", f: "Summary"},
  {k: "llm-v1:H4:265:A1", r: "91949fce-472a-36df-840c-0a5494197faf", act: "mandate", obj: "Zahlung der Stadtsteuer an Mgf. Albrecht von Brandenburg", y: null, ev: "die am künftigen sant Martings tage (November 11) fällige gewöhnliche Stadtsteuer ohne Säumen an Mgf. Albrecht von Brandenburg", f: "Summary"},
  {k: "llm-v1:H4:266:A1", r: "12dc78e6-688e-3756-b8e9-34e778b817fe", act: "communication", obj: "Heimkehr des Frankfurter Büchsenmeisters", y: null, ev: "K. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:266:A2", r: "12dc78e6-688e-3756-b8e9-34e778b817fe", act: "request", obj: "Förderung des Büchsenmeisters", y: null, ev: "bittet sie, sich den Büchsenmeister angelegen sein zu lassen", f: "Summary"},
  {k: "llm-v1:H4:267:A1", r: "690888d9-74a7-3594-aab6-b37c487f9a02", act: "request", obj: "Hilfe für den Deutschen Orden", y: null, ev: "Er bittet deshalb alle Reichsuntertanen, dem Deutschen Orden ihren Rat, Hilfe und Beistand zu gewähren", f: "Summary"},
  {k: "llm-v1:H4:268:A1", r: "68e3d1b4-75d5-3192-bfaf-dcae18c072e0", act: "prohibition", obj: "Besuch eines ohne kaiserliches Wissen anberaumten Frankfurter Tags", y: null, ev: "jedweder Einladung zu diesem Tag nicht Folge zu leisten", f: "Summary"},
  {k: "llm-v1:H4:269:A1", r: "46b10a64-6e7c-326c-85a9-4acae5c9a7df", act: "communication", obj: "Dank für die Antwort zum Frankfurter Tag", y: null, ev: "K. F. dankt Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 301–400
UNWIND [
  {k: "llm-v1:H4:270:A1", r: "b24266f3-7a09-337b-8c44-c8fbb86eb788", act: "credential", obj: "Verhandlungen über die Juden", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Rat Meister Hartung von Cappel", f: "Summary"},
  {k: "llm-v1:H4:271:A1", r: "953343ef-8cb2-3ac7-84c8-e27ec60f7f7e", act: "mandate", obj: "rasche Überweisung der Stadtsteuer", y: null, ev: "ihm die der ksl. Kammer am vergangenen sand Martins tag (November 11) verfallene Stadtsteuer so rasch wie möglich zu überweisen", f: "Summary"},
  {k: "llm-v1:H4:272:A1", r: "4fea58f7-76ef-3d6e-a215-6e08c2191b09", act: "mandate", obj: "Einsatz für die Freilassung gefangener Kölner Kaufleute", y: null, ev: "sich bei den Tätern für die sofortige Freilassung der Gefangenen und ihrer Habe", f: "Summary"},
  {k: "llm-v1:H4:272:A2", r: "4fea58f7-76ef-3d6e-a215-6e08c2191b09", act: "prohibition", obj: "Unterstützung der Täter", y: null, ev: "verbietet er den Frankfurtern, den Tätern irgendeine Unterstützung zukommen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:273:A1", r: "e87cd4b2-6b86-3fbd-93b5-a6eb2653af38", act: "summons", obj: "rechtliche Verantwortung wegen der Gefangennahme Kölner Kaufleute", y: null, ev: "lädt Hennemann Waltmann, Hans von Maßbach, Jakob von Kronberg, Philipp Rode und Meßfort von Brambach sowie Kuno von Westerburg rechtlich vor sich", f: "Summary"},
  {k: "llm-v1:H4:274:A1", r: "71991ae3-e4d5-394f-ae43-eac265c6b851", act: "summons", obj: "wie n. 273", y: null, ev: "K. F. desgleichen an die Kölner Bürger", f: "Summary"},
  {k: "llm-v1:H4:275:A1", r: "179e5123-d8af-39c4-b8d9-874f5910f4d9", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1457, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:276:A1", r: "1b768762-d08f-35b5-91e3-e8b35b9554c4", act: "prohibition", obj: "Errichtung zweier Jahrmärkte in Mainz gegen die Frankfurter Messen", y: null, ev: "von ihrem Vorhaben[1], zwei jährliche Jahrmärkte in Mainz zu errichten, abzustehen", f: "Summary"},
  {k: "llm-v1:H4:277:A1", r: "d7ef203a-5de7-379b-abb7-2394bac866f7", act: "prohibition", obj: "Besuch der neuen Mainzer Messen", y: null, ev: "die in Mainz von den dortigen Bürgern auß irem eigenem fürnemen errichteten zwei jährlichen Messen nicht zu besuchen", f: "Summary"},
  {k: "llm-v1:H4:278:A1", r: "05ebd248-a24c-3777-95a1-772e6f4001f8", act: "request", obj: "Unterbindung neuer Jahrmärkte gegen die Frankfurter Messen", y: null, ev: "ersucht ihn, derartige Vorhaben", f: "Summary"},
  {k: "llm-v1:H4:279:A1", r: "efbdfef1-884d-3cd9-9445-97c70ad79f5d", act: "request", obj: "Unterbindung neuer Jahrmärkte gegen die Frankfurter Messen", y: null, ev: "ersucht ihn, derartige Vorhaben", f: "Summary"},
  {k: "llm-v1:H4:280:A1", r: "cbe16fad-bb66-329a-a5bf-f77f1de143cd", act: "mandate", obj: "Kölner Kaufleute nur zu den Frankfurter Messen", y: null, ev: "K. F. befiehlt der Stadt Köln, ihre Kaufleute anzuhalten", f: "Summary"},
  {k: "llm-v1:H4:281:A1", r: "17c256e4-3ad3-3b7f-af8a-753eaae82682", act: "mandate", obj: "wie n. 280", y: null, ev: "K. F. desgleichen an die Stadt Straßburg.", f: "Summary"},
  {k: "llm-v1:H4:282:A1", r: "660b457b-cd2d-37da-a118-f5093f4b610a", act: "request", obj: "gütliche Einigung Fritz von Grumbachs mit den geschädigten Frankfurter Kaufleuten", y: null, ev: "Er bittet ihn deshalb, Fritz", f: "Summary"},
  {k: "llm-v1:H4:283:A1", r: "3c5eca78-ea31-3734-b123-cb19d4abe932", act: "ban_release", obj: "Aufhebung der Acht gegen Mainz für zwei Jahre", y: null, ev: "hebt jegliche über die Stadt Mainz verhängte Acht für die Dauer von zwei Jahren auf", f: "Summary"},
  {k: "llm-v1:H4:284:A1", r: "51afa273-824c-3298-91b5-76cd0ab1c1d5", act: "commission", obj: "Einnahme des Anteils der Familie zum Jungen am Mainzer Zoll", y: null, ev: "beauftragt die Stadt Mainz, an seiner Statt den der Familie zum Jungen gehörigen Teil am Mainzer Zoll einzunehmen", f: "Summary"},
  {k: "llm-v1:H4:285:A1", r: "9dbd9177-6dec-3b5a-adb3-c5b2e374d214", act: "mandate", obj: "Umsiedlung der Synagoge und der Judenschaft", y: null, ev: "die Synagoge und die gesamte Judenschaft an ein annder zimlich ennde in der statmawr zu versetzen", f: "Summary"},
  {k: "llm-v1:H4:286:A1", r: "2ff51e1c-b375-3afa-bdba-0df20595da2a", act: "mandate", obj: "Hilfe für Donauwörth gegen Entfremdung vom Reich", y: null, ev: "auf deren oder deren ksl. Pflegers[1] Ersuchen bei Tag und Nacht Hilfe gegen jedermann zu leisten", f: "Summary"},
  {k: "llm-v1:H4:287:A1", r: "0c664611-8770-3ca4-a551-f8e78e3ebe84", act: "request", obj: "Gesandtschaft zum Türkentag in Mantua", y: null, ev: "ihre bevollmächtigte Ratsbotschaft dorthin zu entsenden", f: "Summary"},
  {k: "llm-v1:H4:288:A1", r: "6b08cb11-fb52-3ea9-a29c-488857b93c36", act: "privilege_grant", obj: "Recht zum Vorgehen gegen Friedensbrecher und Schädiger Frankfurts", y: null, ev: "erteilt Bürgermeistern und Rat der Stadt Frankfurt die Erlaubnis", f: "Summary"},
  {k: "llm-v1:H4:289:A1", r: "f855cd5d-9fb5-3e93-85e6-568835bdd166", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1458, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:290:A1", r: "bc0c889e-f14c-313b-9ec2-4909ed468a8a", act: "appointment", obj: "Hauptleute gegen Hz. Ludwig IX. von Bayern-Landshut", y: null, ev: "zu seinen Hauptleuten gegen Hz. Ludwig (IX.) von Bayern(-Landshut)", f: "Summary"},
  {k: "llm-v1:H4:291:A1", r: "0e0dd1a5-9be5-33f4-8d48-a805d14f1800", act: "mandate", obj: "Hilfe für die Reichshauptleute gegen Bayern-Landshut", y: null, ev: "befiehlt ihnen unter Androhung schwerer Strafen, jenen zu Hilfe zu ziehen", f: "Summary"},
  {k: "llm-v1:H4:292:A1", r: "d5af138a-00b9-3bca-ad16-3b7d78e28c0e", act: "summons", obj: "rechtliche Verantwortung wegen Sulzbach vor dem Kammergericht", y: null, ev: "lädt Eberhard von Eppstein-Königstein auf Klage von Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:293:A1", r: "e5c061f2-fcdd-394e-a3aa-6e588ac9dfc4", act: "other", obj: "Kammergerichtsurteil: Sulzbach gehört mit Frankfurt zum Reich", y: null, ev: "der Klage von dem erneut unter dem Vorsitz Mgf. Wilhelms tagenden Kammergericht einhellig stattgegeben", f: "Summary"},
  {k: "llm-v1:H4:294:A1", r: "da3b2032-ee8f-3c64-a26a-6a0a755e585e", act: "mandate", obj: "Aufgabe der Ansprüche auf Sulzbach binnen sechs Wochen und drei Tagen", y: null, ev: "seine Ansprüche auf und seine Maßnahmen gegen das Dorf Sulzbach innerhalb von sechs Wochen und drei Tagen", f: "Summary"},
  {k: "llm-v1:H4:295:A1", r: "4e2172eb-8803-3eec-b2e5-989ab1edee5c", act: "privilege_grant", obj: "Wappenbestätigung", y: null, ev: "K. F. bestätigt den Brüdern Johann und Siegfried Kellner das überkommene Wappen", f: "Summary"},
  {k: "llm-v1:H4:296:A1", r: "0c493e27-f642-31eb-97b9-a0de8f16fea0", act: "summons", obj: "Türkentage zu Nürnberg (2. März) und am Hof (30. März 1460)", y: null, ev: "ihre Bevollmächtigten zu den Tagen zu schicken", f: "Summary"},
  {k: "llm-v1:H4:297:A1", r: "e0a33ba7-ef7e-3793-ae73-5d7a6aad161a", act: "summons", obj: "Tag zu Nürnberg zur Türkenfrage", y: null, ev: "K. F. lädt den Elekten Diether von Mainz", f: "Summary"},
  {k: "llm-v1:H4:298:A1", r: "c23ab0f8-f483-3620-895c-9972a9bd51fb", act: "summons", obj: "Tag zu Nürnberg zur Türkenfrage", y: null, ev: "K. F. lädt Friedberg zur Beratung der Türkenfrage", f: "Summary"},
  {k: "llm-v1:H4:299:A1", r: "9117ad1c-b162-39cf-8e2a-239e12e4c66c", act: "request", obj: "Beförderung kaiserlicher Ladungen", y: null, ev: "bittet sie um deren Beförderung an ihre Adressaten", f: "Summary"},
  {k: "llm-v1:H4:300:A1", r: "622fbb95-9d3f-3eae-950c-6219dfb9fe5d", act: "summons", obj: "verschobener Türkentag am Hof (11. Mai 1460)", y: null, ev: "gebietet ihnen, ihre bevollmächtigte Botschaft zu diesem Zeitpunkt an seinem Hof zu haben", f: "Summary"},
  {k: "llm-v1:H4:301:A1", r: "b8d24867-5a18-37de-aab7-db3a10e83a10", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Gf. Philipp von Katzenelnbogen Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:302:A1", r: "01c81951-82f0-3676-b942-630b1c7089e2", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Ldgf. Ludwig von Hessen Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:303:A1", r: "e940a5ff-fae8-3d59-b961-b162ae22f5f6", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Gf. Philipp von Hanau Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:304:A1", r: "f9c8b8ea-70c2-390d-a511-04b4a8380a9b", act: "summons", obj: "Türkentag am Hof", y: null, ev: "von Weinsberg Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:305:A1", r: "1f222d74-32ca-35c9-a43b-1e0ff82cdbaa", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Frank d. A. von Kronberg Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:306:A1", r: "51fa09b2-f0e8-33d5-9b69-3d2b78cda6e7", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Friedberg Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:307:A1", r: "e7a49c6c-94fe-3613-a563-188ad2f2cbd2", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Gelnhausen Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:308:A1", r: "b40ee7ff-f71f-3795-8fed-d823b30fbd27", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Mainz Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:309:A1", r: "09fda7d4-cca9-3e70-b63a-53d0cbc2b327", act: "summons", obj: "Türkentag am Hof", y: null, ev: "K. F. gebietet Worms Besuch des Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:310:A1", r: "55a1b42e-f8b0-3e4c-bf44-d3db49b977fa", act: "request", obj: "Beförderung kaiserlicher Sendbriefe", y: null, ev: "bittet sie um deren unverzügliche Beförderung", f: "Summary"},
  {k: "llm-v1:H4:311:A1", r: "2af2b7e5-43b6-3b38-8539-c486156842a2", act: "summons", obj: "verschobener Türkentag am Hof (1. September 1460)", y: null, ev: "an diesem Termin bevollmächtigt am ksl. Hof vertreten zu sein", f: "Summary"},
  {k: "llm-v1:H4:312:A1", r: "9cd732e7-41ce-36cf-8ecb-4b06a3aaa606", act: "summons", obj: "verschobener Türkentag am Hof", y: null, ev: "K. F. gebietet Worms Besuch des verschobenen Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:313:A1", r: "eea52ab6-ffcc-3c1d-a0ab-eba4c99ee1c7", act: "summons", obj: "verschobener Türkentag am Hof", y: null, ev: "K. F. gebietet Mainz Besuch des verschobenen Türkentages am Hof.", f: "Summary"},
  {k: "llm-v1:H4:314:A1", r: "88096cce-4c70-3d2c-880c-7d8996f809b1", act: "communication", obj: null, y: null, ev: "K. F. richtet ein Anschreiben an die Stadt Wetzlar.", f: "Summary"},
  {k: "llm-v1:H4:315:A1", r: "3c93cafe-b2ad-37da-884c-c7312cb9ee02", act: "communication", obj: "Prozeß vor dem Freigrafen Wilhelm von der Zungen zugunsten Frankfurts", y: null, ev: "schreibt an Jobst Rotenbach zugunsten der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:316:A1", r: "a6722751-8092-3713-bef0-1003488c303e", act: "communication", obj: "wie n. 315", y: null, ev: "K. F. desgleichen an den Freigrafen Wilhelm von der Zungen.", f: "Summary"},
  {k: "llm-v1:H4:317:A1", r: "52c7db6d-13b3-3481-b134-729cf341a3db", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1459, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:318:A1", r: "fcb349a7-ec6d-326b-aeef-41a0a8d59abe", act: "mandate", obj: "Freilassung des Münzmeisters Friedrich Nachtrabe gegen Bürgschaft", y: null, ev: "Nachtrabe auf zimlich trostung und porgschafft auf freien Fuß zu setzen", f: "Summary"},
  {k: "llm-v1:H4:319:A1", r: "120de496-ab04-39ab-94b5-eae06154b22a", act: "commission", obj: "Verhör Nachtrabes und gütliche Einigung im Münzstreit", y: null, ev: "befiehlt er ihnen und bevollmächtigt sie", f: "Summary"},
  {k: "llm-v1:H4:320:A1", r: "a6044e08-18a2-3d78-81ae-c8e68cd8ea6d", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1460, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:321:A1", r: "703e03b8-3add-3709-80ec-24451c239658", act: "prohibition", obj: "Besuch des Kurfürstentags und Einlaß der Kurfürsten nach Frankfurt", y: null, ev: "Er verbietet ihnen bei der Pflicht und dem Gehorsam", f: "Summary"},
  {k: "llm-v1:H4:322:A1", r: "67f1dda3-f58c-30bc-a581-2691cfd54a6e", act: "prohibition", obj: "Eingriffe in Sulzbach", y: null, ev: "einen Verbotsbrief an den (Herren von Eppstein-)Königstein", f: "Summary"},
  {k: "llm-v1:H4:323:A1", r: "fe4740d0-1a61-3489-99dc-a6715bc26b1a", act: "other", obj: "Ungültigkeit der Handlungen westfälischer Gerichte gegen das Hofgericht Rottweil", y: null, ev: "erklärt alle Handlungen der Westfälischen Gerichte gegen das Hofgericht zu Rottweil für ungültig", f: "Summary"},
  {k: "llm-v1:H4:324:A1", r: "4dd6f804-ca64-38b8-a8e3-65fb41010184", act: "other", obj: "Rechtserbieten gegenüber Kg. Georg von Böhmen", y: null, ev: "erbietet sich gegenüber Kg. Georg von Böhmen zu völligem gütlichen oder rechtlichen Austrag", f: "Summary"},
  {k: "llm-v1:H4:325:A1", r: "d6548031-ede8-39e5-806a-bd0787704f37", act: "other", obj: "wie n. 324 (Rechtserbieten)", y: null, ev: "K. F. desgleichen an seinen Bruder Hz. Albrecht (VI.) von Österreich.", f: "Summary"},
  {k: "llm-v1:H4:326:A1", r: "75fc820e-eb92-375b-bf3e-841961ce7c5b", act: "mandate", obj: "keinen Fürstentag in Frankfurt ohne kaiserliche Einwilligung", y: null, ev: "auch in Zukunft keinen von den Kff. und Fürsten nach Frankfurt angesetzten Tag", f: "Summary"},
  {k: "llm-v1:H4:327:A1", r: "b3db00d3-330d-3cbc-8145-d5214ec56bf8", act: "other", obj: "Fehdeansage an Hz. Ludwig IX. von Bayern", y: null, ev: "sagt ihm deshalb Feindschaft an", f: "Summary"},
  {k: "llm-v1:H4:328:A1", r: "9a4fd7b4-d0cf-3b32-8916-9666af4ba317", act: "commission", obj: "Erhebung der Judensteuern, Krönungsschatzung und des goldenen Opferpfennigs", y: null, ev: "gestattet Mgf. Albrecht (Achilles) von Brandenburg die Einnahme der gewöhnlichen Judensteuern", f: "Summary"},
  {k: "llm-v1:H4:329:A1", r: "0ad61421-999b-351a-b3c6-5aa7b140ff03", act: "appointment", obj: "Hauptleute im Krieg gegen die Widersacher des Kaisers", y: null, ev: "zu seinen Hauptleuten im Krieg gegen seine Widersacher", f: "Summary"},
  {k: "llm-v1:H4:330:A1", r: "514148c3-be10-3fdf-b881-552c506e22cd", act: "request", obj: "Übernahme der Hauptmannschaft", y: null, ev: "ersucht Mgf. Karl von Baden, gleich den von ihm tags zuvor ernannten", f: "Summary"},
  {k: "llm-v1:H4:331:A1", r: "8c6dcba7-c9f3-3a96-919d-dd3daf97752a", act: "mandate", obj: "Zuzug zu den kaiserlichen Hauptleuten gegen Albrecht VI. und Ludwig IX.", y: null, ev: "auf Erfordern unverzüglich und mit aller Macht zuzuziehen", f: "Summary"},
  {k: "llm-v1:H4:332:A1", r: "d9f417a5-bd4b-3575-b56f-f26c7a473a61", act: "mandate", obj: "wie n. 331", y: null, ev: "K. F. desgleichen an ettlich graven und heren", f: "Summary"},
  {k: "llm-v1:H4:333:A1", r: "a6baf7e6-b846-3e32-b8c0-82413c7cb07f", act: "summons", obj: "Tag der Hauptleute zu Nürnberg (24. August 1461)", y: null, ev: "an sant Bartholomeus tag (August 24) eine Ratsgesandtschaft zu jenen nach Nürnberg zu senden", f: "Summary"},
  {k: "llm-v1:H4:334:A1", r: "f4740716-fccc-3ac1-8b50-0796e660693f", act: "summons", obj: "Tag der Hauptleute zu Nürnberg", y: null, ev: "K. F. lädt Wetzlar zu einem Tag seiner Hauptleute nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:335:A1", r: "2b8041a1-0abd-3309-baaf-92c151839ca7", act: "summons", obj: "Tag der Hauptleute zu Nürnberg", y: null, ev: "K. F. lädt Friedberg zu einem Tag seiner Hauptleute nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:336:A1", r: "26ad78fb-b981-3a6f-b7d9-24cedb7f8834", act: "summons", obj: "Tag der Hauptleute zu Nürnberg", y: null, ev: "K. F. lädt Mainz zu einem Tag seiner Hauptleute nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:337:A1", r: "1ad2a9e4-0837-3117-9ed8-f1302fc0cd87", act: "mandate", obj: "Hilfe für Adolf von Nassau bei der Vertreibung Diethers von Isenburg", y: null, ev: "fordert sie bei Strafe auf, diesem bei Diethers Vertreibung jegliche Hilfe zuteil werden zu lassen", f: "Summary"},
  {k: "llm-v1:H4:338:A1", r: "e45a1dcc-f92a-3b67-9afb-107020ad3840", act: "mandate", obj: "wie n. 337", y: null, ev: "K. F. desgleichen an Mgf. Karl von Baden.", f: "Summary"},
  {k: "llm-v1:H4:339:A1", r: "55a514b8-4dce-323f-8752-51bb03082784", act: "mandate", obj: "Leistung der Reichshilfe trotz der Rechtfertigungen Ludwigs IX.", y: null, ev: "den schmählichen Rechtfertigungsversuchen Hz. Ludwigs (IX.) von Bayern", f: "Summary"},
  {k: "llm-v1:H4:340:A1", r: "46897790-5e16-300c-ba73-fbce492aee0f", act: "commission", obj: "Beilegung der Streitigkeiten mit Albrecht VI. und Ludwig IX.", y: null, ev: "überträgt Kg. Georg von Böhmen die Beilegung", f: "Summary"},
  {k: "llm-v1:H4:341:A1", r: "d6b4ad89-4ae5-3b42-a729-0353e2143a0a", act: "mandate", obj: "Entsendung der Truppen zu den kaiserlichen Hauptleuten", y: null, ev: "ihre Truppen befehlsgemäß unverzüglich zu seinen Hauptleuten zu schicken", f: "Summary"},
  {k: "llm-v1:H4:342:A1", r: "930c0722-3991-3cec-8465-0c72f2c4fb55", act: "mandate", obj: "wie n. 341", y: null, ev: "K. F. desgleichen an die Stadt Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:343:A1", r: "cde6fcd0-fe7d-30f4-90a8-dce57a0d3f75", act: "mandate", obj: "Hilfe für die kaiserlichen Hauptleute", y: null, ev: "befehlsgemäß seinen Hauptleuten gegen seine Widersacher zu Hilfe zu kommen", f: "Summary"},
  {k: "llm-v1:H4:344:A1", r: "9fded3b2-7e1e-32a4-8d42-e084506daced", act: "mandate", obj: "Truppen gegen Hz. Ludwig IX. bei Pön von 1000 Mark Gold und Acht", y: null, ev: "seinen Hauptleuten unverzüglich nach Erhalt dieses Schreibens ihre wohlausgerüsteten Truppen", f: "Summary"},
  {k: "llm-v1:H4:345:A1", r: "a1e8a7a5-0091-3db8-85a7-bd539b26dc04", act: "request", obj: "Zahlung der Stadtsteuer an Mgf. Albrecht von Brandenburg", y: null, ev: "an seiner Statt an Mgf. Albrecht von Brandenburg[1] oder dessen Botschaft zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:346:A1", r: "2aa9e291-f36d-3c10-b8a9-24938877febb", act: "receipt", obj: "Stadtsteuer", y: 1461, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:347:A1", r: "049fd88a-f1a1-3a8f-a8b9-91bf5d7f8668", act: "mandate", obj: "Truppen gegen Hz. Ludwig IX. bei Pön von 1000 Mark Gold und Acht", y: null, ev: "seinen Hauptleuten unverzüglich nach Erhalt dieses Schreibens ihre wohlausgerüsteten Truppen", f: "Summary"},
  {k: "llm-v1:H4:348:A1", r: "9c401dee-71a0-39e0-981d-f42b8669cb52", act: "mandate", obj: "wie n. 347", y: null, ev: "K. F. desgleichen an die Stadt Worms.", f: "Summary"},
  {k: "llm-v1:H4:349:A1", r: "f8904f7a-8904-3deb-8404-99caae194d40", act: "mandate", obj: "volle Truppenhilfe gegen Hz. Ludwig von Bayern", y: null, ev: "unverzüglich ihre ganze Macht auszurüsten und zu schicken", f: "Summary"},
  {k: "llm-v1:H4:350:A1", r: "75476186-54a8-3801-86b1-ce0f03491252", act: "mandate", obj: "stärkere Hilfe gegen Hz. Ludwig IX.", y: null, ev: "ihre Hilfe für seine Hauptleute im Krieg gegen Hz. Ludwig (IX.) von Bayern statlicher", f: "Summary"},
  {k: "llm-v1:H4:351:A1", r: "8e24d3c1-2fc3-3197-97a7-954b2594e14d", act: "request", obj: "Zahlung der Stadtsteuer an Gf. Ulrich von Württemberg", y: null, ev: "bittet sie unter der Zusicherung, daß dies ihren Privilegien keinen Abbruch tun soll, nachdrücklich, diesem das Geld", f: "Summary"},
  {k: "llm-v1:H4:352:A1", r: "076fea00-7d19-3929-83b2-da7f5c2d3631", act: "receipt", obj: "Stadtsteuer (gezahlt an Gf. Ulrich von Württemberg)", y: 1462, ev: "K. F. quittiert der Stadt Frankfurt die an Gf. Ulrich von Württemberg erfolgte Zahlung", f: "Summary"},
  {k: "llm-v1:H4:353:A1", r: "6613e5c6-df13-3436-a5d5-7c83555986d0", act: "summons", obj: "Tag zu Regensburg (16. Oktober 1462) zum Frieden mit Ludwig IX.", y: null, ev: "ihre trefflich rattsbottschafft auf Galli (Oktober 16) nach Regensburg", f: "Summary"},
  {k: "llm-v1:H4:354:A1", r: "3501f2e8-a233-3427-bf0f-e33f739378b0", act: "mandate", obj: "Rüstung zur Hilfe für das Mainzer Erzstift", y: null, ev: "unverzüglich zu rüsten und sich darauf vorzubereiten", f: "Summary"},
  {k: "llm-v1:H4:355:A1", r: "5492326a-9fbb-331c-83ea-a0d976d1ab7a", act: "request", obj: "gütliche Einigung mit Konrad Weiß wegen eines Totschlags", y: null, ev: "die Betreffenden anzuhalten, sich dem Täter gegenüber gütlich zu erweisen", f: "Summary"},
  {k: "llm-v1:H4:356:A1", r: "20c759c0-c121-3fea-af97-5bbf4f18f177", act: "other", obj: "Geleit für Konrad Weiß nach Frankfurt", y: null, ev: "gewährt Konrad Weiß ksl. Sicherheit und Geleit", f: "Summary"},
  {k: "llm-v1:H4:357:A1", r: "e2ce3857-0f9a-3362-9082-aabb3f42a281", act: "request", obj: "gütliche Einigung der Witwe Brun mit Konrad Weiß", y: null, ev: "Katharina, die Witwe des leibsweer halben von Konrad Weiß ums Leben gebrachten Hans Brun (Brewn), dazu zu bewegen", f: "Summary"},
  {k: "llm-v1:H4:358:A1", r: "57d6dace-ff47-3e69-baad-659c899c26df", act: "ban_enforcement", obj: "Acht und Aberacht über Wien", y: null, ev: "verhängt über die Stadt Wien seine und des Reiches Acht und Aberacht.", f: "Summary"},
  {k: "llm-v1:H4:359:A1", r: "c3bbe0e1-393e-3962-a71c-dcaaa15c59a6", act: "ban_enforcement", obj: "Acht über Wien: Bekanntmachung und Befolgung", y: null, ev: "gebietet Bekanntmachung sowie Befolgung des Urteils", f: "Summary"},
  {k: "llm-v1:H4:360:A1", r: "2d602a71-0c7f-3a15-a566-aec421d281d7", act: "other", obj: "Kammergerichtsurteil: Acht gegen Lüneburg", y: null, ev: "beurkundet das Urteil seines Kammergerichts", f: "Summary"},
  {k: "llm-v1:H4:361:A1", r: "cbb9ebf3-0ff6-3a27-93ec-1dc8440d3c4c", act: "ban_enforcement", obj: "Acht gegen Lüneburg", y: null, ev: "in die Acht und Aberacht erklärt worden sind, zu vollziehen", f: "Summary"},
  {k: "llm-v1:H4:362:A1", r: "e496429e-7c8f-3f14-9c38-f481945103c3", act: "credential", obj: "Verhandlungen über den Anschlag mit Kg. Georg von Böhmen", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Rat Hans von Rohrbach", f: "Summary"},
  {k: "llm-v1:H4:363:A1", r: "e765717f-8a2b-335a-97b1-6d8e95b9e72b", act: "commission", obj: "Verhör und gütliche Einigung zwischen Konrad Weiß und den Erben Brun", y: null, ev: "die Parteien vorzuladen, an seiner Statt zu verhören und gütlich zu einigen zu versuchen", f: "Summary"},
  {k: "llm-v1:H4:364:A1", r: "9ec7cf69-0a66-3414-9514-cf6318f038ab", act: "other", obj: "Vertrag mit Kg. Matthias von Ungarn", y: null, ev: "beurkundet den von ihm mit den Vertretern Kg. Matthias' von Ungarn", f: "Summary"},
  {k: "llm-v1:H4:365:A1", r: "b7bf2749-dff9-39fe-8345-89f9aa1b4645", act: "other", obj: "Ratifikation des Friedens- und Bündnisvertrags mit Ungarn", y: null, ev: "ratifiziert den mit Kg. Matthias und dem Königreich Ungarn abgeschlossenen Friedens- und Bündnisvertrag", f: "Summary"},
  {k: "llm-v1:H4:366:A1", r: "df511ee1-5ed1-3c17-8e83-889067426c44", act: "receipt", obj: "Stadtsteuer (Vorauszahlung, 928 fl. rh.)", y: 1463, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:367:A1", r: "095ef70e-d547-313c-b268-7b54b7576e58", act: "request", obj: "Zahlung der Stadtsteuer an Gf. Ulrich von Württemberg", y: null, ev: "bittet sie nachdrücklich, diesem oder seiner Botschaft das Geld", f: "Summary"},
  {k: "llm-v1:H4:368:A1", r: "778b69a0-f956-33ff-8726-25889e82ac4f", act: "mandate", obj: "Hilfe für Adolf von Nassau gegen Diether von Isenburg", y: null, ev: "Adolf von Nassau auf dessen Erfordern zu Hilfe zu kommen", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 401–500
UNWIND [
  {k: "llm-v1:H4:369:A1", r: "381c1eae-ac09-3ea6-a331-b9c83fd3e700", act: "other", obj: "Verschreibung der Frankfurter Stadtsteuer 1464 an Markgräfin Katharina von Baden", y: null, ev: "verschreibt seiner Schwester Markgräfin Katharina von Baden die gewöhnliche Steuer der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:370:A1", r: "6d9df51b-7473-35a0-a044-bead80cf267d", act: "receipt", obj: "Stadtsteuer", y: 1464, ev: "K. F. quittiert der Stadt Frankfurt die Bezahlung der Stadtsteuer des Jahres 1464.", f: "Summary"},
  {k: "llm-v1:H4:371:A1", r: "26fdc541-cd75-3230-9b1b-1224413be49a", act: "request", obj: "Zahlung der Stadtsteuer 1464 an Markgräfin Katharina von Baden", y: null, ev: "bittet sie nachdrücklich, dieser oder ihrer Botschaft das Geld", f: "Summary"},
  {k: "llm-v1:H4:372:A1", r: "78c9b77c-9fff-3d04-9209-b4c5335a7357", act: "communication", obj: "Mainzer Zoll", y: null, ev: "K. F. schreibt an Frankfurt wegen des Mainzer Zolls.", f: "Summary"},
  {k: "llm-v1:H4:373:A1", r: "ecf5c73c-8413-3bb3-b033-1fb346c23477", act: "prohibition", obj: "eigenmächtige Bündnisse der Wetterauer Reichsstädte", y: null, ev: "sich ohne sein Einverständnis in einich verpuntnuß, verstentnuß und glupt zu begeben", f: "Summary"},
  {k: "llm-v1:H4:374:A1", r: "411e1a58-352b-3a78-88f0-23f69932736c", act: "prohibition", obj: "eigenmächtige Bündnisse", y: null, ev: "K. F. verbietet Köln eigenmächtige Bündnisse.", f: "Summary"},
  {k: "llm-v1:H4:375:A1", r: "77e10f3f-0e12-30b4-87b9-4b8887967ac2", act: "prohibition", obj: "Bündnisse", y: null, ev: "K. F. verbietet der Stadt Aachen Bündnisse.", f: "Summary"},
  {k: "llm-v1:H4:376:A1", r: "a92e46d8-856a-35fe-846f-bc2b85e2d09a", act: "prohibition", obj: "Bündnisse", y: null, ev: "K. F. verbietet der Stadt Worms Bündnisse.", f: "Summary"},
  {k: "llm-v1:H4:377:A1", r: "81e117d1-b231-373f-ba21-949fe075e323", act: "other", obj: "Übertragung von Forderungen an die Frankfurter Münze an Erwin von Steeg", y: null, ev: "überträgt Erwin von Steeg einige Forderungen an die Frankfurter Münze.", f: "Summary"},
  {k: "llm-v1:H4:378:A1", r: "ba570dfb-9b11-3412-a605-355d174ee98c", act: "appointment", obj: "Kommissar zur Untersuchung und Abstellung jüdischen Wuchers", y: null, ev: "zum ksl. Kommissar mit dem Auftrag, die Praxis der Juden, Wucherzinsen zu nehmen", f: "Summary"},
  {k: "llm-v1:H4:379:A1", r: "77ff2392-0d87-39d7-b6c1-a62250896b8d", act: "summons", obj: "Rechtfertigung wegen falscher Messewaage (4. März 1464)", y: null, ev: "zur Rechtfertigung gegenüber dieser Beschuldigung am suntag Oculi", f: "Summary"},
  {k: "llm-v1:H4:380:A1", r: "69c57074-82da-3262-a172-54e9a910dc2b", act: "receipt", obj: "Stadtsteuer", y: 1462, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:381:A1", r: "a4942278-ae63-3237-9dcc-292806fc4d1a", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1463, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:382:A1", r: "3a08928e-4119-3941-84f2-e88a99f42bed", act: "commission", obj: "Erhebung des goldenen Pfennigs und des zehnten Pfennigs von allen Juden", y: null, ev: "überträgt seinem Schwager[1] Mgf. Karl (I.) von Baden die Erhebung", f: "Summary"},
  {k: "llm-v1:H4:383:A1", r: "b9e530b9-06fb-311e-975e-14c658ec9f9a", act: "privilege_grant", obj: "Aufnahme in den aragonesischen Kannenorden", y: null, ev: "verleiht Walter Schwarzenberg (d. Ä.)", f: "Summary"},
  {k: "llm-v1:H4:384:A1", r: "dedab3e7-1022-3e8d-bc56-6ec6557bfc8a", act: "mandate", obj: "Herausgabe der Frankfurter Erbschaften und Zinsen in Mainz", y: null, ev: "dafür zu sorgen, daß Bürgermeistern, Rat und Bürgern der Stadt Frankfurt ihre", f: "Summary"},
  {k: "llm-v1:H4:385:A1", r: "10fb29e5-a07d-3cb5-abd8-b9438abf6b14", act: "commission", obj: "Schutz Frankfurts gegen Beschwerung wegen des Bündnisverbots", y: null, ev: "an seiner Statt zu schützen", f: "Summary"},
  {k: "llm-v1:H4:386:A1", r: "315b51f3-e629-335e-8802-c552ed375175", act: "commission", obj: "Schutz Frankfurts", y: null, ev: "K. F. beauftragt Eb. Adolf von Mainz mit Frankfurts Schutz.", f: "Summary"},
  {k: "llm-v1:H4:387:A1", r: "652a7adb-1be4-3d44-b381-521a6c7b0a1f", act: "commission", obj: "Schutz Frankfurts", y: null, ev: "K. F. beauftragt Ldgf. Ludwig von Hessen mit Frankfurts Schutz.", f: "Summary"},
  {k: "llm-v1:H4:388:A1", r: "9a149640-e9a3-3575-9fe7-7979ff4843ca", act: "commission", obj: "Schutz Frankfurts", y: null, ev: "K. F. beauftragt Ldgf. Heinrich von Hessen mit Frankfurts Schutz.", f: "Summary"},
  {k: "llm-v1:H4:389:A1", r: "5d247239-503a-3920-89fb-d147bd7a2984", act: "communication", obj: "Mainzer Zoll", y: null, ev: "K. F. schreibt wegen des Mainzer Zolls an Frankfurt und an den Zollschreiber zu Mainz.", f: "Summary"},
  {k: "llm-v1:H4:390:A1", r: "c200e7a9-9d32-3e16-bbcb-f28bb32a05af", act: "prohibition", obj: "eigenmächtige Bündnisse der Wetterauer Reichsstädte", y: null, ev: "mit niemandem ein Bündnis oder verstentnuß einzugehen", f: "Summary"},
  {k: "llm-v1:H4:391:A1", r: "860b1202-6beb-32e8-9ec4-9f16b6dc9d2b", act: "communication", obj: "zugunsten Frankfurts", y: null, ev: "K. F. schreibt an Paulus Hutmacher und den Freigrafen Johann Stubenrauch zugunsten der Stadt Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:391a:A1", r: "7ba7f6d8-81cf-3547-9989-c1685ae79b81", act: "privilege_grant", obj: "Beseitigung neuer Bauten und Schenkstätten im Umkreis einer Meile um Nürnberg", y: null, ev: "gewährt Bürgermeistern und Rat der Stadt Nürnberg aus ksl. Machtvollkommenheit unwiderruflich die Freiheit", f: "Summary"},
  {k: "llm-v1:H4:392:A1", r: "3ea620c7-0d80-3d0c-80fc-56be47b74c95", act: "commission", obj: "Kommissionen im Streit Burg Friedberg – Frankfurter Reichsgericht", y: null, ev: "erläßt im Streit zwischen Burggraf, Baumeistern und Burgmannen der Burg Friedberg", f: "Summary"},
  {k: "llm-v1:H4:393:A1", r: "fe106978-27e6-3dd7-8904-4a9a7255befe", act: "other", obj: "Widerruf der Kommissionsbriefe der Burg Friedberg; Prozeß nur am Hof", y: null, ev: "widerruft alle von Burggraf, Baumeistern und Burgmannen der Burg Friedberg", f: "Summary"},
  {k: "llm-v1:H4:394:A1", r: "d6c31466-87fe-386b-b4e8-a8d761b723a6", act: "commission", obj: "Entscheidung der Straßburger Appellation gegen den Freistuhl Waldeck", y: null, ev: "überträgt denjenigen von Bürgermeistern und Rat der Stadt Frankfurt, die Freischöffen und Wissende der Westfälischen Gerichte sind", f: "Summary"},
  {k: "llm-v1:H4:395:A1", r: "95886c84-76ca-304c-8828-9f99e000bf40", act: "communication", obj: "Dorf Sulzbach und Hans von Kronberg", y: null, ev: "K. F. schreibt an Frankfurt betr. das Dorf Sulzbach und Hans von Kronberg.", f: "Summary"},
  {k: "llm-v1:H4:396:A1", r: "baa2ec73-a58f-31eb-bbbf-4d6c6d869b34", act: "commission", obj: "Vertretung des Kaisers auf dem Tag zu Znaim", y: null, ev: "bevollmächtigt Gf. Schaffried von Leiningen und Dr. Johann Gelthaus als seine Vertreter", f: "Summary"},
  {k: "llm-v1:H4:397:A1", r: "4806c797-d5fb-30b9-a6e7-1489e8f2a367", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1464, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:398:A1", r: "675cd209-c9a3-3a97-8705-7e1ef941481e", act: "request", obj: "nächste freie Pfründe für Enolf Clair (Erste Bitte)", y: null, ev: "die nächste freiwerdende Pfründe ihrer geistlichen Lehenschaft zu verleihen", f: "Summary"},
  {k: "llm-v1:H4:399:A1", r: "859cda05-3f0e-3635-b7b2-955de80726d1", act: "mandate", obj: "Rückgabe der Frankfurter Erbgüter und Zinsen in Mainz", y: null, ev: "ihre Erbgüter, Ewigzinsen, Wiederverkaufs- und Leibrentenzinsen", f: "Summary"},
  {k: "llm-v1:H4:399a:A1", r: "2abf123e-c15f-31eb-8722-bc227cd36c16", act: "privilege_grant", obj: "Exemtion Nürnbergs von den westfälischen Freigerichten", y: null, ev: "eximiert die durch zahlreiche Privilegien seiner Vorgänger", f: "Summary"},
  {k: "llm-v1:H4:400:A1", r: "11c4eaf3-3231-3a32-a620-d07e0b8e0a53", act: "other", obj: "Widerruf der Kommission an Frankfurt im Streit Waldeck – Straßburg", y: null, ev: "widerruft die Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:401:A1", r: "243b2788-e0f3-30ed-9da4-8ea67fb35351", act: "communication", obj: "Rücknahme der Kommission im Streit Waldeck – Straßburg", y: null, ev: "K. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:402:A1", r: "1f09c6f8-1e25-3b3a-9d99-cb803a95b2d5", act: "summons", obj: "Rechttag am Hof in der Appellationssache Waldeck – Straßburg", y: null, ev: "auf Ersuchen der letzteren einen Tag vor sich an", f: "Summary"},
  {k: "llm-v1:H4:403:A1", r: "e6e81d52-a1b9-3903-9e37-f5ae2c34e1e9", act: "prohibition", obj: "weitere Prozeßführung der Frankfurter Wissenden", y: null, ev: "befiehlt ihnen, in dieser Sache nicht weiter zu prozessieren", f: "Summary"},
  {k: "llm-v1:H4:404:A1", r: "ab03e1d5-0ca1-3063-9767-bd62219f4f54", act: "summons", obj: "Tag am kaiserlichen Hof", y: null, ev: "K. F. schreibt einen Tag am ksl. Hof aus.", f: "Summary"},
  {k: "llm-v1:H4:405:A1", r: "5df54d70-deff-3a7f-91de-9b9830b30fbc", act: "other", obj: "Kammergerichtsurteil zugunsten Gf. Schaffrieds von Leiningen", y: null, ev: "verkündet das Kammergerichtsurteil in Sachen Gf. Schaffrieds von Leiningen", f: "Summary"},
  {k: "llm-v1:H4:406:A1", r: "348dc726-15fb-36ec-bba6-107090ea3b5d", act: "summons", obj: "Klage Gf. Schaffrieds von Leiningen vor dem Kammergericht", y: null, ev: "K. F. lädt die Stadt Straßburg auf Klage Gf. Schaffrieds von Leiningen", f: "Summary"},
  {k: "llm-v1:H4:407:A1", r: "06af2e43-797e-329c-9a4c-7bfe58a105c3", act: "summons", obj: "Klage Gf. Schaffrieds von Leiningen", y: null, ev: "K. F. lädt die Stadt Speyer auf Klage Gf. Schaffrieds von Leiningen.", f: "Summary"},
  {k: "llm-v1:H4:408:A1", r: "c73e7f94-3839-371a-9517-42af7104a8a2", act: "summons", obj: "Klage Gf. Schaffrieds von Leiningen", y: null, ev: "K. F. lädt die Stadt Weissenburg im Elsass auf Klage Gf. Schaffrieds von Leiningen.", f: "Summary"},
  {k: "llm-v1:H4:409:A1", r: "6fb87366-3dec-34ad-b291-6aadc68c31fe", act: "summons", obj: "Klage Gf. Schaffrieds von Leiningen", y: null, ev: "K. F. lädt weitere (noch nicht bekannte) Städte auf Klage Gf. Schaffrieds von Leiningen.", f: "Summary"},
  {k: "llm-v1:H4:410:A1", r: "ad0bdc60-9b42-39ed-976b-3b38ec251134", act: "privilege_grant", obj: "Schutz von Kaiser und Reich für die Grafen von Leiningen", y: null, ev: "in seinen und des Reichs besonderen Schutz", f: "Summary"},
  {k: "llm-v1:H4:411:A1", r: "7792c352-0f78-39ef-9405-5203aced6893", act: "summons", obj: "Tag zu Ulm (2. Februar 1466)", y: null, ev: "ihre bevollmächtigte Ratsbotschaft zu dem von ihm und den Kff. Fürsten und Edlen beschlossenen", f: "Summary"},
  {k: "llm-v1:H4:412:A1", r: "f1c5c6c6-c24f-3512-ae4a-02a146816893", act: "privilege_grant", obj: "Erneuerung der Ordnung des Frankfurter Reichsstadtgerichts und Zuständigkeit für alle Messebesucher", y: null, ev: "erneuert Bürgermeistern, Rat, Bürgern und der ganzen Gemeinde der Stadt Frankfurt die althergebrachte Ordnung", f: "Summary"},
  {k: "llm-v1:H4:413:A1", r: "d03949f8-495b-30a1-9c74-310484c5f530", act: "commission", obj: "Abrechnung des kaiserlichen Anteils am Mainzer Zoll", y: null, ev: "die Abrechnung des ksl. Anteils am Mainzer Zoll vorzunehmen", f: "Summary"},
  {k: "llm-v1:H4:414:A1", r: "871edf98-6d5e-3681-9521-e082c5a3cb96", act: "credential", obj: "Gesandtschaft im Reich", y: null, ev: "K. F. beglaubigt Gf. (Rudolf) von Sulz und seinen Fiskalprokurator Johann Kellner", f: "Summary"},
  {k: "llm-v1:H4:415:A1", r: "92286914-1702-3525-bae3-df2102575cf4", act: "mandate", obj: "Rückgabe der Frankfurter Erbgüter, Zinsen und Renten in Mainz", y: null, ev: "die ihnen von ihm nehst in den ubervals und gewynnunge unser und des richs stad Mainz vorenthaltenen Erbgüter", f: "Summary"},
  {k: "llm-v1:H4:416:A1", r: "a60be756-2d8a-3464-b38f-129d97bc0c25", act: "mandate", obj: "Rückgabe der Frankfurter Erbgüter, Zinsen und Renten in Mainz", y: null, ev: "dafür zu sorgen, daß Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:417:A1", r: "d0ecd21b-99cd-3b54-8afe-4a03a47b6269", act: "other", obj: "Kammergerichtsurteil Frankfurt gegen Georg Hutmacher", y: null, ev: "beurkundet das Urteil seines Kammergerichts im Prozeß", f: "Summary"},
  {k: "llm-v1:H4:418:A1", r: "a7de1ecb-bcf6-3afe-9366-729efb9ef04d", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1465, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:419:A1", r: "0995bb71-2b9f-314c-ad96-4a432e6524f3", act: "privilege_confirmation", obj: "Ordnung des Frankfurter Reichsstadtgerichts", y: null, ev: "erneuert Bürgermeistern, Rat, Bürgern und ganzer Gemeinde der Stadt Frankfurt die althergebrachte Ordnung", f: "Summary"},
  {k: "llm-v1:H4:420:A1", r: "c2ef3728-d9ce-3906-92f3-6c2e3d4783d0", act: "privilege_grant", obj: "Jahrmarkt in Leipzig (acht Tage ab Neujahr)", y: null, ev: "gestattet den Hzz. Ernst und Albrecht von Sachsen die Abhaltung eines Jahrmarktes", f: "Summary"},
  {k: "llm-v1:H4:421:A1", r: "4d36f677-e6fa-37c7-a52f-8bdf9fc6b012", act: "summons", obj: "Klage Frankfurts vor dem Kammergericht", y: null, ev: "K. F. lädt Michael von Bickenbach auf Klage Frankfurts vor das Kammergericht.", f: "Summary"},
  {k: "llm-v1:H4:422:A1", r: "dcc8b248-9fd8-3c46-ad90-2c7552525414", act: "credential", obj: "Hilfe für den Türkenkrieg unter Ulrich von Grafenegg", y: null, ev: "beglaubigen er und Kg. Matthias ihren Hauptmann Ulrich von Grafenegg", f: "Summary"},
  {k: "llm-v1:H4:422:A2", r: "dcc8b248-9fd8-3c46-ad90-2c7552525414", act: "request", obj: "rasche Hilfe gegen die Türken", y: null, ev: "Der K. bittet sie, diesem in Ansehung der dem Reich durch die Türken drohenden Gefahr", f: "Summary"},
  {k: "llm-v1:H4:423:A1", r: "08b43c4e-84da-34f0-9858-7ddb552e59b6", act: "other", obj: "Anweisung der Frankfurter Judensteuer an Gf. Ulrich von Württemberg", y: null, ev: "weist Gf. Ulrich (V.) von Württemberg die Frankfurter Judensteuer an.", f: "Summary"},
  {k: "llm-v1:H4:424:A1", r: "d19d3242-601e-3a5d-a6b8-e566b92bbc8e", act: "summons", obj: "Türkentag zu Nürnberg (11. November 1466)", y: null, ev: "ihre wohlunterrichtete Botschaft unverzüglich zu dem Nürnberger Tag zu schicken", f: "Summary"},
  {k: "llm-v1:H4:425:A1", r: "1c4f2298-f5a8-3783-866d-454d1311c0cc", act: "communication", obj: "Geburt des Sohnes Johannes", y: null, ev: "Kaiserin Leonore teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:426:A1", r: "4c593cbb-4066-3500-bb7a-fa9ecd46e7a1", act: "privilege_grant", obj: "Schutz und geistlicher Gerichtsstand für die Mainzer Stiftsgeistlichkeit; Bestellung von Schirmherren", y: null, ev: "in seinen, seiner Nachfolger und des Reiches besonderen Schutz", f: "Summary"},
  {k: "llm-v1:H4:427:A1", r: "2d837fc4-3553-3b3b-a56e-56af7fe33ca5", act: "privilege_confirmation", obj: "Schutz der Mainzer Stiftsgeistlichkeit und Freiheit von Haftung für Schulden des Erzbischofs", y: null, ev: "bestätigt den Prälaten, Äbten, Pröpsten, Dekanen, Kapiteln", f: "Summary"},
  {k: "llm-v1:H4:428:A1", r: "acdfebef-b25b-3ef0-bf22-d442a6331257", act: "communication", obj: "Dank für die Bereitschaft auf dem Nürnberger Türkentag", y: null, ev: "K. F. dankt Bürgermeistern, Schöffen und Räten der Städte Frankfurt, Gelnhausen, Friedberg und Wetzlar", f: "Summary"},
  {k: "llm-v1:H4:429:A1", r: "b3c7175b-68ec-3bd2-ac54-645e3c9b4d64", act: "summons", obj: "Appellation Frankfurts gegen Urteile des Freistuhls Freienhagen", y: null, ev: "lädt Hans Koch von Erfurt aufgrund der Appellation von Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:430:A1", r: "56b4eb70-c8f7-3271-9771-f32f57dfca21", act: "prohibition", obj: "Schädigung Frankfurts durch Schenk Philipp von Erbach", y: null, ev: "nichts zu unternehmen, was den Frankfurtern zum Schaden gereicht", f: "Summary"},
  {k: "llm-v1:H4:431:A1", r: "b98ef373-a25c-35d8-bb5a-9e0de78cb9a0", act: "summons", obj: "Türkentag zu Nürnberg (15. Juni 1467)", y: null, ev: "Er lädt sie zu diesem Tag", f: "Summary"},
  {k: "llm-v1:H4:432:A1", r: "e1973441-b461-3b4b-8042-139c31e3b38e", act: "summons", obj: "Nürnberger Tag", y: null, ev: "K. F. fordert von Eb. Adolf von Mainz Besuch des Nürnberger Tages.", f: "Summary"},
  {k: "llm-v1:H4:433:A1", r: "84fa9e0c-be57-3fbe-bf8c-b3d0d8f21ccd", act: "summons", obj: "Nürnberger Tag", y: null, ev: "K. F. fordert von Gf. Ludwig von Isenburg-Büdingen Besuch des Nürnberger Tages.", f: "Summary"},
  {k: "llm-v1:H4:434:A1", r: "ea9801d8-5b7c-3240-b930-4fb0f74ef9d2", act: "prohibition", obj: "weitere Maßnahmen des Hofgerichts Rottweil in der Appellationssache Nassau/Wetzlar", y: null, ev: "in dieser Sache nichts mehr zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:435:A1", r: "2a80fac6-7c20-3868-9ae0-b538cbcb0b1c", act: "summons", obj: "Appellation gegen Urteile des Hofgerichts Rottweil", y: null, ev: "aufgrund ihrer Appellation gegen zugunsten Gf. Alwigs von Sulz ergangene Urteile des Hofgerichts zu Rottweil rechtlich vor sich", f: "Summary"},
  {k: "llm-v1:H4:436:A1", r: "d47ed9bb-1e6c-3dd8-b432-f064ce22bba9", act: "summons", obj: "wie n. 435", y: null, ev: "K. F. desgleichen an Gf. Alwig von Sulz.", f: "Summary"},
  {k: "llm-v1:H4:437:A1", r: "7ec4f2bc-3323-3b10-895b-903c70e1eab1", act: "prohibition", obj: "Vorgehen gegen Frankfurt", y: null, ev: "nichts gegen Frankfurt zu unternehmen.", f: "Summary"},
  {k: "llm-v1:H4:438:A1", r: "c3653392-167f-34ee-a230-8d69af2edaf1", act: "summons", obj: "Klage Frankfurts", y: null, ev: "K. F. lädt Hartmann Kürschner auf Klage Frankfurts rechtlich vor sich.", f: "Summary"},
  {k: "llm-v1:H4:439:A1", r: "473c7c7b-cfe1-3be9-b226-e4aa3c173604", act: "prohibition", obj: "Prozeß gegen Frankfurt vor dem Dortmunder Freigrafen", y: null, ev: "einen Verbotsbrief an den Freigrafen zu Dortmund", f: "Summary"},
  {k: "llm-v1:H4:440:A1", r: "3e4e9e46-69c0-3586-bbc4-36795d2d5e16", act: "commission", obj: "Vertretung des Kaisers auf dem Nürnberger Tag (15. Juni 1467)", y: null, ev: "bevollmächtigt Bf. Ulrich von Passau", f: "Summary"},
  {k: "llm-v1:H4:441:A1", r: "b523f232-8fd7-3b66-b513-b5dd6861706c", act: "other", obj: "Ordnung für Burggericht Friedberg und Freigericht Kaichen", y: null, ev: "erläßt eine Ordnung für die Burg Friedberg", f: "Summary"},
  {k: "llm-v1:H4:442:A1", r: "114fcbf3-577c-3fa2-949d-a446c5227564", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1466, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:443:A1", r: "47dfa917-2ddb-3a23-835e-8ac2eef952bd", act: "privilege_grant", obj: "Befreiung Frankfurts von den Schutzpflichten des Mainzer Klerusprivilegs", y: null, ev: "enthebt Bürgermeister und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:444:A1", r: "0277063b-9350-3120-adf1-c0125ffcdec9", act: "summons", obj: "Klage Frankfurts vor dem Kammergericht", y: null, ev: "lädt einen (unbekannten) Untertanen des Eb. von Trier aufgrund einer Klage Frankfurts", f: "Summary"},
  {k: "llm-v1:H4:445:A1", r: "3a306175-f67a-35f3-8b1f-66db3509cac9", act: "summons", obj: "Klage des Kammerprokurator-Fiskals", y: null, ev: "K. F. lädt Gf. Philipp d. J. von Hanau", f: "Summary"},
  {k: "llm-v1:H4:446:A1", r: "1b9cf5b2-9f71-32a2-8df1-01df5f8d184e", act: "summons", obj: "Klage des Fiskals", y: null, ev: "K. F. lädt auf Klage des Fiskals Asmus Döring.", f: "Summary"},
  {k: "llm-v1:H4:447:A1", r: "a0e68eef-1f19-3901-b530-4baef06b526f", act: "summons", obj: "Klage des Fiskals", y: null, ev: "K. F. lädt auf Klage des Fiskals die 19 Dörfer des Gft. Bornheimer Berg.", f: "Summary"},
  {k: "llm-v1:H4:448:A1", r: "96a10c2f-fd2e-335d-9435-4d505c5c35fb", act: "request", obj: "Beförderung von Ladungen vor das Kammergericht", y: null, ev: "übersendet einem (unbekannten) Gf. etliche Ladungen", f: "Summary"},
  {k: "llm-v1:H4:449:A1", r: "e3599f39-f0d9-3df3-9b63-2978cdc693c1", act: "mandate", obj: "Rückgabe der Frankfurter Erbgüter, Zinsen und Gülten in Mainz binnen zwei Monaten", y: null, ev: "innerhalb von zwei Monaten nach Erhalt dieses Schreibens", f: "Summary"},
  {k: "llm-v1:H4:450:A1", r: "06d21622-113f-3316-8840-11bcd9e913fd", act: "mandate", obj: "Rückgabe der Frankfurter Erbgüter, Zinsen und Gülten in Mainz", y: null, ev: "ihrerseits dafür zu sorgen", f: "Summary"},
  {k: "llm-v1:H4:451:A1", r: "e9862e7f-9bd8-3639-8b7b-3ab95c0e2fc4", act: "public_peace", obj: "fünfjähriger allgemeiner Landfrieden", y: null, ev: "einen fünfjährigen allgemeinen Frieden im Reich", f: "Summary"},
  {k: "llm-v1:H4:452:A1", r: "ddf61836-4447-395b-a296-20f316868bd6", act: "communication", obj: "Übersendung von Abschied, Türkenanschlag und Friedensverkündigung", y: null, ev: "übersendet Bürgermeistern und Rat der Stadt Frankfurt den Abschied", f: "Summary"},
  {k: "llm-v1:H4:452:A2", r: "ddf61836-4447-395b-a296-20f316868bd6", act: "mandate", obj: "Verkündigung des Friedens in den Pfarrkirchen", y: null, ev: "diesen Frieden an den drei Sonntagen nach Erhalt seines Schreibens in den Pfarrkirchen der Stadt", f: "Summary"},
  {k: "llm-v1:H4:452:A3", r: "ddf61836-4447-395b-a296-20f316868bd6", act: "summons", obj: "Tag zu Regensburg (6. Januar 1468)", y: null, ev: "ihre Botschaft zu dem auf den heiligen dreyr kunig tag", f: "Summary"},
  {k: "llm-v1:H4:453:A1", r: "3c5032f8-1e3d-3c27-a2da-be0e3b6f5cd9", act: "ban_enforcement", obj: "Acht des Hofgerichts Rottweil gegen Friedberg", y: null, ev: "keinerlei Gemeinschaft mit den Ächtern zu pflegen", f: "Summary"},
  {k: "llm-v1:H4:454:A1", r: "caa7fbc2-79ad-380c-88d8-7cf71a260097", act: "communication", obj: null, y: null, ev: "K. F. schreibt (in einer noch nicht bekannten Angelegenheit) an Burg und Stadt Friedberg.", f: "Summary"},
  {k: "llm-v1:H4:455:A1", r: "5f6621d1-784f-3bea-9ca3-e308fc9048ea", act: "request", obj: "Unterstützung der Klosterreform des Erzbischofs von Mainz", y: null, ev: "dem Eb. bei der reformation aller in Frankfurt gelegenen Klöster behilflich zu sein", f: "Summary"},
  {k: "llm-v1:H4:456:A1", r: "9cbfdc73-29c5-379c-abc2-90cae70cac40", act: "summons", obj: "Kammergericht (24. Juni)", y: null, ev: "K. F. lädt Gf. Otto von Solms", f: "Summary"},
  {k: "llm-v1:H4:457:A1", r: "247ae124-51e8-3c63-8db8-6b7a2a2495e5", act: "communication", obj: null, y: null, ev: "K. F. schreibt (in einer noch unbekannten Angelegenheit) an die Burgmannen der Burg zu Friedberg.", f: "Summary"},
  {k: "llm-v1:H4:458:A1", r: "28bed8d6-b28c-3c5d-989f-7aefcd610922", act: "prohibition", obj: "Vorgehen gegen den Schultheißen Bernhard Krays während der Appellation", y: null, ev: "verbietet ihnen deshalb bis zur endgültigen Entscheidung jedes weitere Vorgehen gegen Bernhard", f: "Summary"},
  {k: "llm-v1:H4:459:A1", r: "d2de8f56-8ddc-391f-83e2-7a1d7dbc487e", act: "summons", obj: "Rechttag in der Appellation gegen das Hofgericht Rottweil", y: null, ev: "setzt dem Frankfurter Schultheißen Bernhard Krays von Lindenfels", f: "Summary"},
  {k: "llm-v1:H4:460:A1", r: "be918700-9af3-36c0-ba72-fd26f467f09c", act: "summons", obj: "Appellation des Bernhard Krays", y: null, ev: "K. F. lädt Hans von Venningen zu Zuzenhausen", f: "Summary"},
  {k: "llm-v1:H4:461:A1", r: "c4692924-870a-322b-a3f3-1684e88cc0f8", act: "mandate", obj: "Predigt des Ablasses und Erhebung des Zehnten gegen Georg von Podiebrad", y: null, ev: "den Ablaß in allen ihren Bistümern, Herrschaften, Städten etc. unverzüglich predigen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:462:A1", r: "0cdf01fd-ac40-30de-b350-a365791265f4", act: "mandate", obj: "Kreuzzug gegen Georg von Podiebrad", y: null, ev: "ihre Truppen unverzüglich nach Erhalt dieses Schreibens ins Feld zu schicken", f: "Summary"},
  {k: "llm-v1:H4:463:A1", r: "d85ed72d-50b2-3a0c-b38a-6d181ea5749c", act: "commission", obj: "Eintreibung der halben Judensteuer (Krönungssteuer)", y: null, ev: "bevollmächtigt seinen Schwager Mgf. Karl (I.) von Baden und den Lehrer der weltlichen Rechte Jörg Ehinger", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 501–600
UNWIND [
  {k: "llm-v1:H4:464:A1", r: "dd0f70a2-80d4-3372-a217-73289f3da3f8", act: "mandate", obj: "Zahlung der halben Judensteuer durch die Juden der Herrschaften", y: null, ev: "ihre Juden anzuhalten, die bisher nicht ordenlich und redelich entrichteten Steuern", f: "Summary"},
  {k: "llm-v1:H4:465:A1", r: "eb15d915-4f0c-37bb-94b8-63b4f7a2885a", act: "mandate", obj: "Nachzahlung der halben Judensteuer", y: null, ev: "das Versäumnis unverzüglich nachzuholen", f: "Summary"},
  {k: "llm-v1:H4:466:A1", r: "40629049-710e-315a-8cdb-06ffd65dbf23", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1468, ev: "K. F. quittiert Bürgermeistern Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:467:A1", r: "578a676b-4f1c-345f-ad61-2ea7242be7d9", act: "mandate", obj: "Rückgabe eines Schuldscheins an Hans Kesiken", y: null, ev: "ihren Bürger Hans Thomas zu veranlassen", f: "Summary"},
  {k: "llm-v1:H4:468:A1", r: "b5406d17-464c-3172-9d61-5be9b72629fd", act: "summons", obj: "Klage des Konrad Gans wegen einer Rente", y: null, ev: "lädt Bürgermeister, Schöffen, Rat und Gemeinde der Stadt Friedberg aufgrund der Klage des Frankfurter Bürgers Konrad Gans", f: "Summary"},
  {k: "llm-v1:H4:469:A1", r: "902043f8-b124-35e4-9a5a-fbf0d2c5b41d", act: "commission", obj: "Entscheidung im Streit der Burg Friedberg mit Frankfurt", y: null, ev: "befiehlt und bevollmächtigt Eb. Johann an seiner Statt", f: "Summary"},
  {k: "llm-v1:H4:470:A1", r: "e049d626-ac02-3c87-bedc-fd995dee5088", act: "summons", obj: "Klage der Grafen von Hohenlohe", y: null, ev: "lädt Ldgf. Heinrich (III.) von Hessen auf Klage der Gff. von Hohenlohe", f: "Summary"},
  {k: "llm-v1:H4:471:A1", r: "aba5fb39-914a-3643-b754-bb198f0de114", act: "commission", obj: "Zustellung einer Ladung an Ldgf. Heinrich von Hessen", y: null, ev: "befiehlt ihnen, diesem das Schreiben durch ihren geschworenen Boten überbringen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:472:A1", r: "efa92e34-e3e6-3fde-ad65-bb762f9c4bf2", act: "summons", obj: "Schädigung seines Dieners Sigmund Rienecker", y: null, ev: "lädt vier noch nicht bekannte Schädiger seines Dieners Sigmund Rienecker", f: "Summary"},
  {k: "llm-v1:H4:473:A1", r: "1edac48f-7636-360f-ad18-73fc78ea068b", act: "summons", obj: "Schädigung seines Dieners Sigmund Rienecker", y: null, ev: "lädt vier noch nicht bekannte Schädiger seines Dieners Sigmund Rienecker", f: "Summary"},
  {k: "llm-v1:H4:474:A1", r: "8cdc9e29-4680-35a8-9de9-5c783816974e", act: "summons", obj: "Schädigung seines Dieners Sigmund Rienecker", y: null, ev: "lädt vier noch nicht bekannte Schädiger seines Dieners Sigmund Rienecker", f: "Summary"},
  {k: "llm-v1:H4:475:A1", r: "b745425d-1dd4-3386-a7a1-42551bb6fa7d", act: "summons", obj: "Schädigung seines Dieners Sigmund Rienecker", y: null, ev: "lädt vier noch nicht bekannte Schädiger seines Dieners Sigmund Rienecker", f: "Summary"},
  {k: "llm-v1:H4:476:A1", r: "ec9a4499-f94b-3fb7-8d3d-cf7817bafd5f", act: "commission", obj: "Zustellung von vier Ladungsbriefen", y: null, ev: "befiehlt ihnen, diese durch ihren geschworenen Boten an ihre Adressaten überbringen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:477:A1", r: "e8e1cc1e-ff05-3a17-b0c3-f6f5dc97ca72", act: "request", obj: "Überlassung des Stadtwerkmanns Bingerhenn für den Krieg", y: null, ev: "ihm ihren Stadtwerkmann Bingerhenn[1], von dem ihm Erwin von Steeg berichtet hat", f: "Summary"},
  {k: "llm-v1:H4:478:A1", r: "fe86ba5d-d61c-3d46-9d59-f6dc3378438b", act: "other", obj: "Geleitsbrief für Bingerhenn", y: null, ev: "übersendet dem Frankfurter Stadtwerkmann Bingerhenn einen Geleitsbrief", f: "Summary"},
  {k: "llm-v1:H4:479:A1", r: "f6582dbf-5bb1-31b0-8ff1-a32d4f505aff", act: "commission", obj: "gütliche Einigung im Totschlagsfall Konrad Weiß – Henne Brun", y: null, ev: "erteilt der K. den Frankfurtern den Kommissionsbefehl", f: "Summary"},
  {k: "llm-v1:H4:480:A1", r: "b46c8254-223c-3ec3-81b5-357eca58da29", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1467, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:481:A1", r: "8f86b68f-99f7-34ea-8638-1f3bf012f6fc", act: "enfeoffment", obj: "Mainzer Zollamt", y: null, ev: "verleiht (einem Unbekannten) das Mainzer Zollamt.", f: "Summary"},
  {k: "llm-v1:H4:482:A1", r: "cf55ddee-319a-39ce-b826-967a5afb0cfd", act: "other", obj: "Ungültigkeit westfälischer Sentenzen gegen Frankfurt; Einstellung der Prozesse", y: null, ev: "erklärt alle von Hartmann Sitz von Scheppach gegen Frankfurt ergriffenen", f: "Summary"},
  {k: "llm-v1:H4:483:A1", r: "a39fdc35-0f2d-3cbd-8418-7ec2b28b0052", act: "mandate", obj: "keine Folge für Hartmann Sitz und die westfälischen Gerichte; Hilfe für Frankfurt", y: null, ev: "Hartmann oder entsprechenden Gerichten für den Fall, diese unterstünden sich weiteren Ungehorsams, keinerlei Folge zu leisten", f: "Summary"},
  {k: "llm-v1:H4:484:A1", r: "9c832e94-25b9-39c9-b452-f1f07a218f1b", act: "other", obj: "Kammergerichtsurteil zugunsten Straßburgs gegen westfälische Sentenzen", y: null, ev: "beurkundet ein zugunsten von Meistern und Rat der Stadt Straßburg sowie von Heinrich Beger ergangenes Urteil", f: "Summary"},
  {k: "llm-v1:H4:485:A1", r: "ba7d4edf-8773-30c4-8f66-184e6cf56c73", act: "prohibition", obj: "weiteres Vorgehen des Freigrafen zu Brackel gegen Straßburg", y: null, ev: "nichts weiter zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:486:A1", r: "7a5cf758-3f99-30ad-98d4-6a62e2eb3b5f", act: "mandate", obj: "Abstehen von Klagen gegen Straßburg vor westfälischen Gerichten", y: null, ev: "von ihren Klagen bzw. ihren Maßnahmen gegen Meister und Rat der Stadt Straßburg sowie Heinrich Beger abzustehen", f: "Summary"},
  {k: "llm-v1:H4:487:A1", r: "9ce40b8f-f996-3c7f-97e1-3214f7069721", act: "mandate", obj: "Hilfe für Straßburg gegen westfälische Ladungen", y: null, ev: "statt dessen den Straßburgern und den Ihren sowie ihrem Besitz jegliche Hilfe zuteil werden zu lassen", f: "Summary"},
  {k: "llm-v1:H4:488:A1", r: "eaccfd87-7a65-35eb-8a56-2550e8275d84", act: "request", obj: "Überlassung des Werkmeisters Bingerhenn", y: null, ev: "ihm ihren Bingerhenn genannten Werkmeister", f: "Summary"},
  {k: "llm-v1:H4:489:A1", r: "3346edef-3d79-3511-ba28-891ffe0aa3cc", act: "other", obj: "Rücknahme der Kommission im Totschlagsfall Weiß – Brun", y: null, ev: "nimmt die Bürgermeistern und Rat der Stadt Frankfurt vormals mit seinem commissionbrief übertragene Beilegung", f: "Summary"},
  {k: "llm-v1:H4:489:A2", r: "3346edef-3d79-3511-ba28-891ffe0aa3cc", act: "prohibition", obj: "weiteres Vorgehen in der Sache", y: null, ev: "in der Sache nichts mehr zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:490:A1", r: "5fcddc38-06b1-32af-a37a-63c313a0b101", act: "mandate", obj: "Herausgabe des Schuldscheins an Hans Kesiken (Pön 10 Mark Gold)", y: null, ev: "ihren Mitbürger Hans Thomas zur Herausgabe", f: "Summary"},
  {k: "llm-v1:H4:491:A1", r: "aa39020b-aa56-3733-a3d0-e17e0370a2c2", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1469, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:492:A1", r: "4c883bb3-fd82-399c-8817-b0063a78be5f", act: "summons", obj: "Klage Claus Bavares wegen Freilassung seines Schuldners", y: null, ev: "lädt sie deshalb auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:493:A1", r: "b075d3f1-5d4c-3356-8325-0fb027692bbc", act: "mandate", obj: "Gerlach von Londorf, Bernhard Kreiß und Hartmut Sycz", y: null, ev: "erläßt ein Mandat betreffend Gerlach von Londorf, Bernhard Kreiß und Hartmut Sycz", f: "Summary"},
  {k: "llm-v1:H4:494:A1", r: "c6077444-c84d-3b88-aa04-b0296155a9e6", act: "privilege_grant", obj: "Recht zur Errichtung von Landwehren und Befestigungen um Frankfurt und Sachsenhausen", y: null, ev: "befiehlt und bevollmächtigt Bürgermeister und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:495:A1", r: "266ba120-ffc4-3754-9f54-7c680a802dd8", act: "mandate", obj: "Hilfe bei Erhebung von goldenem Opferpfennig und halber Judensteuer", y: null, ev: "ihren Ungehorsam gegen seine Gebote[1] zur Erhebung des goldenen Opferpfennigs und der halben Judensteuer aufzugeben", f: "Summary"},
  {k: "llm-v1:H4:496:A1", r: "a4216b26-79c4-3d5b-a75a-9e2d736fa7ee", act: "mandate", obj: "Einstellung des Vorgehens gegen die Endinger Juden und Freilassung der Gefangenen", y: null, ev: "seine Handlungen unverzüglich einzustellen, die noch in Haft gehaltenen Juden sofort und unentgeltlich freizulassen", f: "Summary"},
  {k: "llm-v1:H4:497:A1", r: "7287abb9-b5c7-3e9c-9372-2e1dfb0be8d5", act: "mandate", obj: "Schutz der Juden gegen Mgf. Karl von Baden", y: null, ev: "die Juden allgemein und speziell auf deren Ersuchen von K. und Reichs wegen zu schützen", f: "Summary"},
  {k: "llm-v1:H4:498:A1", r: "21ec3942-4ca9-3a8a-bdf5-88fb06341f1d", act: "privilege_grant", obj: "Wappenbesserung und Rittermäßigkeit", y: null, ev: "gewährt mit dem Rat seiner und des Reichs Fürsten etc. dem Heinrich Rorbach", f: "Summary"},
  {k: "llm-v1:H4:499:A1", r: "c880c21d-5265-3921-8fdf-80b444377952", act: "privilege_grant", obj: "Einziehung öder und baufälliger Häuser und Hofstätten", y: null, ev: "erteilt in der Absicht zu verhindern, daß die Stadt Frankfurt dester mer zu abgang bracht werde", f: "Summary"},
  {k: "llm-v1:H4:500:A1", r: "1d4c7221-89b9-3ecd-bbe8-3fc984edb952", act: "privilege_confirmation", obj: "Freiheiten der Frankfurter Juden, erweitert um Exemtion vom Hofgericht Rottweil und Schutz vor Blutbeschuldigung", y: null, ev: "bestätigt den Frankfurter Juden in Anbetracht ihrer Unmittelbarkeit zu ihm", f: "Summary"},
  {k: "llm-v1:H4:501:A1", r: "0ac6fc41-d05f-3686-8b2f-d3d0fd696240", act: "privilege_confirmation", obj: "Verpfändung von Wiesen zu Dortelweil an den Deutschordenskomtur", y: null, ev: "bestätigt dem Komtur des Deutschen Hauses zu Sachsenhausen", f: "Summary"},
  {k: "llm-v1:H4:502:A1", r: "245cca12-894c-3142-8103-4751b4485e86", act: "mandate", obj: "Hilfe für den Reichshauptmann Hz. Ludwig von Bayern-Veldenz gegen Pfgf. Friedrich", y: null, ev: "dem ksl. Hauptmann auf dessen Erfordern nach bestem Vermögen zu helfen", f: "Summary"},
  {k: "llm-v1:H4:503:A1", r: "faf151a4-9d7c-393a-9fe6-ca571491daa9", act: "commission", obj: "volle Strafgewalt gegen Ungehorsame im Weißenburger Konflikt", y: null, ev: "erteilt seinem Hauptmann Hz. Ludwig von Bayern(-Veldenz) die Vollmacht", f: "Summary"},
  {k: "llm-v1:H4:504:A1", r: "fcadc859-29a1-38d5-bc9c-5fe385ce2d46", act: "mandate", obj: "Reichsaufgebot gegen Pfgf. Friedrich bei Rhein", y: null, ev: "befiehlt allen Reichsangehörigen den Kampf gegen Pfgf. Friedrich bei Rhein", f: "Summary"},
  {k: "llm-v1:H4:505:A1", r: "7a929f4d-aff7-32f6-9719-44c250232a18", act: "summons", obj: "Türkentag zu Nürnberg (8. September 1470)", y: null, ev: "ihre bevollmächtigte Botschaft zu diesem Tag", f: "Summary"},
  {k: "llm-v1:H4:506:A1", r: "e93209c6-5fb9-33cc-a9bd-971e483e5cf3", act: "summons", obj: "Tag zu Nürnberg (8. September 1470)", y: null, ev: "K. F. lädt Pfgf. Friedrich bei Rhein", f: "Summary"},
  {k: "llm-v1:H4:507:A1", r: "59d59b42-1975-32c3-ac7e-aa4ce3e2b5de", act: "other", obj: "Brief zugunsten Frankfurts (Streit mit Henn auf der Straßen und Kreycker)", y: null, ev: "zugunsten der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:508:A1", r: "0780afb5-7fd6-3715-9733-16dc95a923d8", act: "other", obj: "Brief zugunsten Frankfurts (Streit mit Henn auf der Straßen und Kreycker)", y: null, ev: "zugunsten der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:509:A1", r: "ce51d884-0706-3edf-8b3f-03f9146e0788", act: "other", obj: "Brief zugunsten Frankfurts (Streit mit Henn auf der Straßen und Kreycker)", y: null, ev: "zugunsten der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:510:A1", r: "5c8d20b6-4554-3594-a351-47e548438832", act: "other", obj: "Brief zugunsten Frankfurts (Streit mit Henn auf der Straßen und Kreycker)", y: null, ev: "zugunsten der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:511:A1", r: "4ed0d750-32b0-3c7f-8087-1d2a32e498af", act: "prohibition", obj: "Behinderung der Frankfurter Befestigungsbauten", y: null, ev: "verbietet Gf. Philipp d. Ä. von Hanau, die Frankfurter weiterhin an der Errichtung von Befestigungsanlagen zu hindern", f: "Summary"},
  {k: "llm-v1:H4:512:A1", r: "35b02226-8082-3804-b665-8c833a308ba8", act: "communication", obj: "Sachsenhäuser Warte", y: null, ev: "schreibt an Gf. Ludwig von Isenburg-Büdingen wegen der Sachsenhäuser Warte.", f: "Summary"},
  {k: "llm-v1:H4:513:A1", r: "d4de0c9c-151a-319f-91d9-43300fd551f0", act: "communication", obj: "Sachsenhäuser Warte", y: null, ev: "schreibt an Gf. Kuno von Solms wegen der Sachsenhäuser Warte.", f: "Summary"},
  {k: "llm-v1:H4:514:A1", r: "5a377507-2eaa-3971-9dbe-352d65bc7813", act: "communication", obj: "Sachsenhäuser Warte", y: null, ev: "schreibt an Gf. Gerhard von Sayn wegen der Sachsenhäuser Warte.", f: "Summary"},
  {k: "llm-v1:H4:515:A1", r: "24508c83-749c-37ca-a1e5-b67121aaeae0", act: "summons", obj: "Begleichung der kaiserlichen Judensteuern am Hof", y: null, ev: "an den Hof zu kommen", f: "Summary"},
  {k: "llm-v1:H4:516:A1", r: "42740b7b-34a6-3d36-a8eb-c5bb9de0f46f", act: "mandate", obj: "Abstellung der westfälischen Sentenzen gegen Frankfurt binnen 15 Tagen", y: null, ev: "innerhalb von 15 Tagen nach Erhalt dieses Mandats abzustellen", f: "Summary"},
  {k: "llm-v1:H4:517:A1", r: "418c9923-18b2-3d78-b810-974ee489bc6f", act: "mandate", obj: "Hilfe für Frankfurt beim Bau von Warten gegen die Grafen von Hanau, Isenburg und Solms", y: null, ev: "den Frankfurtern gegen jedermann biß auf uns Hilfe und Beistand zu gewähren", f: "Summary"},
  {k: "llm-v1:H4:518:A1", r: "f1589432-f623-3889-91e2-abeb5fd6d452", act: "mandate", obj: "Freigabe beschlagnahmten Guts Frankfurter Kaufleute", y: null, ev: "das von Hz. Wilhelm d. Ä. von Braunschweig-Lüneburg und seinen Söhnen", f: "Summary"},
  {k: "llm-v1:H4:519:A1", r: "fc1255f1-0e22-3c01-a24f-339cba9f9cc0", act: "commission", obj: "gütliche Einigung im Totschlagsfall Weiß – Brun", y: null, ev: "Er befiehlt ihnen und bevollmächtigt sie deshalb erneut", f: "Summary"},
  {k: "llm-v1:H4:520:A1", r: "a653016b-1c20-31a0-aedc-520d91be94b9", act: "other", obj: "Geleit für Konrad Weiß", y: null, ev: "erteilt Konrad Weiß Geleit", f: "Summary"},
  {k: "llm-v1:H4:521:A1", r: "eae120f7-3ebc-3589-a36a-f5a1f94f134d", act: "mandate", obj: "Rückgabe beschlagnahmten Frankfurter Kaufmannsguts", y: null, ev: "unverzüglich nach Erhalt dieses Briefs entschädigungslos zurückgeben", f: "Summary"},
  {k: "llm-v1:H4:522:A1", r: "59781c73-b992-315e-8944-eb11227e5b32", act: "mandate", obj: "Einwirkung auf die Herzöge von Braunschweig-Lüneburg zugunsten Frankfurter Kaufleute", y: null, ev: "dafür zu sorgen, daß Hz. Wilhelm und seine Söhne", f: "Summary"},
  {k: "llm-v1:H4:523:A1", r: "73b18a42-4f48-3b20-a060-5a57729d938b", act: "mandate", obj: "Einwirkung zugunsten Frankfurter Kaufleute", y: null, ev: "dafür zu sorgen, daß Hz. Wilhelm d. Ä. von Braunschweig-Lüneburg", f: "Summary"},
  {k: "llm-v1:H4:524:A1", r: "be4b2db3-b734-3d07-95c7-c81daf261a35", act: "summons", obj: "Beratung einer Judenordnung am Hof (1. Juli 1471)", y: null, ev: "am ersten tag des monads july", f: "Summary"},
  {k: "llm-v1:H4:525:A1", r: "00961745-be72-32af-acb0-baf8886b2552", act: "commission", obj: "Zeugenvernehmung im Kammergerichtsprozeß Bayern gegen Jülich-Berg", y: null, ev: "erteilt Nikolaus Weißbecker, Schulmeister des St. Bartholomäusstifts zu Frankfurt, den Kommissionsauftrag", f: "Summary"},
  {k: "llm-v1:H4:526:A1", r: "dc23d017-49bc-3eeb-badc-037d2220b8ac", act: "mandate", obj: "Schutz der Juden nach Widerruf der Steuervollmacht für Baden und Ehinger", y: null, ev: "nicht zuzulassen, daß sein Schwager Mgf. Karl (I.) von Baden und sein Kammerprokurator-Fiskal Dr. Jörg Ehinger", f: "Summary"},
  {k: "llm-v1:H4:527:A1", r: "61eba05e-608c-34ca-b570-738acc2642ea", act: "privilege_confirmation", obj: "Verschreibung der Frankfurter Judenschaft an die Stadt; Befreiung von kaiserlichen Sondersteuern", y: null, ev: "die Verschreibung der Juden an die Stadt", f: "Summary"},
  {k: "llm-v1:H4:528:A1", r: "ba417120-3b61-3d95-bcb1-7daefc37c925", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1470, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:529:A1", r: "c2c914f3-92c4-38e0-bc25-60b33bea487f", act: "mandate", obj: "Hilfe für Hz. Ludwig von Veldenz gegen Pfgf. Friedrich bei Pön von 1000 Mark Gold", y: null, ev: "die ihnen vormals[1] gebotene Unterstützung gegen Pfgf. Friedrich bei Rhein", f: "Summary"},
  {k: "llm-v1:H4:530:A1", r: "fe48f38a-38a0-3e03-a490-fbab36a94304", act: "other", obj: "Urkunde für Gottfried von Eppstein-Münzenberg", y: null, ev: "urkundet für Gottfried von Eppstein-Münzenberg", f: "Summary"},
  {k: "llm-v1:H4:531:A1", r: "cb18ab17-cf0d-321d-8d03-a73384babbcb", act: "appointment", obj: "Landvogtei im Elsass", y: null, ev: "überträgt Hz. Ludwig von (Bayern-)Veldenz bis auf Widerruf die Landvogtei im Elsass", f: "Summary"},
  {k: "llm-v1:H4:532:A1", r: "f2edda70-619a-3872-a531-26cdb03b6048", act: "commission", obj: "Verhandlungen über die Hilfe gegen Pfgf. Friedrich", y: null, ev: "bevollmächtigt Hz. Ludwig von (Bayern-)Veldenz als seinen Hauptmann", f: "Summary"},
  {k: "llm-v1:H4:533:A1", r: "b5915f4f-81b5-3d99-94e2-1d596c6d8cf5", act: "summons", obj: "Türkentag zu Regensburg (23. April 1471)", y: null, ev: "auf sand Georgen tag (1471 April 23) zu einem Tag nach Regensburg", f: "Summary"},
  {k: "llm-v1:H4:534:A1", r: "442262ca-dfdb-3411-b9f6-1466bacdf697", act: "summons", obj: "Regensburger Tag", y: null, ev: "K. F. fordert von Köln Besuch des Regensburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:535:A1", r: "e33d9599-9d57-3d99-a9ce-0809332fcd7f", act: "summons", obj: "Regensburger Tag", y: null, ev: "K. F. fordert von Friedberg Besuch des Regensburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:536:A1", r: "7a091ac4-b915-3189-801b-fd12b2ae148f", act: "summons", obj: "Regensburger Tag", y: null, ev: "Besuch des Regensburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:537:A1", r: "b9718fa1-9cb7-37d4-a988-73818e72137a", act: "request", obj: "Beförderung von Ladungen zum Regensburger Tag", y: null, ev: "bittet sie, diese wegen der Kürze der Zeit durch ihren Boten", f: "Summary"},
  {k: "llm-v1:H4:538:A1", r: "8f28c2f6-8334-3300-bcb7-62138b1248a7", act: "communication", obj: "baldige Ankunft auf dem Regensburger Tag", y: null, ev: "schreibt an den Kardinallegaten Franz (Piccolomini von Siena)", f: "Summary"},
  {k: "llm-v1:H4:539:A1", r: "c281d780-ae00-340b-afb9-7fea5389bbc9", act: "summons", obj: "Kammergericht", y: null, ev: "lädt Heinrich Kreucker (Krecker, Kreigker, Krakauwer) d. Ä. zu rechtlicher Verantwortung", f: "Summary"},
  {k: "llm-v1:H4:540:A1", r: "ac4a5e08-cc6f-3300-a9ed-ffa6bdf657b4", act: "communication", obj: "zugunsten Frankfurts", y: null, ev: "K. F. schreibt an Bernhard Smicking zugunsten der Stadt Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:541:A1", r: "79cef9cc-5c84-3ee3-9e16-4009c7554da2", act: "communication", obj: "persönliche Ankunft in Regensburg", y: null, ev: "teilt seinen zu dem Regensburger Tag vorausgeschickten Räten", f: "Summary"},
  {k: "llm-v1:H4:542:A1", r: "c1546c7f-4cde-30df-a5d0-fbdeef321026", act: "other", obj: "Sitzordnung auf dem Regensburger Tag ohne Präjudiz", y: null, ev: "praktizierte Sitzordnung die Freiheiten", f: "Summary"},
  {k: "llm-v1:H4:543:A1", r: "05815540-bb8a-3c34-a0b4-0def4b0d69df", act: "public_peace", obj: "vierjähriger allgemeiner Landfrieden", y: null, ev: "verkündet einen vierjährigen allgemeinen Frieden im Reich.", f: "Summary"},
  {k: "llm-v1:H4:544:A1", r: "f201437e-b265-33b9-9711-88f88ec65c73", act: "mandate", obj: "Türkenhilfe: 20 Reiter und 50 Mann zu Fuß nach Villach", y: null, ev: "bis sannt Egidien tag (September 1) nach Villach zu schicken", f: "Summary"},
  {k: "llm-v1:H4:545:A1", r: "9cefd285-95d1-33dd-b398-bcd89d7eafc7", act: "mandate", obj: "Truppen gegen die Türken nach Villach", y: null, ev: "K. F. fordert von Konstanz Truppen gegen die Türken nach Villach.", f: "Summary"},
  {k: "llm-v1:H4:546:A1", r: "e08fcc48-03e0-3507-8c6c-f38a3261964d", act: "mandate", obj: "Truppen gegen die Türken nach Villach", y: null, ev: "K. F. fordert von Regensburg Truppen gegen die Türken nach Villach.", f: "Summary"},
  {k: "llm-v1:H4:547:A1", r: "b9e29963-dc38-3bcf-8409-d32da8393b23", act: "privilege_confirmation", obj: "Freiheit des Stifts Mainz von Prozessen am Hofgericht Rottweil wegen Kriegsschulden", y: null, ev: "erneuert die dem Stift Mainz vormals", f: "Summary"},
  {k: "llm-v1:H4:548:A1", r: "d617e0f9-ec05-3b6b-8a21-bc69167a963e", act: "privilege_grant", obj: "Gerichtsstandsprivileg für die Hintersassen Eberhards von Eppstein-Königstein", y: null, ev: "gewährt Eberhard von Eppstein-Königstein die Freiheit", f: "Summary"},
  {k: "llm-v1:H4:549:A1", r: "e208dca9-1ccd-3add-ae1a-044d66dc1263", act: "mandate", obj: "Verkündigung und Einhaltung des Regensburger Landfriedens", y: null, ev: "in ihrer Stadt öffentlich verkünden zu lassen", f: "Summary"},
  {k: "llm-v1:H4:550:A1", r: "f2f786e2-034e-3762-a9cd-15445e72a3f1", act: "other", obj: "Rechtserbieten vor den Kurfürsten gegenüber Pfgf. Friedrich", y: null, ev: "erklärt sich gegenüber Pfgf. Friedrich (dem Siegreichen) bei Rhein bereit", f: "Summary"},
  {k: "llm-v1:H4:551:A1", r: "07a09583-bb41-3c5b-b599-299eca9a2fac", act: "privilege_confirmation", obj: "Privilegien der Burg Gelnhausen", y: null, ev: "K. F. bestätigt die Privilegien der Burg Gelnhausen.", f: "Summary"},
  {k: "llm-v1:H4:552:A1", r: "dcd74001-b6ce-30f2-9b40-cc2786479d2e", act: "summons", obj: "Appellation Frankfurts für Contze von Bergen gegen westfälische Urteile", y: null, ev: "Der K. lädt Bernhard deshalb auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:552:A2", r: "dcd74001-b6ce-30f2-9b40-cc2786479d2e", act: "prohibition", obj: "Vorgehen gegen Frankfurt während des Prozesses", y: null, ev: "Er untersagt ihm, irgendetwas gegen die Frankfurter zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:553:A1", r: "e14309c4-834e-34f4-82f0-b347f65103a4", act: "prohibition", obj: "weitere Prozeßführung gegen Contze von Bergen", y: null, ev: "untersagt dem Freigrafen Heinrich Wynant von Züschen und Hallenberg", f: "Summary"},
  {k: "llm-v1:H4:554:A1", r: "cf4c1642-ffd0-3ee0-b057-4c6a65a16d34", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1471, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:555:A1", r: "a90b0330-f904-382c-a4e6-e4e820a01b86", act: "other", obj: "Kammergerichtsurteil Bavare gegen Frankfurt: Beweisauflage", y: null, ev: "beurkundet das Kammergerichtsurteil im Prozeß des Claus Bavare von Colmar", f: "Summary"},
  {k: "llm-v1:H4:556:A1", r: "289bca71-5146-3040-a104-b0497b3c0b6b", act: "appointment", obj: "Kommissar für die Beweisaufnahme im Prozeß Bavare gegen Frankfurt", y: null, ev: "ernennt ihn zum Kommissar für die weisung der Frankfurter Beweismittel", f: "Summary"},
  {k: "llm-v1:H4:557:A1", r: "1e2d55fe-96eb-3979-a4c6-5c4c2b0779de", act: "mandate", obj: "Türkenkontingent nach Laibach (8. März 1472)", y: null, ev: "die angeforderten 20 Mann zu Pferd und 50 Mann zu Fuß", f: "Summary"},
  {k: "llm-v1:H4:558:A1", r: "2d8ab037-5d52-3c0c-8fcd-b1c61a09f1c2", act: "communication", obj: "Antwort an Pfgf. Friedrich zur Landvogtei im Elsass", y: null, ev: "bestätigt Pfgf. Friedrich bei Rhein, seine vermeintliche Antwort", f: "Summary"},
  {k: "llm-v1:H4:559:A1", r: "962459ce-6fa1-3549-acfe-94fd14b33ae9", act: "mandate", obj: "Leistung des Regensburger Türkenanschlags", y: null, ev: "den auf sie entfallenden Anteil an dem in Regensburg beschlossenen Anschlag unverzüglich zu leisten", f: "Summary"},
  {k: "llm-v1:H4:560:A1", r: "14270b6d-9105-302c-8d22-b8be813080ed", act: "mandate", obj: "Regensburger Anschlag", y: null, ev: "K. F. fordert von Lübeck Erfüllung des Regensburger Anschlags.", f: "Summary"},
  {k: "llm-v1:H4:561:A1", r: "3c4093ec-a911-344a-8a56-a585f9af29d9", act: "mandate", obj: "Regensburger Anschlag", y: null, ev: "K. F. fordert von Köln Erfüllung des Regensburger Anschlags.", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

