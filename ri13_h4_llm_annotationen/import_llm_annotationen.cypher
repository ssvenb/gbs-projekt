  {k: "llm-v1:H4:567:A1", r: "3c41e1d1-3f76-33db-99d2-425ab5cb5873", act: "summons", obj: "Schadenersatzforderung Frankfurts gegen Claus Bavare", y: null, ev: "K. F. lädt Claus Bavare", f: "Summary"},
  {k: "llm-v1:H4:568:A1", r: "27a44760-b9dc-3539-adc1-42291f75296e", act: "summons", obj: "Verhandlungen am Hof (28. März 1473)", y: null, ev: "etliche Ratsfreunde mit voller Gewalt an den ksl. Hof abzuordnen", f: "Summary"},
  {k: "llm-v1:H4:569:A1", r: "ec431936-bd03-3894-bd72-dfac44ae49a9", act: "summons", obj: "wie n. 568", y: null, ev: "K. F. desgleichen an die Stadt Worms.", f: "Summary"},
  {k: "llm-v1:H4:570:A1", r: "3e314a23-7843-3011-b45c-e8c7106a6eac", act: "summons", obj: "Tag zu Augsburg (21. März 1473)", y: null, ev: "lädt zu einem Tag auf den 21. März nach Augsburg", f: "Summary"},
  {k: "llm-v1:H4:571:A1", r: "9f86f713-5041-3ab2-a62a-230987e7b26f", act: "mandate", obj: "Einstellung und Beseitigung des hanauischen Grabens bei Seckbach", y: null, ev: "innerhalb von 15 Tagen nach Erhalt dieses Mandats einzustellen und gänzlich zu beseitigen", f: "Summary"},
  {k: "llm-v1:H4:571:A2", r: "9f86f713-5041-3ab2-a62a-230987e7b26f", act: "summons", obj: "rechtliche Verantwortung im Fall von Einwendungen", y: null, ev: "so lädt er ihn auf den 45. Tag nach Ablauf dieser Frist", f: "Summary"},
  {k: "llm-v1:H4:572:A1", r: "c9b12b23-cfd6-3ae4-af4b-d7136e050835", act: "summons", obj: "gemeiner Tag zu Augsburg (21. September 1473)", y: null, ev: "ihre bevollmächtigte Ratsbotschaft dorthin zu entsenden", f: "Summary"},
  {k: "llm-v1:H4:573:A1", r: "ce99558d-015a-3ebb-b26f-fe9955679d09", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt Abt Johann von Fulda Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:574:A1", r: "a930b254-0cd0-33c7-bb98-d60afc29a680", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt Abt Ludwig von Hersfeld Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:575:A1", r: "41d97f7e-d066-368d-86c1-c8ef3d17509d", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt Gf. Ludwig von Isenburg-Büdingen Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:576:A1", r: "8c874c64-6308-3356-9a63-61fae8a62be4", act: "summons", obj: "Augsburger Tag", y: null, ev: "Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:577:A1", r: "a9756821-5a9e-3093-a7e0-d95b47b8507f", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt Burggraf, Baumeister und Burgmannen der Burg Gelnhausen Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:578:A1", r: "1e0c11b6-5897-3943-b04f-ca97c13999cb", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt der Stadt Gelnhausen Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:579:A1", r: "ffd00dcf-c432-3ba8-a47c-c771f465b846", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt Bürgermeister und Rat der Stadt Wetzlar Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:580:A1", r: "5909c5b0-bf33-3e7e-8cb0-c0aabfbfc918", act: "summons", obj: "Augsburger Tag", y: null, ev: "K. F. befiehlt der Stadt Mühlhausen i. Thür. Besuch des Augsburger Tages.", f: "Summary"},
  {k: "llm-v1:H4:581:A1", r: "127798e8-da1c-31b1-9a4b-278ffe52a93e", act: "commission", obj: "Zustellung kaiserlicher Briefe zum Augsburger Tag", y: null, ev: "diese in Anbetracht der Kürze der Zeit unverzüglich durch ihre geschworenen Boten", f: "Summary"},
  {k: "llm-v1:H4:582:A1", r: "e27ab629-7cde-34aa-9a3a-76658b27a136", act: "summons", obj: "Tag zu Basel zur Beilegung der Streitigkeiten mit den Eidgenossen", y: null, ev: "lädt die Eidgenossen zu einem Tag nach Basel", f: "Summary"},
  {k: "llm-v1:H4:583:A1", r: "a3599079-b30d-331f-9ba2-76899b11f6fb", act: "enfeoffment", obj: "Reichslehen, u. a. Gülte von vier Mark auf der Frankfurter Stadtwaage", y: null, ev: "K. F. belehnt Heinrich von Trohe", f: "Summary"},
  {k: "llm-v1:H4:584:A1", r: "76908c72-40f0-3d30-af14-b6c8ac99994d", act: "mandate", obj: "Auszahlung von 2500 fl. rh. aus dem Depot des Erzbischofs von Magdeburg an Hans Ingolt", y: null, ev: "gegen Übergabe seiner ksl. Quittung an den Straßburger Bürger Hans Ingolt", f: "Summary"},
  {k: "llm-v1:H4:585:A1", r: "e7dda583-e3f6-310d-87de-21cf5417aa96", act: "receipt", obj: "2500 fl. rh. aus dem Depot des Erzbischofs von Magdeburg", y: null, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt die Bezahlung der von Eb. Johann von Magdeburg für ihn hinterlegten 2500 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:586:A1", r: "33a0f5fe-e7f8-358f-82c1-25fda6ced095", act: "commission", obj: "Empfang der 2500 fl. rh. beim Frankfurter Rat", y: null, ev: "beauftragt und bevollmächtigt Clais Ingolt von Straßburg", f: "Summary"},
  {k: "llm-v1:H4:587:A1", r: "34766cf6-4e35-3bdd-a469-d857556a409c", act: "summons", obj: "verlegter Augsburger Tag (12. Oktober 1473)", y: null, ev: "dort pünktlich bei ihm vertreten zu sein", f: "Summary"},
  {k: "llm-v1:H4:588:A1", r: "0b072930-ddf9-396d-aa51-c41f9de65785", act: "communication", obj: "Verlegung des Augsburger Tages", y: null, ev: "die Verlegung des Augsburger Tages vom 21. September auf den 12. Oktober mit.", f: "Summary"},
