  {k: "llm-v1:H4:597:A1", r: "eedf8fd7-244a-32a7-b7cf-68504639d30b", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
  {k: "llm-v1:H4:598:A1", r: "13044c7e-2090-31ae-914a-1c5428cac96c", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
  {k: "llm-v1:H4:599:A1", r: "29d9c8de-d48d-3dc9-b284-7aeed873fb6c", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
  {k: "llm-v1:H4:600:A1", r: "4c8e2f29-1787-3cd8-ad11-367c5661cdee", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
  {k: "llm-v1:H4:601:A1", r: "fe644a8b-fc8a-3331-a3bb-52c2ebc10d0b", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
  {k: "llm-v1:H4:602:A1", r: "ed43faa5-7a2f-34e3-8f53-2fa51dd2a017", act: "commission", obj: "Zustellung kaiserlicher Schreiben", y: null, ev: "beauftragt Bürgermeister und Rat der Stadt Frankfurt mit der Zustellung", f: "Summary"},
  {k: "llm-v1:H4:603:A1", r: "6b462cb2-98fc-3ba0-a7c8-c285d3ac8695", act: "credential", obj: "Darlehen von 4000 fl. rh.", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt deren Diener Hans Gelthaus", f: "Summary"},
  {k: "llm-v1:H4:603:A2", r: "6b462cb2-98fc-3ba0-a7c8-c285d3ac8695", act: "request", obj: "Darlehen von 4000 fl. rh. gegen Anweisung auf Stadtsteuer und Mainzer Zoll", y: null, ev: "bittet sie, ihm das Geld zu bewilligen", f: "Summary"},
  {k: "llm-v1:H4:604:A1", r: "32271428-7346-3596-a408-39508b695999", act: "summons", obj: "Tag in Köln mit Geleit", y: null, ev: "lädt Eb. Ruprecht von Köln mit seinen Räten zu einem Tag vor sich", f: "Summary"},
  {k: "llm-v1:H4:605:A1", r: "284f1af2-9dbe-3701-9d19-3e0411d9d3e9", act: "summons", obj: "Augsburg (14. Januar 1474)", y: null, ev: "lädt Kg. Christian von Dänemark", f: "Summary"},
  {k: "llm-v1:H4:606:A1", r: "55b7178f-98bc-3cc8-a8ac-b02ecb90455c", act: "summons", obj: "verlegter Augsburger Tag (6. Januar 1474)", y: null, ev: "ihre bevollmächtigte Botschaft an diesem Tag bei ihm in Augsburg zu haben", f: "Summary"},
  {k: "llm-v1:H4:607:A1", r: "d874ef44-83f4-3587-980f-4eaa588100d8", act: "enfeoffment", obj: "Herzogtum Holstein (mit Stormarn und Dithmarschen)", y: null, ev: "belehnt mit diesem Kg. Christian von Dänemark", f: "Summary"},
  {k: "llm-v1:H4:608:A1", r: "375a796c-27bb-3cec-80b4-6352e00d7450", act: "enfeoffment", obj: "Regalien; Bestätigung aller Rechte", y: null, ev: "verleiht Kg. Christian von Dänemark die Regalien", f: "Summary"},
  {k: "llm-v1:H4:609:A1", r: "20d71db1-7415-3578-b999-01e0af9b24c7", act: "summons", obj: "neuer Augsburger Tag (17. April 1474)", y: null, ev: "ihre bevollmächtigte Ratsbotschaft zum entsprechenden Zeitpunkt zu ihm zu schicken", f: "Summary"},
  {k: "llm-v1:H4:610:A1", r: "6f4fcf49-84a4-38f3-b311-f4494b3f4d03", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:611:A1", r: "b59e5eb6-90b3-3706-967e-867b02ec3e0b", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:612:A1", r: "6c0fc2b8-4264-3dcd-bf3f-6282c43418ce", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:613:A1", r: "b0c790a5-31a1-31f7-8ac7-29aeaecacc44", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:614:A1", r: "a09a203a-71b9-378a-820f-62f40962714a", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:615:A1", r: "c44e177c-3ba9-390d-99d1-913a1e11062f", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:616:A1", r: "bb557b7f-2f6e-342e-9565-bb3f4be1c99e", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:617:A1", r: "4c80676e-5471-3888-8ac7-82094d952d7f", act: "communication", obj: "neuer Termin für den Augsburger Tag", y: null, ev: "neuen Termin für den Augsburger Tag mit.", f: "Summary"},
  {k: "llm-v1:H4:618:A1", r: "d1247a8f-91c7-3206-8370-31f7f979d8a8", act: "privilege_grant", obj: "Ordnung des Burggerichts Friedberg und Wahl der Greven im Freigericht Kaichen", y: null, ev: "bestimmt der K. unwiderruflich für ewige Zeiten", f: "Summary"},
  {k: "llm-v1:H4:619:A1", r: "8fed0597-0c52-3556-a135-fbf1a4cefe9f", act: "other", obj: "Schuldbrief über 2000 fl.", y: null, ev: "stellt der Stadt Köln einen Schuldbrief für einen Kredit in Höhe von 2000 fl. aus.", f: "Summary"},
  {k: "llm-v1:H4:620:A1", r: "8ea1d79c-4f88-3669-8554-b3a4005c4609", act: "request", obj: "Aufschub der Rückzahlung bis zur Nürnberger Heiltumsmesse", y: null, ev: "ersucht sie um Geduld bis zur Nürnberger Heiltumsmesse", f: "Summary"},
  {k: "llm-v1:H4:621:A1", r: "ed1f7612-128d-3c1d-9ca2-ab1eb6423f2d", act: "request", obj: "Vertröstung des Kölner Beauftragten wegen der Schuld", y: null, ev: "bittet sie (Frankfurt), dies einem etwaigen Kölner Beauftragten mitzuteilen", f: "Summary"},
  {k: "llm-v1:H4:622:A1", r: "e6bf78fd-5888-306e-9f61-e37345a486f5", act: "request", obj: "Beförderung kaiserlicher Briefe zum Augsburger Tag", y: null, ev: "zur Beförderung an ihre auf einem beiliegenden Zettel verzeichneten Adressaten", f: "Summary"},
  {k: "llm-v1:H4:623:A1", r: "10f5716b-12c4-3dcc-82bd-516ff0bbb72e", act: "summons", obj: "rechtliche Verantwortung", y: null, ev: "lädt Pfgf. Friedrich (den Siegreichen) bei Rhein", f: "Summary"},
  {k: "llm-v1:H4:624:A1", r: "e369075f-fcdb-33b5-8cb1-9b7f7a09f567", act: "enfeoffment", obj: "Hälfte von Schloß und Herrschaft Bickenbach", y: null, ev: "verleiht dem Gf. (Albrecht) von Mansfeld", f: "Summary"},
  {k: "llm-v1:H4:625:A1", r: "f1ed37e6-af63-3ced-94c1-739ce0b291bd", act: "public_peace", obj: "Verlängerung des Landfriedens um sechs Jahre", y: null, ev: "um weitere sechs Jahre verlängert hat", f: "Summary"},
  {k: "llm-v1:H4:626:A1", r: "0e71113b-51de-3952-9d0c-6a52286f2d7c", act: "summons", obj: "Klage Gf. Albrechts von Mansfeld", y: null, ev: "lädt Bürgermeister und Rat der Stadt Frankfurt vor sich zu rechtlicher Verantwortung", f: "Summary"},
  {k: "llm-v1:H4:627:A1", r: "05ca8b27-691f-387a-b43b-fac9850ef254", act: "mandate", obj: "Übergabe der Prozeßunterlagen für die Appellation Conrad Aspachs", y: null, ev: "sämtliche Prozeßunterlagen zu übergeben", f: "Summary"},
  {k: "llm-v1:H4:628:A1", r: "8910909f-2352-3733-8723-8082fe3e3a3a", act: "mandate", obj: "Übergabe der Prozeßunterlagen binnen 15 Tagen (Kammergerichtsurteil)", y: null, ev: "innerhalb von 15 Tagen nach Erhalt dieses compulsoribrieves zu übergeben", f: "Summary"},
  {k: "llm-v1:H4:629:A1", r: "4add737e-18bf-33e5-b880-709a91fdb3e5", act: "ban_enforcement", obj: "Acht über Pfgf. Friedrich bei Rhein", y: null, ev: "erklärt diesen in die Acht.", f: "Summary"},
  {k: "llm-v1:H4:630:A1", r: "750f5194-f676-331f-99de-a593a50e59d9", act: "mandate", obj: "Freigabe arrestierten Tuchs der Oberurseler Bürger", y: null, ev: "dieses Tuch innerhalb von 15 Tagen nach Erhalt dieses Mandats freizugeben", f: "Summary"},
  {k: "llm-v1:H4:631:A1", r: "c0580eeb-3f98-39c3-be23-2fc48694bf8e", act: "privilege_grant", obj: "Erwerb des Reichslehens Dorf und Gericht Bornheim", y: null, ev: "erlaubt Bürgermeistern und Rat der Stadt Frankfurt, das von ihm und dem Reich zu Lehen gehende Dorf und Gericht Bornheim", f: "Summary"},
  {k: "llm-v1:H4:632:A1", r: "1bf69dd5-e2c5-3cbe-85f2-0205cb4c5485", act: "appointment", obj: "Kommissar für den Türkenanschlag in Bremen, Münster und Utrecht", y: null, ev: "bestellt der K. hiermit Hz. Johann vonn unnsern wegen zum gemeynnen comissari", f: "Summary"},
  {k: "llm-v1:H4:633:A1", r: "fa509843-f543-31a3-b291-efe5c6c53c4d", act: "mandate", obj: "Hilfe für Straßburg gegen Angreifer", y: null, ev: "die Straßburger auf deren Erfordern von unsern und des heiligen reichs wegen gegen jeden Angreifer zu unterstützen", f: "Summary"},
  {k: "llm-v1:H4:634:A1", r: "8476836f-3d7c-3626-9c0a-931a429a2047", act: "request", obj: "Entgegennahme von 1400 fl. rh. und Auszahlung an Köln", y: null, ev: "von Hans Müllner von Nürnberg 1400 fl. rh. entgegenzunehmen", f: "Summary"},
  {k: "llm-v1:H4:635:A1", r: "ba4d8e32-8d27-34df-8803-ee31f13de4ed", act: "communication", obj: "Rückzahlung von 1400 fl. rh. über den Frankfurter Rat", y: null, ev: "benachrichtigt die Stadt Köln davon", f: "Summary"},
  {k: "llm-v1:H4:636:A1", r: "817e9678-1c5e-34a9-b284-2f53249ca29a", act: "enfeoffment", obj: "Fischfach im Main bei Frankfurt", y: null, ev: "Mit diesem Fach belehnt der K. Georg", f: "Summary"},
  {k: "llm-v1:H4:637:A1", r: "d2979529-aed8-3d22-8bef-4d1f33c5f441", act: "mandate", obj: "reisiger Zug nach Köln gegen Burgund", y: null, ev: "einen reisigen Zug aufzustellen und diesen nach Köln zu schicken", f: "Summary"},
  {k: "llm-v1:H4:638:A1", r: "f8d4a265-256e-3b9f-867f-8e4632a09d10", act: "mandate", obj: "wie n. 637", y: null, ev: "K. F. desgleichen an andere (noch nicht bekannte) Reichsangehörige (einzeln).", f: "Summary"},
  {k: "llm-v1:H4:639:A1", r: "63874dd0-b669-393d-b482-89a49d588795", act: "request", obj: "Beförderung kaiserlicher Briefe", y: null, ev: "bittet sie, diese unverzüglich durch ihre geschworenen Boten", f: "Summary"},
  {k: "llm-v1:H4:640:A1", r: "2a85a791-2167-3a80-b6b6-080f47524f30", act: "communication", obj: "Belagerung von Neuss durch Burgund", y: null, ev: "schreibt an die Stadt Köln wegen der Belagerung von Neuss", f: "Summary"},
  {k: "llm-v1:H4:641:A1", r: "30fe3968-1be0-3bba-9a54-9fd44d5585f7", act: "mandate", obj: "Eilende Hilfe gegen Burgund: 100 Reiter und 300 Mann zu Fuß nach Koblenz", y: null, ev: "100 Mann zu Pferd und 300 Mann zu Fuß", f: "Summary"},
  {k: "llm-v1:H4:642:A1", r: "b92e26a7-64c5-3031-8cd8-e5cb41f288b0", act: "credential", obj: "mündliche Botschaft; Geleit für Gf. Hans von Honstein", y: null, ev: "beglaubigt bei allen Reichsuntertanen Gf. Hans von Honstein", f: "Summary"},
  {k: "llm-v1:H4:643:A1", r: "1b48ba34-8e3a-3091-bfd7-d1f2cd73686a", act: "credential", obj: "Werbung Georgs von Hell", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Rat Dr. Georg von Hell", f: "Summary"},
  {k: "llm-v1:H4:644:A1", r: "32bdf281-0085-3cb5-b8eb-556b37e62637", act: "enfeoffment", obj: "Herzogtum Savoyen (vormundschaftlich)", y: null, ev: "belehnt Herzogin Jolanthe von Savoyen", f: "Summary"},
  {k: "llm-v1:H4:645:A1", r: "aa974cd7-26fd-34d8-bfe3-736379fe353e", act: "request", obj: "Transfer von 1400 fl. rh. nach Würzburg und weiteres Darlehen von 1400 fl. rh.", y: null, ev: "unverzüglich per Wechsel oder auf andere Weise nach Würzburg zu transferieren", f: "Summary"},
  {k: "llm-v1:H4:646:A1", r: "5d94cf5a-84a0-3e7a-8360-12fb632f63c9", act: "mandate", obj: "Kontingent gegen Burgund in Frankfurt", y: null, ev: "ihr Kontingent in Frankfurt bereitzustellen", f: "Summary"},
  {k: "llm-v1:H4:647:A1", r: "60a906a7-2742-3b86-b53b-f217da5b5af9", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "K. F. befiehlt Eb. Johann von Trier Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:648:A1", r: "ea44759c-b80f-3475-a44d-959d425140d9", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "K. F. befiehlt Gf. Otto von Solms Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:649:A1", r: "52e410a3-e0d6-31eb-aa9f-49967377fa2c", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:650:A1", r: "48c9950f-0060-36e4-827c-580366c83b07", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "K. F. befiehlt Gf. Philipp von Katzenelnbogen Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:651:A1", r: "6d98432c-e6e2-314f-9d36-e4d3d4080051", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:652:A1", r: "a45a90e6-e014-3eac-b6d1-e46a8f171c3f", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "K. F. befiehlt Heilbronn Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:653:A1", r: "89d6ae11-1e06-3923-8a95-6714da8218ae", act: "mandate", obj: "Zuzug gegen Burgund", y: null, ev: "K. F. befiehlt Kaufbeuren Zuzug gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:654:A1", r: "7496b397-dd10-3cb4-aab3-8a5ec997b1d0", act: "mandate", obj: "weitere 600 Mann mit Wagenburg gegen Burgund (27. November 1474)", y: null, ev: "unverzüglich weitere 600 wohlgerüstete Männer", f: "Summary"},
  {k: "llm-v1:H4:655:A1", r: "b3580f88-ecbd-3cc9-835e-49b107f55417", act: "mandate", obj: "Auszahlung der 1400 fl. an Köln; Stadtsteuer nach Würzburg", y: null, ev: "ihm selbst (K. F.) aber unverzüglich ihre bald fällige Stadtsteuer gegen Empfang seiner Quittung nach Würzburg zu entrichten", f: "Summary"},
  {k: "llm-v1:H4:656:A1", r: "9cb9addc-fcd3-3c9f-950f-27025ef20fdc", act: "commission", obj: "Hilfe- und Holzfronpflicht der 19 Dörfer des Bornheimer Bergs durchsetzen", y: null, ev: "erteilt er ihnen volle Gewalt zur Anwendung geeigneter Zwangsmaßnahmen", f: "Summary"},
  {k: "llm-v1:H4:657:A1", r: "d32f2d22-643f-3139-9900-64326ac5eb7c", act: "mandate", obj: "Gehorsam der Frankfurter Truppen in Koblenz gegenüber dem Hauptmann", y: null, ev: "seinen oder seines Hauptmanns Anordnungen Folge zu leisten", f: "Summary"},
  {k: "llm-v1:H4:658:A1", r: "bf62521b-9415-3db1-9b5b-6f0c9704b967", act: "mandate", obj: "Anfertigung von drei Reichsbannern", y: null, ev: "drei des reichs panir aufdas hubscht anfertigen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:659:A1", r: "28fa6a95-6fe8-3748-9022-98726c64a364", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1474, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 701–800
UNWIND [
  {k: "llm-v1:H4:660:A1", r: "ea229098-f757-3688-bb4a-f11df67eb3a6", act: "mandate", obj: "Mahnung wegen der 1400 fl. rh. für Köln", y: null, ev: "mahnt Hans Müllner (von Nürnberg) wegen der in Frankfurt deponierten", f: "Summary"},
  {k: "llm-v1:H4:661:A1", r: "58a97c95-c23b-3d8e-9567-d444c1e024a0", act: "mandate", obj: "Auszahlung der 1400 fl. rh. an Köln", y: null, ev: "an den Rat der Stadt Köln auszuzahlen", f: "Summary"},
  {k: "llm-v1:H4:662:A1", r: "42417487-9d8a-305e-9cab-696439aeec45", act: "summons", obj: "Appellation Frankfurts gegen Urteile des Freistuhls Lichtenfels", y: null, ev: "Er lädt ihn deshalb auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:663:A1", r: "795423cf-e293-3002-8b19-65167fc569f0", act: "mandate", obj: "Freilassung gefangener Frankfurter Fischer bei Pön von 40 Mark Gold", y: null, ev: "die von seinen Leuten trotz Frankfurter Rechtserbietens gefangen genommenen Frankfurter Fischer", f: "Summary"},
  {k: "llm-v1:H4:664:A1", r: "3c99f469-49af-31b8-93c3-3af6f8b7d3f5", act: "mandate", obj: "Zuzug der Dörfer des Bornheimer Bergs gegen Burgund", y: null, ev: "ihm unverzüglich mit und auf Anforderung von Bürgermeistern und Rat der Stadt Frankfurt gegen den Hz. von Burgund zu Hilfe zu ziehen", f: "Summary"},
  {k: "llm-v1:H4:665:A1", r: "ceb9256a-008d-3eeb-9ef5-be7b484b0480", act: "prohibition", obj: "Behinderung des Zuzugs der Dörfer des Bornheimer Bergs", y: null, ev: "befiehlt ihm, diese nicht daran zu hindern", f: "Summary"},
  {k: "llm-v1:H4:666:A1", r: "04c480f7-1388-3d10-a7c8-a2b5d4897e93", act: "other", obj: "Verrechnung eines Darlehens von 2144 fl. rh. mit Stadtsteuer und Mainzer Zollanteil", y: null, ev: "erlaubt Bürgermeistern und Rat der Stadt Frankfurt, die ihm jetzt geliehenen 2144 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:667:A1", r: "187112b8-8843-3d4b-af3c-317f7eaa3199", act: "other", obj: "Bündnis mit Kg. Ludwig XI. von Frankreich gegen Burgund", y: null, ev: "schließt für sich und das Reich ein Bündnis mit Kg. Ludwig (XI.) von Frankreich", f: "Summary"},
  {k: "llm-v1:H4:668:A1", r: "c2ceb44e-794f-391f-9cdf-4027008f0807", act: "mandate", obj: "zugunsten der Brüder Gottfried und Friedrich von Cleen", y: null, ev: "ein Mandat zugunsten der Brüder Gottfried und Friedrich von Cleen", f: "Summary"},
  {k: "llm-v1:H4:669:A1", r: "0f3d675b-6f96-3248-9690-412340ec2b20", act: "mandate", obj: "Übersendung geliehener Büchsen und Pulver", y: null, ev: "ihm die Büchsen und das Pulver[1], die sie ihm zu leihen versprochen hatten", f: "Summary"},
  {k: "llm-v1:H4:670:A1", r: "cd410c7b-29bf-3e32-9620-8e0c5c1aa5ba", act: "mandate", obj: "weiteres Pulver", y: null, ev: "ihm auch die übrigen 25 Zentner Pulver", f: "Summary"},
  {k: "llm-v1:H4:671:A1", r: "386a060e-77ec-3181-bc2e-8212f7f8700f", act: "other", obj: "Ankündigung der Reichsgegenwehr gegen Hz. Karl von Burgund", y: null, ev: "kündigt deshalb ihm und seinen Helfern", f: "Summary"},
  {k: "llm-v1:H4:672:A1", r: "18a147f0-aa6f-37e2-9b54-716a534e719d", act: "mandate", obj: "Pulver zur Eroberung von Linz", y: null, ev: "ihm das schon letztens[1] angemahnte Pulver umgehend zu schicken", f: "Summary"},
  {k: "llm-v1:H4:673:A1", r: "78cbef27-2114-3e60-9121-871c69ed8258", act: "mandate", obj: "Aufgebot eines Viertels aller Männer gegen Burgund (15. März 1475)", y: null, ev: "mit dem vierten Teil aller Männer", f: "Summary"},
  {k: "llm-v1:H4:674:A1", r: "24fb7b78-12aa-3ba3-9a88-16724e24ac3b", act: "mandate", obj: "wie n. 673", y: null, ev: "K. F. desgleichen an Bürgermeister, Rat und Gemeinde der Stadt Mühlhausen i. Thür.", f: "Summary"},
  {k: "llm-v1:H4:675:A1", r: "274fc3b8-1269-300b-93b8-90e0e0170d09", act: "mandate", obj: "wie n. 673", y: null, ev: "K. F. desgleichen an die Stadt Speyer.", f: "Summary"},
  {k: "llm-v1:H4:676:A1", r: "af74aa34-2bd3-3e4e-9321-8020c9c523a4", act: "mandate", obj: "persönlicher Zuzug gegen Burgund (15. März 1475)", y: null, ev: "am sundag Letare (März 15) persönlich mit allen seinen Leuten bei ihm im Feld zu erscheinen", f: "Summary"},
  {k: "llm-v1:H4:677:A1", r: "9a0cda9a-5e92-3b13-9624-7418fb576138", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:678:A1", r: "8d989c90-9482-349a-8b66-07dd1c777931", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:679:A1", r: "02fc097c-a37a-385e-b1c9-c579598be79a", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:680:A1", r: "4d4cabfd-9183-355d-9f5d-d55076741520", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:681:A1", r: "d9fd0920-d5e9-36e0-a20d-8222a3454af4", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:682:A1", r: "d3c81b7f-a305-35e1-be25-af87abc15d87", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:683:A1", r: "fed54039-0a4f-37cb-b118-e3a9841eb650", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:684:A1", r: "4fda8eba-13e7-36b1-a24f-e798a50c1833", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:685:A1", r: "5d35d1d4-c17a-3aff-b12f-aec2a921546f", act: "mandate", obj: "Erscheinen im Feld gegen Burgund", y: null, ev: "mit Ausrüstung im Feld zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:686:A1", r: "64505ce1-6e99-3286-833c-19ad2b29c4a5", act: "mandate", obj: "Zuzug der Dörfer des Bornheimer Bergs mit Frankfurt bei Pön von 100 Mark Gold", y: null, ev: "den Frankfurtern auf Erfordern entsprechend dem alten Herkommen", f: "Summary"},
  {k: "llm-v1:H4:687:A1", r: "b3350628-7fcd-3931-be3f-2431938cb711", act: "mandate", obj: "Schadenersatz an Frankfurt; Schonung der gehorsamen Dörfer", y: null, ev: "gebietet ihm, die vier gehorsamen Dörfer nicht zu bekümmern", f: "Summary"},
  {k: "llm-v1:H4:688:A1", r: "12460b31-5f11-390c-bfd8-6a12c98869d4", act: "commission", obj: "Zustellung kaiserlicher Gebotsbriefe und Beleg des Vollzugs", y: null, ev: "diese unverzüglich durch ihre geschworenen Boten befördern zu lassen", f: "Summary"},
  {k: "llm-v1:H4:689:A1", r: "a2ba14d7-50c9-39ac-9bcf-045365fa9a08", act: "mandate", obj: "Kriegsbeihilfe von 2000 fl. rh. gegen Burgund", y: null, ev: "ihm unverzüglich 2000 fl. rh. zu Händen seines Dieners und Hofgesindes Dr. Kaspar von Bernau", f: "Summary"},
  {k: "llm-v1:H4:690:A1", r: "1f48932d-2cf4-3778-9c4e-cc056916178a", act: "mandate", obj: "Hilfe bei der Einziehung von 2000 fl. rh. von den Frankfurter Juden", y: null, ev: "seinem mit der Entgegennahme des Geldes beauftragten Diener und Hofgesinde Dr. Kaspar von Bernau bei der Erfüllung seines Auftrags behilflich zu sein", f: "Summary"},
  {k: "llm-v1:H4:691:A1", r: "edfab598-e775-3b1e-a4b4-9bfe5b685ec3", act: "mandate", obj: "Kriegsbeihilfe von 300 fl. rh. gegen Burgund", y: null, ev: "ihm eine Kriegsbeihilfe gegen den Hz. von Burgund in Höhe von 300 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:692:A1", r: "581b4e89-d7fe-3b81-90e6-bb04300aef97", act: "commission", obj: "Entscheidung der Klage Isaaks von Giengen", y: null, ev: "beauftragt die Frankfurter Judenmeister Simon von Eppstein, Mosse von Luyden und Joseph Wetzl", f: "Summary"},
  {k: "llm-v1:H4:693:A1", r: "8c2e6ab9-d5c6-34df-beb4-6c572e6a3e2f", act: "mandate", obj: "Inventarisierung und Verwahrung des strittigen Nachlasses", y: null, ev: "den strittigen Besitz innerhalb von neun Tagen nach Erhalt dieses Briefes im Beisein der Judenmeister zu inventarisieren", f: "Summary"},
  {k: "llm-v1:H4:694:A1", r: "49ce8bc3-b769-3446-ba09-7fdccea14228", act: "privilege_grant", obj: "kaiserlicher Schutz für Isaak von Giengen", y: null, ev: "nimmt Isaak Jude von Giengen in seinen Schutz.", f: "Summary"},
  {k: "llm-v1:H4:695:A1", r: "c094b6b8-0f58-362f-9eb3-30536271905d", act: "communication", obj: "Streit der Mainzer Kartäuser mit dem Bartholomäusstift um Fechenheim und Riedern", y: null, ev: "schreibt an Frankfurt wegen eines Streits", f: "Summary"},
  {k: "llm-v1:H4:696:A1", r: "16782f08-6562-3497-9842-6c11ffbc276f", act: "privilege_grant", obj: "Pfändung säumiger Dörfer des Bornheimer Bergs", y: null, ev: "gestattet Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:697:A1", r: "0217c73e-3118-3563-9a73-20c489c09e13", act: "request", obj: "Bestellung von 50000 Pfeilen", y: null, ev: "für ihn 50000 Pfeile zu bestellen", f: "Summary"},
  {k: "llm-v1:H4:698:A1", r: "408cd52e-3ff9-3d66-b918-0e99a0c2e138", act: "mandate", obj: "Weiterleitung des Augsburger Pulvers", y: null, ev: "ihm dieses anschließend unverzüglich zuzuschicken", f: "Summary"},
  {k: "llm-v1:H4:699:A1", r: "70175e34-167c-351e-9908-aa5da230e4f4", act: "request", obj: "Übersendung und Darlehen von Pulver", y: null, ev: "ihm alles bei ihnen verfügbare und von anderen Reichsstädten hinterlegte Pulver zuzusenden", f: "Summary"},
  {k: "llm-v1:H4:700:A1", r: "6d840d33-7591-3a3e-bc6f-d00b6a48f5f1", act: "request", obj: "Pulver und drei Tonnen Pfeile", y: null, ev: "ihm darüber hinaus auch drei thunnen mit Pfeilen zu liefern", f: "Summary"},
  {k: "llm-v1:H4:701:A1", r: "4190916a-c9a6-394e-84b7-8842602e18d8", act: "credential", obj: "Verhandlungen über die Hilfe gegen Burgund", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt den Erbmarschall Alexander von Pappenheim und Meister Jobst Kapps", f: "Summary"},
  {k: "llm-v1:H4:702:A1", r: "7a2f14e7-abc7-37cf-92a6-28c18a1a01a5", act: "credential", obj: "Verhandlungen über die Hilfe gegen Burgund", y: null, ev: "Herrn Trudbert von Staufen[1] zu Verhandlungen", f: "Summary"},
  {k: "llm-v1:H4:703:A1", r: "720d9bac-cb1a-37e5-a282-5a12ad290bdb", act: "mandate", obj: "Übersendung des Augsburger Pulvers und weiterer 30–40 Zentner", y: null, ev: "dieses Versäumnis nun unverzüglich nachzuholen", f: "Summary"},
  {k: "llm-v1:H4:704:A1", r: "50fc5f92-324b-305c-b0ff-b8ac1f552411", act: "request", obj: "Kredit von 2000 fl.", y: null, ev: "seine Bitte um einen Kredit in Höhe von 2000 fl.", f: "Summary"},
  {k: "llm-v1:H4:705:A1", r: "44b2c41f-7a07-3388-8ebe-b1bfe83bc646", act: "mandate", obj: "Zahlung der 2000 fl. rh. Kriegsbeihilfe der Frankfurter Juden bei Pön von 40 Mark Gold", y: null, ev: "nunmehr für die unverzügliche Zahlung zu sorgen", f: "Summary"},
  {k: "llm-v1:H4:706:A1", r: "b4798b95-ce0f-3349-8273-7deb22eedca4", act: "mandate", obj: "Aufbruch der mainzischen und trierischen Truppen von Linz", y: null, ev: "unverzüglich ihr Lager abzubrechen und ihm nachzuziehen", f: "Summary"},
  {k: "llm-v1:H4:707:A1", r: "b47f8b6b-7a46-3c9c-9cc7-4478f47c9218", act: "mandate", obj: "Durchsetzung des Aufbruchsbefehls; Sicherung von Linz", y: null, ev: "gemeinsam mit Ldgf. Heinrich von Hessen für die Befolgung des Mandats zu sorgen", f: "Summary"},
  {k: "llm-v1:H4:708:A1", r: "6aebc915-06bc-344c-be67-6dcb479bac8e", act: "communication", obj: "Barfüßer", y: null, ev: "K. F. schreibt an Frankfurt wegen der Barfüßer.", f: "Summary"},
  {k: "llm-v1:H4:709:A1", r: "fe8c8b67-338b-3468-be1f-52fa51e2be50", act: "mandate", obj: "Truppen gegen Burgund trotz Gerüchten über einen Ausgleich", y: null, ev: "ihm unverzüglich nach Erhalt dieses Briefes ihr Volk gegen den Hz. (Karl) von Burgund zuzuschicken", f: "Summary"},
  {k: "llm-v1:H4:710:A1", r: "256ef8e0-8606-3005-ba70-e2417a638f15", act: "request", obj: "Antwort zur Guldenmünze", y: null, ev: "fordert von den Frankfurtern Antwort auf sein ihnen durch Walter Schwarzenberg übermitteltes Begehren", f: "Summary"},
  {k: "llm-v1:H4:711:A1", r: "0e11279c-d6ff-3fa6-bc1f-0fdce1241896", act: "summons", obj: "Klage wegen Begünstigung Burgunds", y: null, ev: "lädt die Hzz. Gerhard und Wilhelm von Jülich und Berg zu rechtlicher Verantwortung vor sich", f: "Summary"},
  {k: "llm-v1:H4:712:A1", r: "3e2f03f5-287a-3fd4-a513-eb7e53b909e3", act: "request", obj: "schriftliche Antwort zur Münze durch Friedrich Nachtrabe", y: null, ev: "ihm die schriftliche Antwort auf sein ihm nagst vorgetragenes Ansinnen bezüglich der Münze", f: "Summary"},
  {k: "llm-v1:H4:713:A1", r: "c02c8bdd-cfd1-3152-a713-19974b4fd1e3", act: "mandate", obj: "eilende weitere Truppen gegen Burgund; Treueid der Hauptleute", y: null, ev: "ihm eilends so viele Truppen wie möglich zu schicken", f: "Summary"},
  {k: "llm-v1:H4:714:A1", r: "a6fe27b8-81bc-3009-b008-7fefef3ffcbc", act: "mandate", obj: "wie n. 713", y: null, ev: "K. F. desgleichen an etliche andere (noch nicht bekannte) Reichsstädte.", f: "Summary"},
  {k: "llm-v1:H4:715:A1", r: "aa2f073d-33d9-3488-bdc3-bfb5b52e3e2b", act: "commission", obj: "Beförderung von Briefen an andere Reichsstädte", y: null, ev: "diese unverzüglich durch ihre geschworenen Boten befördern zu lassen", f: "Summary"},
  {k: "llm-v1:H4:716:A1", r: "2efab072-2769-3015-8133-1d31f0fbe8d8", act: "other", obj: "Verrechnung eines Darlehens von 1000 fl. rh. mit Stadtsteuer und Mainzer Zollanteil", y: null, ev: "die ihm jetzt[1]geliehenen 1000 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:717:A1", r: "ac43afb6-b0c7-343f-a8d6-505bd9013e1e", act: "privilege_confirmation", obj: "Freiheit der Burg Friedberg von Arrest und fremden Gerichten in den Wetterauer Städten", y: null, ev: "bestätigt Bggf. Baumeistern und Burgmannen der Burg Friedberg", f: "Summary"},
  {k: "llm-v1:H4:718:A1", r: "350d343e-4131-3813-be7c-1085ce43b441", act: "mandate", obj: "Inventarisierung und Verwahrung des Nachlasses Leb Stennglins binnen vier Tagen", y: null, ev: "das Erbe binnen vier Tagen nach Erhalt dieses Briefes durch einige Ratsmitglieder inventarisieren zu lassen", f: "Summary"},
  {k: "llm-v1:H4:719:A1", r: "11ab3b05-5b3e-3459-9329-701513882568", act: "mandate", obj: "zugunsten Frankfurts", y: null, ev: "richtet ein Mandat (zugunsten der Stadt Frankfurt) an Eppstein.", f: "Summary"},
  {k: "llm-v1:H4:720:A1", r: "e997d644-48e4-31b6-98c9-8432ea82a5ae", act: "mandate", obj: "zollfreie Passage eines Floßes für den Krieg gegen Burgund", y: null, ev: "auf dem Rhein abgabenfrei passieren zu lassen", f: "Summary"},
  {k: "llm-v1:H4:721:A1", r: "33d03cae-afa5-3421-b56c-877a87e057bd", act: "receipt", obj: "1200 fl. rh. Kriegsbeihilfe der Frankfurter Juden", y: null, ev: "quittiert den Frankfurter Juden die Zahlung von 1200 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:722:A1", r: "e3c2af86-9687-3c95-ae41-4de397530b75", act: "summons", obj: "Mandat zugunsten Frankfurts und Ladung", y: null, ev: "lädt ihn zu rechtlicher Verantwortung.", f: "Summary"},
  {k: "llm-v1:H4:723:A1", r: "f65abe90-8f9d-3ff1-a658-12134a33588f", act: "mandate", obj: "Schutz der Regensburger Juden und ihrer Privilegien", y: null, ev: "hinfort keinerlei Beeinträchtigung der Juden mehr vorzunehmen oder zu dulden", f: "Summary"},
  {k: "llm-v1:H4:724:A1", r: "80c7d0a7-7ed7-3233-a64f-ae37f786bb06", act: "summons", obj: "Klage Frankfurts gegen die Dörfer des Bornheimer Bergs wegen verweigerter Heerfolge", y: null, ev: "lädt Zentgrafen und Gemeinden der 19 zur Grafschaft Bornheimer Berg gehörenden Dörfer", f: "Summary"},
  {k: "llm-v1:H4:725:A1", r: "d18a155e-8edc-3122-a88a-eb1640ccc9b4", act: "summons", obj: "Klage Frankfurts wegen Mißachtung des Kammergerichtsurteils", y: null, ev: "lädt Zentgrafen und Gemeinden der 19 zur GrafschaftBornheimer Berg gehörenden Dörfer", f: "Summary"},
  {k: "llm-v1:H4:726:A1", r: "af8f46d9-473e-30b4-ac4a-ff59e0daf6c5", act: "summons", obj: "Verhandlungen über Friedenswahrung in Köln (8. September 1475)", y: null, ev: "lädt Eb. (Johann) von Trier auf den 8. September zu sich nach Köln", f: "Summary"},
  {k: "llm-v1:H4:727:A1", r: "d0e174a3-5dbc-3d6d-bafb-66ef379f87e7", act: "summons", obj: "Verhandlungen in Köln", y: null, ev: "lädt die Hzz. Gerhard und Wilhelm von Jülich-Berg zu Verhandlungen nach Köln.", f: "Summary"},
  {k: "llm-v1:H4:728:A1", r: "ea4ae237-76b7-3e0f-beec-7de67170a53d", act: "summons", obj: "Verhandlungen in Köln", y: null, ev: "lädt die Stadt Lübeck u. a. Hansestädte zu Verhandlungen nach Köln.", f: "Summary"},
  {k: "llm-v1:H4:729:A1", r: "1b2d28d8-1908-3c0e-a773-5c2de63c7afb", act: "privilege_confirmation", obj: "Kauf von Dorf und Gericht Bornheim; Frankfurt oberster Vogt und Gerichtsherr", y: null, ev: "bestätigt Bürgermeistern und Rat der Stadt Frankfurt auf Ersuchen von deren Botschaft den mit seiner Genehmigung", f: "Summary"},
  {k: "llm-v1:H4:730:A1", r: "092b6494-87e7-32e7-9189-08665d81cb07", act: "enfeoffment", obj: "Dorf und Gericht Bornheim; sechs Huben zu Karben und Dortelweil", y: null, ev: "belehnt Bürgermeister und Rat der Stadt Frankfurt mit Dorf und Gericht Bornheim", f: "Summary"},
  {k: "llm-v1:H4:731:A1", r: "25f47114-9ffa-3ed3-ac81-96d5611befb7", act: "communication", obj: "Abriß eines Neubaus Friedrich Nachtrabes", y: null, ev: "schreibt an Frankfurt wegen Friedrich Nachtrabe", f: "Summary"},
  {k: "llm-v1:H4:732:A1", r: "21f1e5c6-63d0-3272-8c09-ac9f74861de0", act: "mandate", obj: "Hilfe für Hz. René von Lothringen gegen Burgund", y: null, ev: "dem Hz. Renatus von Lothringen", f: "Summary"},
  {k: "llm-v1:H4:733:A1", r: "fef5efbd-60be-3c2f-b11a-ce706f801997", act: "communication", obj: "Sache des Gipel Fuerren auf Ersuchen der Burg Friedberg", y: null, ev: "auf Ersuchen der Burgmannen der Burg Friedberg in Sachen des Gipel Fuerren", f: "Summary"},
  {k: "llm-v1:H4:734:A1", r: "2abcb8b3-f82a-39d3-9cda-0ba16bc76a74", act: "communication", obj: null, y: null, ev: "K. F. schreibt (in einer noch nicht bekannten Angelegenheit) an die Stadt Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:735:A1", r: "b1f05e95-a4c5-3c9a-91dd-8991fa539bde", act: "communication", obj: null, y: null, ev: "K. F. schreibt an die Stadt Straßburg.", f: "Summary"},
  {k: "llm-v1:H4:736:A1", r: "4e38517f-5f15-39a2-83d7-a35964be84fd", act: "communication", obj: null, y: null, ev: "K. F. schreibt an die Stadt Konstanz.", f: "Summary"},
  {k: "llm-v1:H4:737:A1", r: "bda63287-a736-3c1f-afeb-ea0633f55d6e", act: "communication", obj: null, y: null, ev: "K. F. schreibt an die Stadt Augsburg.", f: "Summary"},
  {k: "llm-v1:H4:738:A1", r: "27e161d5-ee12-313e-be0a-158c2687c1b1", act: "communication", obj: null, y: null, ev: "K. F. schreibt an die Stadt Ulm.", f: "Summary"},
  {k: "llm-v1:H4:739:A1", r: "d24a6a71-ad5c-3590-9562-037d5c89bd1a", act: "commission", obj: "Zustellung kaiserlicher Briefe", y: null, ev: "beauftragt Frankfurt mit der Zustellung etlicher ksl. Briefe.", f: "Summary"},
  {k: "llm-v1:H4:740:A1", r: "23143e73-83f8-3a84-b50f-e769e2ed140d", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1475, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:741:A1", r: "c25f3dfd-e7a5-3f34-a86f-0df682c8c779", act: "request", obj: "Geleit für Jörg Hessler", y: null, ev: "seinem Rat Jörg Hessler", f: "Summary"},
  {k: "llm-v1:H4:742:A1", r: "bc704a85-8bd5-3e75-88f5-f4da6a95fb2b", act: "mandate", obj: "Truppen gegen Burgund bei Colmar oder Schlettstadt (21. Dezember 1475)", y: null, ev: "ihre Truppen negst umbe Kolmar oder Sletstat zu haben", f: "Summary"},
  {k: "llm-v1:H4:743:A1", r: "b993b7ce-6104-3044-8678-6d0425a1ff48", act: "mandate", obj: "Truppen gegen Burgund", y: null, ev: "K. F. fordert von der Stadt Speyer Truppen gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:744:A1", r: "61dc86d8-612d-38b4-82e2-1582b601e457", act: "mandate", obj: "Truppen gegen Burgund", y: null, ev: "K. F. fordert von der Stadt Straßburg Truppen gegen Burgund.", f: "Summary"},
  {k: "llm-v1:H4:745:A1", r: "69756320-47fb-3dfa-8329-e9fb091527c5", act: "mandate", obj: "Ablieferung von Kanzleiakten an den Frankfurter Rat", y: null, ev: "alle der ksl. römischen Kanzlei zugehörenden und noch in seinem Besitz befindlichen Briefe", f: "Summary"},
  {k: "llm-v1:H4:746:A1", r: "3e7cd4ad-523b-3b91-803c-7f248956a932", act: "commission", obj: "Übernahme und Verzeichnung der Kanzleiakten von Weigand Königk", y: null, ev: "befiehlt ihnen, diese anzunehmen, eigentlich beschreiben (zu) lassen und ihm zuzuschicken", f: "Summary"},
  {k: "llm-v1:H4:747:A1", r: "13f4d68a-6488-36bf-bba3-07e4cfc1d115", act: "mandate", obj: "Einhaltung und Verkündigung des Friedens mit Burgund", y: null, ev: "diesen Frieden gegenüber den burgundischen Untertanen einzuhalten und in unser Stadt Frankfurt verkünden zu lassen", f: "Summary"},
  {k: "llm-v1:H4:748:A1", r: "b384acd7-2f0e-36e4-ac25-e23abbebba79", act: "other", obj: "Vidimus des Privilegs von 1459 zur Abwehr von Angreifern", y: null, ev: "vidimiert auf Ersuchen einer Frankfurter Ratsbotschaft", f: "Summary"},
  {k: "llm-v1:H4:749:A1", r: "6fd16f6d-b9a4-3ff7-a148-69cbb591f04b", act: "request", obj: "Begleitung Georg Heßlers im Reich und an der Kurie", y: null, ev: "seinen Rat Georg Heßler bei der Erledigung verschiedener Geschäfte im Reich und an der Kurie", f: "Summary"},
  {k: "llm-v1:H4:750:A1", r: "72f0b767-094f-38e2-8d62-0a2273bd0839", act: "request", obj: "Einwilligung zur Begleitung Heßlers durch Eberhard von Heusenstamm", y: null, ev: "bittet ihn als Dienstherrn Eberhards um seine Einwilligung und Fürsprache", f: "Summary"},
  {k: "llm-v1:H4:751:A1", r: "9559390f-7fa2-3852-846f-2b8cecfb7dc1", act: "commission", obj: "Übernahme und Übersendung hinterlegter Kanzlei- und Kammergerichtsakten", y: null, ev: "befiehlt ihnen, diese an sich zu nehmen und ihm unverzüglich bey gewisser bottschafft zuzusenden", f: "Summary"},
  {k: "llm-v1:H4:752:A1", r: "8ae06d23-b358-36fc-988a-954b070e3ef5", act: "summons", obj: "Klage Hert Weiß' wegen Fechenheim", y: null, ev: "lädt Gf. Philipp d. J. von Hanau aufgrund der Klage des Hert Weiß", f: "Summary"},
  {k: "llm-v1:H4:753:A1", r: "50b29739-0509-38eb-afb2-e336fa82f2cd", act: "privilege_grant", obj: "Errichtung von Befestigungen um Frankfurt und Sachsenhausen mit Recht auf Widerstand", y: null, ev: "Warten, Schläge, Türme, Landwehren, Gräben, Zäune (eynfeng) und andere Befestigungen vollständig zu errichten", f: "Summary"},
  {k: "llm-v1:H4:754:A1", r: "a3f0bd97-fb14-302b-bbc3-53d9ac157600", act: "privilege_grant", obj: "Regelung der städtischen Lehenträger für Bornheim, Karben und Dortelweil", y: null, ev: "ergänzt die in seinem Bürgermeistern und Rat der Stadt Frankfurt gewährten Lehenbrief", f: "Summary"},
  {k: "llm-v1:H4:755:A1", r: "504bdf86-4398-3876-b723-332b7effcd38", act: "request", obj: "Freilassung Bysmans, Diener der Herren von Weinsberg", y: null, ev: "den von ihnen wegen eines Totschlags arrestierten Bysman", f: "Summary"},
  {k: "llm-v1:H4:756:A1", r: "2f30c2fd-0317-38d6-a244-d08c4f4f65fd", act: "other", obj: "Ungültigkeit des Freistuhlverfahrens gegen Georg Zolner von Bamberg", y: null, ev: "für ungültig erklärt und den Prozeß an sich gezogen hat", f: "Summary"},
  {k: "llm-v1:H4:757:A1", r: "c8824c2d-8272-3d6c-b7cd-40335fc664e9", act: "prohibition", obj: "Hilfe für Gf. Philipp d. J. von Hanau gegen Frankfurt", y: null, ev: "jeglichem Hilfsersuchen Gf. Philipps d. J. von Hanau gegen Bürgermeister und Rat der Stadt Frankfurt nachzukommen", f: "Summary"},
  {k: "llm-v1:H4:758:A1", r: "ac8b28d5-fa27-3c6c-ac61-e551daed3b85", act: "prohibition", obj: "Hilfe für Gf. Philipp d. J. von Hanau gegen Frankfurt (Bornheim und Seckbach)", y: null, ev: "jeglichem weiteren Ersuchen Gf. Philipps d. J. von Hanau", f: "Summary"},
  {k: "llm-v1:H4:759:A1", r: "66d375d7-c028-3f65-8941-17d92940d6ef", act: "prohibition", obj: "Unterstützung Hanaus gegen Frankfurt", y: null, ev: "keinerlei Unterstützung zu gewähren", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 801–900
UNWIND [
  {k: "llm-v1:H4:760:A1", r: "d66271fd-cb42-3a17-8541-0eb458fe4a56", act: "prohibition", obj: "Hilfe für Hanau gegen Frankfurt", y: null, ev: "Hilfe für Hanau gegen Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:761:A1", r: "f7ac0011-83c8-30b1-8042-79fee0cd08e7", act: "prohibition", obj: "Hilfe für Hanau gegen Frankfurt", y: null, ev: "Hilfe für Hanau gegen Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:762:A1", r: "ef783f5b-4846-3c83-a303-2a753fa57744", act: "prohibition", obj: "Hilfe für Hanau gegen Frankfurt", y: null, ev: "Hilfe für Hanau gegen Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:763:A1", r: "0575c1ff-77d6-3096-8ed8-ad9b17c030ea", act: "prohibition", obj: "Hilfe für Hanau gegen Frankfurt", y: null, ev: "K. F. verbietet allen Reichsangehörigen Hilfe für Hanau gegen Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:764:A1", r: "103654f7-c810-31c3-8e10-ddf3a2512b3f", act: "other", obj: "Ungültigkeit der Freistuhlsentenzen gegen Bamberg; Schutz der Stadt", y: null, ev: "erklärt ausdrücklich alle bisherigen und künftigen Urteile für ungültig", f: "Summary"},
  {k: "llm-v1:H4:765:A1", r: "8af04c7c-593d-310d-af10-3df1572e9cfa", act: "summons", obj: "Appellation Bambergs gegen das Freistuhlverfahren", y: null, ev: "lädt die Ldgff. von Hessen und die Gff. von Waldeck sowie Contz Zechendorfer", f: "Summary"},
  {k: "llm-v1:H4:766:A1", r: "78f66a2e-01ff-3365-9677-76991a2cca2a", act: "privilege_grant", obj: "Schutz von Kaiser und Reich für die Stadt Bamberg", y: null, ev: "nimmt die Stadt Bamberg aufgrund ihrer Appellation", f: "Summary"},
  {k: "llm-v1:H4:767:A1", r: "99f9fb9d-2a91-3b86-88d5-5622155c4984", act: "privilege_confirmation", obj: "Ordnung des Hubgerichts im Dorf Hausen", y: null, ev: "auf deren Ersuchen hin die Ordnung des Gerichts", f: "Summary"},
  {k: "llm-v1:H4:768:A1", r: "c54f5f8a-49b7-3aa6-9085-4a9a20092414", act: "other", obj: "Kammergerichtsurteil: Dörfer des Bornheimer Bergs den Strafen verfallen", y: null, ev: "den in diesen Mandaten angedrohten Strafen für verfallen erklärt werden", f: "Summary"},
  {k: "llm-v1:H4:769:A1", r: "bdb3a314-7593-387c-81f2-4562f4618144", act: "other", obj: "Kammergerichtsurteil gegen Gf. Philipp d. J. von Hanau", y: null, ev: "beurkundet das auf Klage seines Rats und Kammerprokurator-Fiskals Johann Kellner gegen Gf. Philipp d. J. von Hanau ergangene Urteil", f: "Summary"},
  {k: "llm-v1:H4:770:A1", r: "41c61b92-d261-307c-a32c-4e454b16b2b4", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1476, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:771:A1", r: "a017354d-b609-3f4a-8118-471cb8d301c4", act: "mandate", obj: "Zahlung der Stadtsteuern 1476 und 1477 an den Rat von Nürnberg", y: null, ev: "bis zum heiligen dreier kunig tag (1477 Januar 6) an den Rat der Stadt Nürnberg zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:772:A1", r: "6a7b7c2e-2f57-3b41-9274-d4cc685decec", act: "mandate", obj: "Rüstung zur Sicherung der burgundischen Reichslehen", y: null, ev: "unverzüglich nach bestem Vermögen zu rüsten", f: "Summary"},
  {k: "llm-v1:H4:773:A1", r: "59fdf80e-783d-39dd-b284-c3fe0cf0b5ee", act: "mandate", obj: "Herausgabe von Briefen zur Kölner Stiftsgeistlichkeit an Georg Heßler", y: null, ev: "seinem Protonotar und Rat Georg Heßler", f: "Summary"},
  {k: "llm-v1:H4:774:A1", r: "237c97e6-68d1-35fe-b599-2e9f844b107b", act: "request", obj: "Darlehen von 1500 fl. rh. an Georg Heßler gegen Verrechnung mit dem Mainzer Zoll", y: null, ev: "gegen dessen bekenntnuss auf Erfordern 1500 fl. rh. zu leihen", f: "Summary"},
  {k: "llm-v1:H4:775:A1", r: "bd6ce60c-e830-32e7-966a-b28c6dcd30a6", act: "summons", obj: "Verschiebung des Prozesses Frankfurt – Bornheimer Berg (25. Juli 1477)", y: null, ev: "verschiebt merglicher geschefft halben die Fortführung des am Kammergericht anhängigen Prozesses", f: "Summary"},
  {k: "llm-v1:H4:776:A1", r: "9782bb96-42ce-388f-813e-164b12f1208b", act: "privilege_grant", obj: "Blutbann in den Dörfern des Bornheimer Bergs während des Verfahrens", y: null, ev: "gewährt dem Rat der Stadt Frankfurt das Recht", f: "Summary"},
  {k: "llm-v1:H4:777:A1", r: "9c5a1130-751b-3f12-b21c-0957cf57a4bc", act: "prohibition", obj: "Prozeß des Hofgerichts Rottweil gegen Frankfurt", y: null, ev: "verbietet dem Hofgericht zu Rottweil, gegen die Stadt Frankfurt zu prozessieren.", f: "Summary"},
  {k: "llm-v1:H4:778:A1", r: "c2105b7a-7084-3d36-bd9b-5548eab739b1", act: "summons", obj: "Sammlung in Frankfurt zum Zug mit Hz. Maximilian nach Burgund", y: null, ev: "bescheidet etliche Fürsten, Prälaten, Gff. Herren und Städte auf den achten Tag nach Pfingsten", f: "Summary"},
  {k: "llm-v1:H4:779:A1", r: "f3e0518a-f0f6-3876-a39d-a5f75c03baa3", act: "commission", obj: "Zeugenverhör für das Manngericht Philipps von Eppstein-Königstein", y: null, ev: "befiehlt und bevollmächtigt Bürgermeister und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:780:A1", r: "2bb06904-fb6a-33ca-8a27-ee6691fd80fc", act: "commission", obj: "Empfang der in Frankfurt Versammelten bis zur Ankunft Maximilians", y: null, ev: "sich unverzüglich nach Frankfurt zu begeben", f: "Summary"},
  {k: "llm-v1:H4:781:A1", r: "b8b4e76f-9524-3351-9c22-7f0c7cd26ed6", act: "other", obj: "Kammergerichtsurteil gegen das Mainzer Domkapitel wegen des aufgehaltenen Floßes", y: null, ev: "verkündet das auf Klage seines Kammerprokurator-Fiskals gegen Dekan und Kapitel des Mainzer Domstifts gefällte Kammergerichtsurteil", f: "Summary"},
  {k: "llm-v1:H4:782:A1", r: "f386ec04-75db-3270-a13d-b002e5168828", act: "mandate", obj: "Vollzug des Kammergerichtsurteils binnen sechs Wochen und drei Tagen", y: null, ev: "innerhalb von sechs Wochen und drei Tagen", f: "Summary"},
  {k: "llm-v1:H4:782:A2", r: "f386ec04-75db-3270-a13d-b002e5168828", act: "summons", obj: "Antrag des Fiskals auf Anleite", y: null, ev: "lädt er sie auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:783:A1", r: "fa50869f-5ffd-306e-a233-a7177c6b4af0", act: "commission", obj: "Insinuation des Exekutorialbriefs an das Mainzer Domkapitel", y: null, ev: "beauftragt Schultheiß und Schöffen zu Frankfurt mit der Insinuation", f: "Summary"},
  {k: "llm-v1:H4:784:A1", r: "f0a49ada-f65e-3ad1-977f-defa48c3d8f1", act: "summons", obj: "Verschiebung des Prozesses Frankfurt – Bornheimer Berg (nach Weihnachten 1477)", y: null, ev: "auf den nächsten Gerichtstag nach den heiligen wyennechten", f: "Summary"},
  {k: "llm-v1:H4:785:A1", r: "c1b208ff-d661-35aa-a388-13685a2edc38", act: "credential", obj: "mündliche Botschaft", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Kämmerer Sigmund von Niedertor und seinen Diener Dr. Hans Heinrich Vogt", f: "Summary"},
  {k: "llm-v1:H4:786:A1", r: "e939d0b7-00e0-309f-a2b8-c2c9e31ef0e3", act: "mandate", obj: "Schuldbegleichung Hans Maselharts gegenüber Johann Rauch", y: null, ev: "ihren Mitbürger Hans Maselhart gütlich anzuhalten", f: "Summary"},
  {k: "llm-v1:H4:787:A1", r: "6ebfc58a-6a2b-3a47-8f4a-a20a75987e4e", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1477, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:788:A1", r: "604cd803-586d-30e3-aa15-c53a230c93ec", act: "prohibition", obj: "Verbot des Besuchs der Nördlinger Messe durch Nürnberg", y: null, ev: "untersagt Bürgermeistern und Rat der Stadt Nürnberg, ihren Kaufleuten den Besuch der Nördlinger Messe zu verbieten.", f: "Summary"},
  {k: "llm-v1:H4:789:A1", r: "59dfd410-6ab7-3d11-b48a-4246ba153331", act: "request", obj: "Unterstützung Friedrich Mayrs beim Transport zu Maximilian", y: null, ev: "bittet Bürgermeister und Rat der Stadt Frankfurt um Unterstützung seines Dieners Friedrich Mayr", f: "Summary"},
  {k: "llm-v1:H4:790:A1", r: "0bc2cbe0-ff7e-38ac-b80f-0355eca382a5", act: "mandate", obj: "Rüstung gegen Kg. Ludwig XI. von Frankreich", y: null, ev: "unverzüglich nach dem Erhalt dieses Schreibens nach ganzem Vermögen zum Feldzug zu rüsten", f: "Summary"},
  {k: "llm-v1:H4:791:A1", r: "882efc2c-4b01-36f2-8ce1-7fa84f792161", act: "communication", obj: "Auseinandersetzung mit Hans Maselhart", y: null, ev: "schreibt an seinen Kaplan Johann Rauch (Ruwe)", f: "Summary"},
  {k: "llm-v1:H4:792:A1", r: "e3d0d96a-cd90-317a-8d25-437e3b841912", act: "mandate", obj: "Rückgabe Cambrais und Freilassung des Bischofs von Verdun", y: null, ev: "ermahnt ihn, all dies abzustellen", f: "Summary"},
  {k: "llm-v1:H4:793:A1", r: "b4ec4d39-67e6-3d2f-90e3-3184a0c0c7d8", act: "credential", obj: "mündliche Botschaft", y: null, ev: "beglaubigt den Kardinal (Georg Heßler), dessen Bruder Hans und den Fiskalprokurator Meister Hans Keller", f: "Summary"},
  {k: "llm-v1:H4:794:A1", r: "7af451c5-ca29-3fcf-8d68-9e9c7f102742", act: "credential", obj: "mündliche Botschaft", y: null, ev: "beglaubigt Meister Jobst Kappus von Hagenau", f: "Summary"},
  {k: "llm-v1:H4:795:A1", r: "b1d5e3ef-5ef9-3e99-a9d3-ecb63785296d", act: "credential", obj: "mündliche Botschaft", y: null, ev: "beglaubigt Dr. Hans Heinrich Vogt von Sumerau", f: "Summary"},
  {k: "llm-v1:H4:796:A1", r: "8b6c15aa-9f1b-3e1a-83d9-45de8e6df087", act: "request", obj: "Darlehen an Ehz. Maximilian für den Krieg gegen Frankreich", y: null, ev: "diesem Geld, Geschütze, Pulver und anderes", f: "Summary"},
  {k: "llm-v1:H4:797:A1", r: "b4b3fc9c-d6c9-3840-aad2-0c35b15205ba", act: "summons", obj: "Klage Frankfurts gegen das Verfahren am Freistuhl zu Landau", y: null, ev: "lädt Gf. Otto von Waldeck aufgrund der Klage von Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:798:A1", r: "fdd456dd-0d2f-328e-8f6f-cdffbcdd7601", act: "prohibition", obj: "Prozeß am Freistuhl zu Landau gegen Frankfurt", y: null, ev: "den Prozeß einzustellen und so lange nichts gegen die Frankfurter zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:799:A1", r: "b420d168-0d69-3808-8372-d9af8675adcd", act: "mandate", obj: "Schutz Frankfurts gegen westfälische Gerichte bei Pön von 100 Mark Gold", y: null, ev: "jegliche Beeinträchtigung der Frankfurter und ihrer Güter in ihren Ländern und Gebieten zu unterbinden", f: "Summary"},
  {k: "llm-v1:H4:800:A1", r: "04d046bc-fcd0-3607-b73a-bdcc76359a5a", act: "request", obj: "nächste geistliche Pfründe für den Sohn Peter Pekhers (Erste Bitte)", y: null, ev: "dem Sohn ihres Mitbürgers Peter Pekher die nächste verfügbare geistliche Pfründe zu verleihen", f: "Summary"},
  {k: "llm-v1:H4:801:A1", r: "f839f8e8-5548-3b52-b72d-40cbbd80b5fd", act: "request", obj: "nächste freie Pfründe für den Sohn Peter Pekhers (Erste Bitte)", y: null, ev: "die nächste freiwerdende gotzgab ewrer lehennschafft", f: "Summary"},
  {k: "llm-v1:H4:802:A1", r: "12ddee99-3a4c-34b6-8bdd-54630a12e33a", act: "request", obj: "Recht für Conrad Has gegen Jan von Möringen wegen falschen Tuchs", y: null, ev: "seinem Bürger Conrad Has zu Laibach", f: "Summary"},
  {k: "llm-v1:H4:803:A1", r: "3c306a0d-8b9f-35e3-a0b7-f1d60e29f444", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1478, ev: "K. F. quittiert Bürgermeistern, Rat und Bürgern der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:804:A1", r: "73d66a6a-344a-3520-9f9a-15107723c9e6", act: "communication", obj: null, y: null, ev: "K. F. schreibt an Gottfried von Eppstein-Münzenberg.", f: "Summary"},
  {k: "llm-v1:H4:805:A1", r: "3a524e0e-f76f-311b-bedd-000139b0e194", act: "summons", obj: "Türkentag zu Freising", y: null, ev: "den der Türken wegen angesetzten Tag in Freising zu besuchen.", f: "Summary"},
  {k: "llm-v1:H4:806:A1", r: "6d895859-411b-366c-b4a3-f30b7daaad3d", act: "mandate", obj: "Gehorsamsaufkündigung gegenüber Eb. Bernhard von Salzburg", y: null, ev: "diesem nicht länger zu gehorchen", f: "Summary"},
  {k: "llm-v1:H4:807:A1", r: "e479ce27-6293-30e3-a585-fc2434762ab3", act: "summons", obj: "Türkentag zu Freising", y: null, ev: "lädt die Hzz. von Bayern und andere (noch nicht bekannte) Reichsangehörige zu einem Tag nach Freising", f: "Summary"},
  {k: "llm-v1:H4:808:A1", r: "4d86265d-fc9a-38fe-836f-fe195e2173f2", act: "summons", obj: "Türkentag zu Nürnberg (7. Juni 1479)", y: null, ev: "ihre bevollmächtigte Gesandtschaft auf den montag nach dem sonntag Trinitatis", f: "Summary"},
  {k: "llm-v1:H4:809:A1", r: "d4628323-c92a-39c2-8df3-95788d83d828", act: "summons", obj: "Türkentag zu Nürnberg (7. Juni 1479)", y: null, ev: "zu einem der Türken wegen auf den 7. Juni nach Nürnberg anberaumten Tag.", f: "Summary"},
  {k: "llm-v1:H4:810:A1", r: "38e78faf-8cb5-394a-a938-a89721da9c1a", act: "commission", obj: "Entscheidung im Streit Speyer gegen Margarete Steinhuserin", y: null, ev: "erteilt Bürgermeistern und Rat der Stadt Frankfurt den kommissarischen Auftrag", f: "Summary"},
  {k: "llm-v1:H4:811:A1", r: "7a3fdb42-f875-33e9-92c1-aa027a97624f", act: "communication", obj: "Ankunft der kaiserlichen Botschaft in Nürnberg", y: null, ev: "ersucht sie, ohne Verdruß bis zu deren Ankunft in Nürnberg zu warten", f: "Summary"},
  {k: "llm-v1:H4:811a:A1", r: "1b5b9924-37ee-3cc5-8486-262ffe85442a", act: "mandate", obj: "kein Gehorsam gegenüber Diether von Isenburg in Erfurt", y: null, ev: "Diethers Neuerungen und Ersuchen keynerley volg, adherentz noch gehorsam zu leisten", f: "Summary"},
  {k: "llm-v1:H4:812:A1", r: "686f6997-bac3-3800-ba51-105a308ff77a", act: "privilege_confirmation", obj: "Freiheit Biberachs von auswärtigen Gerichten", y: null, ev: "bestätigt Bürgermeistern, Rat und Gemeinde der Stadt Biberach", f: "Summary"},
  {k: "llm-v1:H4:813:A1", r: "2881999d-d043-3b61-9c83-cc80f626c3d1", act: "mandate", obj: "Beachtung der Biberacher Gerichtsfreiheit", y: null, ev: "die Beachtung der Freiheit von Bürgermeistern, Rat und ganzer Gemeinde der Stadt Biberach", f: "Summary"},
  {k: "llm-v1:H4:814:A1", r: "3c8859cf-0a76-392e-bec4-7093b0a5adba", act: "privilege_grant", obj: "Erklärung und Satzung zur Gerichtsfreiheit Biberachs", y: null, ev: "erläßt in Ansehung der trotz seiner inhibicion und gebott", f: "Summary"},
  {k: "llm-v1:H4:815:A1", r: "c3bbeda0-e648-3086-9bad-35b937c9185d", act: "credential", obj: "Werbung Gf. Haugs von Werdenberg", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Rat Gf. Haug von Werdenberg", f: "Summary"},
  {k: "llm-v1:H4:816:A1", r: "b619d51d-c9dd-398c-9910-7251eadcbe47", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1479, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:816a:A1", r: "05f4a8b2-e3b3-3615-816f-34a5cd9096e8", act: "commission", obj: "Übernahme der hohen und niederen Gerichtsbarkeit in Erfurt", y: null, ev: "die Gerichtsbarkeit an sich zu nehmen und auszuüben", f: "Summary"},
  {k: "llm-v1:H4:817:A1", r: "e067ba16-a68b-311c-a645-db4a675dcb54", act: "mandate", obj: "Truppen gegen Kg. Matthias von Ungarn nach Linz (21. Mai 1480)", y: null, ev: "ihre Truppen nach bestem Vermögen zu rüsten und bis Pfingsten (Mai 21) nach Linz zu schicken", f: "Summary"},
  {k: "llm-v1:H4:816b:A1", r: "d956012a-74fa-349b-8c5c-d5a0d73b4d23", act: "mandate", obj: "Schutz Erfurts gegen Diether von Isenburg", y: null, ev: "die Erfurter gegen jeden Angreifer und seine offenen wie stillen Helfer zu schützen", f: "Summary"},
  {k: "llm-v1:H4:817a:A1", r: "172d4c04-f49f-3652-b115-d230770af329", act: "privilege_grant", obj: "Ausübung der Gerichtsbarkeit in Erfurt bis zur Belehnung eines Erzbischofs von Mainz", y: null, ev: "erläßt nunmehr eine ordenung und saczung", f: "Summary"},
  {k: "llm-v1:H4:818:A1", r: "d8b7b466-4b69-3ecb-8f35-261664a9d5a0", act: "summons", obj: "Tag zu Nürnberg (25. Juli 1480) gegen Türken und Ungarn", y: null, ev: "ihre volmechtig annweld und underthanen zum erwähnten Termin in Nürnberg zu haben", f: "Summary"},
  {k: "llm-v1:H4:819:A1", r: "897faef7-04c5-3754-8ccf-6ec8c1fc2534", act: "other", obj: "Aufhebung westfälischer Sentenzen gegen Boppard", y: null, ev: "hebt der K. zum Schutz der Bopparder", f: "Summary"},
  {k: "llm-v1:H4:820:A1", r: "3115a0aa-80d0-3960-b80a-cdb9d7cefb56", act: "prohibition", obj: "weiteres Vorgehen westfälischer Gerichte gegen Frankfurt und Claus Scheit", y: null, ev: "nichts mehr zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:821:A1", r: "dba29f9f-df71-3945-9fef-d252ffaafc77", act: "summons", obj: "Klage Frankfurts und Schadenersatzantrag gegen Schererhenne", y: null, ev: "Er lädt ihn deshalb auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:822:A1", r: "3a3a75fb-9f68-3895-a387-8e22719e8c53", act: "mandate", obj: "Auszahlung von 2000 fl. aus dem Depot der elsässischen Reichsstädte an Jörg Kronenberger", y: null, ev: "2000 fl. an seinen Wiener Sachwalter Jörg Kronenberger", f: "Summary"},
  {k: "llm-v1:H4:823:A1", r: "4f6195f5-b77b-39a6-81c9-295039383e87", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1480, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:824:A1", r: "5a84a217-bf0d-32ce-a69e-7d02a400927f", act: "prohibition", obj: "Verfahren des Rottweiler Hofgerichts gegen Frankfurter Ewiggelder und Leibgedinge", y: null, ev: "suspendiert er alle in derlei Angelegenheiten gegen die Stadt ergangenen oder noch ergehenden Sentenzen", f: "Summary"},
  {k: "llm-v1:H4:825:A1", r: "febdc0f4-f563-377a-b5fb-67c98a58fb2b", act: "privilege_grant", obj: "Blutbann in den Dörfern des Bornheimer Bergs während des Prozesses", y: null, ev: "die Ausübung des Blutbanns über alle dort verübten Verbrechen", f: "Summary"},
  {k: "llm-v1:H4:826:A1", r: "084a8784-799e-373a-a38a-4d66fb9f15fa", act: "appointment", obj: "Hofgerichtsprokurator-Fiskal zu Rottweil", y: null, ev: "den Heinrich Roner zum Hofgerichtsprokurator-Fiskal", f: "Summary"},
  {k: "llm-v1:H4:827:A1", r: "eda44882-e30a-3e27-862f-9bf139d6ad2f", act: "privilege_grant", obj: "jährlicher Jahrmarkt", y: null, ev: "gestattet der Stadt Grünberg die Abhaltung eines jährlichen Jahrmarkts.", f: "Summary"},
  {k: "llm-v1:H4:828:A1", r: "a7f39398-7e1b-3348-bdf2-6923fd67f231", act: "commission", obj: "Streit um den Salmenfang im Rhein", y: null, ev: "erteilt Bürgermeistern und Rat der Stadt Frankfurt eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:829:A1", r: "fa2e52c2-2418-3645-b367-59512073d0c4", act: "commission", obj: "Appellation Wirichs von Daun-Falkenstein", y: null, ev: "eine Kommission zur Entscheidung der Appellation Wirichs von Daun-Falkenstein", f: "Summary"},
  {k: "llm-v1:H4:830:A1", r: "83c8400d-752d-3edf-b829-c2a9a1699cfe", act: "other", obj: "Anweisung von 200 fl. aus dem kaiserlichen Anteil am Mainzer Zoll", y: null, ev: "weist Gf. Haug von Werdenberg 200 fl. aus dem ksl. Anteil am Mainzer Zoll an.", f: "Summary"},
  {k: "llm-v1:H4:831:A1", r: "98c123bd-197e-3701-b4ff-6e4e4b3246c7", act: "mandate", obj: "Zahlung von 200 fl. aus dem Mainzer Zoll an Gf. Haug von Werdenberg", y: null, ev: "aus dem ksl. Anteil am Mainzer Zoll 200 fl. an Gf. Haug von Werdenberg zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:832:A1", r: "db7e5234-a90d-3910-81e3-3084d97caba2", act: "enfeoffment", obj: "Regalien des Bistums Passau", y: null, ev: "verleiht dem Kardinal und Bf. von Passau Georg Heßler die Regalien.", f: "Summary"},
  {k: "llm-v1:H4:833:A1", r: "8d360e98-b828-324a-a903-8d33550ebc9d", act: "enfeoffment", obj: "halber Zehnt zu Wolfskehlen", y: null, ev: "belehnt Jakob vom Steinhaus mit dem halben Zehnten zu Wolfskehlen", f: "Summary"},
  {k: "llm-v1:H4:834:A1", r: "9db59703-5f77-36c1-967e-05ca916801fa", act: "commission", obj: "Entgegennahme des Lehnseids Jakobs vom Steinhaus", y: null, ev: "von Jakob an seiner Statt innerhalb des im Lehenbrief bestimmten Zeitraums den gewöhnlichen Lehnseid zu empfangen", f: "Summary"},
  {k: "llm-v1:H4:835:A1", r: "28416ba1-878e-3252-9be2-766339d8f8d1", act: "mandate", obj: "Abstellung von Mißständen am Mainzer Zoll", y: null, ev: "alle dortigen Amtsträger vorzuladen und die Mißstände abzustellen", f: "Summary"},
  {k: "llm-v1:H4:836:A1", r: "4d297888-0604-399d-a751-b0bc815bb4bb", act: "commission", obj: "Eintreibung des Anschlags des Nürnberger Tags 1480", y: null, ev: "beauftragt Gf. Haug von Werdenberg", f: "Summary"},
  {k: "llm-v1:H4:837:A1", r: "51a316be-9df5-37a1-8a7b-a5f0ab8c16a1", act: "prohibition", obj: "Leibbede und Besthaupt von zugezogenen Leuten; geistliches Gericht", y: null, ev: "nicht länger leipbete und beste heupter zu verlangen", f: "Summary"},
  {k: "llm-v1:H4:838:A1", r: "b9921ac6-022c-30c0-80f7-6aea5a6ff38f", act: "mandate", obj: "Einschreiten gegen den Kustos Heinrich Schulteti", y: null, ev: "dafür zu sorgen, daß ihr custor und Kanonikus Heinrich Schulteti", f: "Summary"},
  {k: "llm-v1:H4:839:A1", r: "164530c3-9f69-3e39-bc16-6b17355e66b7", act: "request", obj: "Bestellung und Versand von 100 Zentnern Salpeter nach Wien", y: null, ev: "für ihn 100 Zentner geleuttert Salpeter zu bestellen", f: "Summary"},
  {k: "llm-v1:H4:840:A1", r: "c5d5d20d-7d44-35ca-b5ac-015cd5dbf9dd", act: "other", obj: "Verweisung einer Geldschuld von 665 fl. rh. an Frankfurt", y: null, ev: "verweist den Regensburger Bürger Thomas Ammann für eine Geldschuld von 665 fl. rh. an die Stadt Frankfurt.", f: "Summary"},
  {k: "llm-v1:H4:841:A1", r: "dc452e51-dc22-3bc2-a70d-8ba24be75da4", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1481, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:842:A1", r: "442adc02-da4c-3c4e-b489-4b82fddc1666", act: "summons", obj: "Klage des Fiskals wegen nicht geleisteter Hilfe gegen Ungarn", y: null, ev: "lädt Bürgermeister und Rat der Stadt Frankfurt auf den 45. Tag", f: "Summary"},
  {k: "llm-v1:H4:843:A1", r: "53152718-9cfb-30dd-9e70-e7bd127b692c", act: "summons", obj: "wie n. 842", y: null, ev: "K. F. desgleichen an die Stadt Mühlhausen i. Thür.", f: "Summary"},
  {k: "llm-v1:H4:844:A1", r: "07b79059-74b7-392e-86f2-75a17019f4db", act: "prohibition", obj: "Ladungen und Achtsprüche des Landgerichts Weißenhorn gegen Biberach", y: null, ev: "diese und die Ihren nicht länger unter Mißachtung ihrer Privilegien", f: "Summary"},
  {k: "llm-v1:H4:845:A1", r: "689a985e-9ab6-3d6d-a989-c08a1dfcdae8", act: "mandate", obj: "keine Unterstützung für Kläger gegen Biberach am Landgericht Weißenhorn", y: null, ev: "die Freiheiten der Biberacher einzuhalten und sie auf Ersuchen von K. und Reichs wegen zu schützen", f: "Summary"},
  {k: "llm-v1:H4:846:A1", r: "f16fd25a-baf2-318d-93d1-f6ccf056c2b9", act: "summons", obj: "Klage des Fiskals wegen nicht geleisteter Hilfe gegen Ungarn", y: null, ev: "lädt Bürgermeister und Rat der Stadt Lübeck auf den 63. Tag", f: "Summary"},
  {k: "llm-v1:H4:847:A1", r: "4686d697-58c2-388e-b92b-52d4e5bf0877", act: "mandate", obj: "Zahlung der rückständigen Stadtsteuern zweier Jahre", y: null, ev: "ihre verfallenen Stadtsteuern der vergangenen zwei Jahre einem ksl. Diener[2] gegen Übergabe seiner ksl. Quittung zu entrichten", f: "Summary"},
  {k: "llm-v1:H4:848:A1", r: "f248fbdc-ecba-3808-a54a-60a87a01fb7d", act: "commission", obj: "Einzug der elsässischen Stadtsteuern und Hinterlegung in Frankfurt oder Nürnberg", y: null, ev: "das Geld von allen betroffenen Städten gegen Aushändigung der Quittungen einzubringen", f: "Summary"},
  {k: "llm-v1:H4:849:A1", r: "4c33b61f-3c92-318e-ac95-48ae80e43df0", act: "receipt", obj: "rückständige Stadtsteuern zweier Jahre", y: null, ev: "quittiert Hagenau und den anderen zur Landvogtei Elsass gehörenden Reichsstädten", f: "Summary"},
  {k: "llm-v1:H4:850:A1", r: "faaf352a-03ef-31e9-8a86-253b3c5a9db7", act: "summons", obj: "Klage des Fiskals wegen nicht geleisteter Hilfe gegen Ungarn", y: null, ev: "lädt den Bf. von Lübeck[1] auf den 63. Tag", f: "Summary"},
  {k: "llm-v1:H4:851:A1", r: "5586facc-6810-394c-b2fe-0957f77978b8", act: "mandate", obj: "Zahlung von 1648 fl. rh. an Sigmund Prueschenk aus Stadtsteuer und Mainzer Zoll", y: null, ev: "seinen Kämmerer Sigmund Prueschenk oder dessen Beauftragtem", f: "Summary"},
  {k: "llm-v1:H4:852:A1", r: "bcaf507c-64a4-3559-bb5b-a7742a318fcc", act: "receipt", obj: "1648 fl. aus Stadtsteuer und Mainzer Zoll an Sigmund Prueschenk", y: null, ev: "K. F. quittiert Frankfurt 1648 fl.", f: "Summary"},
  {k: "llm-v1:H4:853:A1", r: "1ca5c9f2-7db8-332f-8f84-a9f8e545abb5", act: "other", obj: "Kammergerichtsurteil gegen Friedberg wegen Nichterfüllung des Nürnberger Anschlags", y: null, ev: "vom Kammergericht gefällte Urteil gegen Bürgermeister und Rat der Stadt Friedberg", f: "Summary"},
  {k: "llm-v1:H4:854:A1", r: "a06e01ae-b39a-38b8-acbc-aedeb20be630", act: "mandate", obj: "Zahlung der Pön von 1000 Mark Gold binnen 63 Tagen", y: null, ev: "die Pön innerhalb von 63 Tagen nach Erhalt dieses Briefs zu entrichten", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 901–1000
UNWIND [
  {k: "llm-v1:H4:854:A2", r: "a06e01ae-b39a-38b8-acbc-aedeb20be630", act: "summons", obj: "Antrag des Fiskals auf Acht", y: null, ev: "lädt sie für den Fall ihres Ungehorsams auf den 63. Tag", f: "Summary"},
  {k: "llm-v1:H4:855:A1", r: "01a88049-c6c3-311c-b94e-1921a042a2f4", act: "prohibition", obj: "Ausübung von Gerichtsbarkeit, Zollrechten und Freiheiten durch Friedberg", y: null, ev: "sich des Rechts auf die hohe und niedere Gerichtsbarkeit sowie ihrer Zollrechte und aller anderen Rechte und Freiheiten nicht länger zu bedienen", f: "Summary"},
  {k: "llm-v1:H4:856:A1", r: "f927a60c-3d1e-3341-a694-ddedbc9cf6ed", act: "other", obj: "Aufhebung aller Fluß- und Landzölle in den Erblanden", y: null, ev: "stellt alle Fluß- und Landzölle in seinen vom Krieg mit Kg. Matthias von Ungarn betroffenen Erblanden ab.", f: "Summary"},
  {k: "llm-v1:H4:857:A1", r: "3e08d7ee-f506-329c-bb3c-c4b75fe42988", act: "mandate", obj: "Einsetzung Hartmann Windeckes anstelle Matern Folckers am Mainzer Zoll", y: null, ev: "Hartmann Windecke[1] anstelle des Matern Folcker in das Mainzer Zollamt einzusetzen.", f: "Summary"},
  {k: "llm-v1:H4:858:A1", r: "52ed75d9-d18f-342c-ab1f-bb74a60f3a9c", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1482, ev: "K. F. quittiert Bürgermeistern, Rat und Gemeinde der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:859:A1", r: "e1741f0b-ad89-3085-b719-fc1417441087", act: "mandate", obj: "Zahlung von 257 fl. rh. aus der Stadtsteuer an Gf. Friedrich von Zollern", y: null, ev: "seinem Rat Gf. Friedrich von Zollern, Domherrn zu Straßburg, oder dessen Anwalt 257 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:860:A1", r: "ffc429fc-7480-341b-83ab-c45bcd0da35c", act: "receipt", obj: "257 fl. rh. Stadtsteuer", y: null, ev: "K. F. quittiert Frankfurt die Bezahlung von 257 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:861:A1", r: "4d478fa2-8ecf-38bc-80bf-f4147fa3f80d", act: "privilege_confirmation", obj: "warme Quelle zu Soden (Urkunde K. Sigmunds)", y: null, ev: "bestätigt Bürgermeistern und Rat der Stadt Frankfurt die Verleihungsurkunde K. Sigmunds", f: "Summary"},
  {k: "llm-v1:H4:861:A2", r: "4d478fa2-8ecf-38bc-80bf-f4147fa3f80d", act: "privilege_grant", obj: "Suche nach Salzquellen und Salzsieden in Soden", y: null, ev: "im Dorf Soden sowie seinen Zugehörungen nach weiteren Quellen und Adern warmen und kalten, salzhaltigen und salzlosen Wassers suchen", f: "Summary"},
  {k: "llm-v1:H4:862:A1", r: "abdea731-f539-39c8-b5ea-d20a640bda24", act: "privilege_grant", obj: "ewiges Fischereirecht im Main bis in den Rhein", y: null, ev: "gewährt Bürgermeistern und Rat der Stadt Frankfurt die Freiheit", f: "Summary"},
  {k: "llm-v1:H4:863:A1", r: "7b1aad5d-3cbf-37ae-b8a9-9a879237766f", act: "request", obj: "Verlängerung des Dienstes der Frankfurter Söldner um acht Tage", y: null, ev: "noch acht Tage über die im Nürnberger Anschlag festgesetzte Zeit", f: "Summary"},
  {k: "llm-v1:H4:864:A1", r: "ae8f3f02-c131-31ca-b5db-cdceab753699", act: "receipt", obj: "geleistete Hilfe gegen Ungarn; Niederschlagung des Fiskalprozesses", y: null, ev: "sagt sie dieser Forderung quitt und schlägt den mit der auf Klage seines Kammerprokurator-Fiskals ergangenen Ladung", f: "Summary"},
  {k: "llm-v1:H4:865:A1", r: "c6658b95-20bb-36a3-bfba-a50e7404f7fa", act: "mandate", obj: "Förderung des kaiserlichen Dieners Hans Filßhover", y: null, ev: "dem ksl. Diener Hans Filßhover jegliche Förderung zuteil werden zu lassen", f: "Summary"},
  {k: "llm-v1:H4:866:A1", r: "cb468a66-94bb-3107-ac37-7a301fc6a0df", act: "mandate", obj: "Nichtbeachtung der Sentenzen des Angelus gegen Basel; keine Auslieferung des Eb. von Crayn", y: null, ev: "die von Angelus gegen Basel erlassenen Sentenzen so lange nicht zu beachten", f: "Summary"},
  {k: "llm-v1:H4:867:A1", r: "08d2f297-b76e-31b3-8915-8b8b723cb8f4", act: "receipt", obj: "Stadtsteuer (928 fl. rh.)", y: 1483, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:868:A1", r: "2bff37c4-2ca3-38b1-adb7-f1046f6099af", act: "commission", obj: "Prozeß Falckenberg gegen Düling", y: null, ev: "ernennt im Prozeß zwischen Anthis Falckenberg und Werner Düling ksl. Kommissare.", f: "Summary"},
  {k: "llm-v1:H4:869:A1", r: "e9b5ce99-ca03-34d9-b523-ae81e31b0381", act: "other", obj: "Aufhebung des Arrests über Werner Dülings Güter", y: null, ev: "hebt den im Prozeß zwischen Werner Düling und Anthis Falckenberg über Werners Güter und Habe verhängten Arrest auf.", f: "Summary"},
  {k: "llm-v1:H4:870:A1", r: "12872e8d-9a4e-37f8-aa4d-23f9e5631e97", act: "mandate", obj: "Beschlagnahme der Habe Werner Dülings", y: null, ev: "solange mit Beschlag zu belegen", f: "Summary"},
  {k: "llm-v1:H4:871:A1", r: "c798707d-32db-354e-9076-d05963029a00", act: "summons", obj: "Appellation Heinrichs von Ortenberg gegen das Rottweiler Verfahren", y: null, ev: "lädt die Stadt Rüdesheim aufgrund der Appellation Heinrichs von Ortenberg", f: "Summary"},
  {k: "llm-v1:H4:872:A1", r: "cfba3595-dfb9-3c60-a9d0-e4fc780df40d", act: "other", obj: "Kammergerichtsurteil: Hofgericht Rottweil unzuständig", y: null, ev: "das Hofgericht Rottweil für nicht zuständig und die dortige Prozeßführung für nichtig erklärt wird", f: "Summary"},
  {k: "llm-v1:H4:873:A1", r: "3cc6a546-a31d-348f-87fd-754edc5de218", act: "commission", obj: "Entscheidung der Appellationssache Ortenberg gegen Rüdesheim", y: null, ev: "die Richter des Hofgerichts zu Rottweil zu Kommissaren", f: "Summary"},
  {k: "llm-v1:H4:874:A1", r: "781e3fcf-18f0-3501-a40a-8816eb5a08f7", act: "commission", obj: "Prozeß Werner von Heppenheim gegen Johann von Hohenfels", y: null, ev: "ernennt Abt Johann von St. Matthias außerhalb von Trier zum ksl. Kommissar", f: "Summary"},
  {k: "llm-v1:H4:875:A1", r: "d4997a39-02fb-3413-800c-a3770668e74b", act: "commission", obj: "Appellation Werners von Heppenheim", y: null, ev: "die Appellation, die Hauptsache und die anhängenden Punkte wegen eigenen Zeitmangels an seiner Statt rechtlich auszutragen", f: "Summary"},
  {k: "llm-v1:H4:876:A1", r: "2b1e066c-8a71-31ac-ae30-6a0fe195ac76", act: "commission", obj: "Appellation der Hunckel u. a. gegen ein Urteil des Burggrafen von Friedberg", y: null, ev: "die Appellation, die Hauptsache und die anhängenden Punkte wegen eigenen Zeitmangels an seiner Statt rechtlich auszutragen", f: "Summary"},
  {k: "llm-v1:H4:877:A1", r: "be681daa-797a-3fd0-be7a-f5cb4cd24c70", act: "summons", obj: "Tag zu Frankfurt (20. Januar 1485)", y: null, ev: "einen Tag verkünden, der am 20. Januar 1485 in Frankfurt stattfinden soll.", f: "Summary"},
  {k: "llm-v1:H4:878:A1", r: "c81de529-d9db-3e16-9b3d-afef6c622648", act: "commission", obj: "Vorbereitung des Frankfurter Tages mit den Fürsten", y: null, ev: "erteilt Bürgermeistern und Rat der Stadt Frankfurt Anordnungen", f: "Summary"},
  {k: "llm-v1:H4:879:A1", r: "21d1c591-cfae-3f7d-859f-c443cf99e91e", act: "privilege_confirmation", obj: "Vertrag zwischen Hanau und Frankfurt über den Bornheimer Berg (1481)", y: null, ev: "bestätigt den zwischen Gf. Philipp von Hanau und Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:880:A1", r: "14709cf2-0125-319d-a985-8b9e88ec3270", act: "enfeoffment", obj: "Dörfer Bornheim, Hausen und Oberrad mit Blutbann und Obrigkeit", y: null, ev: "belehnt Bürgermeister und Rat der Stadt Frankfurt mit den drei Dörfern Bornheim, Hausen und Oberrad", f: "Summary"},
  {k: "llm-v1:H4:881:A1", r: "2f9e3a66-fc28-3cd3-ad77-63c4e61d07fe", act: "request", obj: "Geleit zur Nördlinger Messe; Freilassung Nördlinger Bürger", y: null, ev: "den Besuchern der Nördlinger Messe[2] wie seit alters Geleit zu gewähren", f: "Summary"},
  {k: "llm-v1:H4:882:A1", r: "50fdedfc-471a-3618-acc3-f2a6b01c1b36", act: "mandate", obj: "Abstellung des Vorgehens gegen Nördlingen", y: null, ev: "befiehlt ihm, von jeglichem gewaltsamen Vorgehen abzustehen", f: "Summary"},
  {k: "llm-v1:H4:883:A1", r: "c64b2831-78b2-35cb-83e2-f7cb41033f90", act: "receipt", obj: "400 fl. rh.", y: null, ev: "quittiert der Stadt Neuss die Bezahlung von 400 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:884:A1", r: "ffd068b5-3b93-3307-a487-b75b7b7d4ca8", act: "commission", obj: "Entgegennahme und Verwahrung von 400 fl. rh. der Stadt Neuss", y: null, ev: "das Geld von den Neussern gegen Übergabe der Quittung entgegenzunehmen", f: "Summary"},
  {k: "llm-v1:H4:885:A1", r: "bd490804-1005-33f1-870a-53b085d25ae5", act: "other", obj: "Rechtsschutz gegen Diffamierungen Gf. Gerhards von Sayn", y: null, ev: "urkundet zugunsten der Gff. Ludwig von Isenburg, Philipp von Hanau und Philipp von Solms", f: "Summary"},
  {k: "llm-v1:H4:886:A1", r: "0c1a493f-5c23-3d18-b2ed-603dfcf583a5", act: "privilege_grant", obj: "Weiderecht im Königsbruch oberhalb Frankfurts", y: null, ev: "gewährt Dr. Georg von Hell", f: "Summary"},
  {k: "llm-v1:H4:887:A1", r: "41f75122-2a30-33aa-b76a-dcea4ba44df9", act: "summons", obj: "Tag zu Würzburg (8. Dezember 1485)", y: null, ev: "setzt den Kff. (einzeln) einen Tag auf den 8. Dezember nach Würzburg.", f: "Summary"},
  {k: "llm-v1:H4:888:A1", r: "cd51af58-1101-3b4d-990a-b31d17b72bdb", act: "summons", obj: "Tag zu Frankfurt", y: null, ev: "lädt die Stadt Magdeburg vor sich zu einem Tag nach Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:889:A1", r: "b8dafcd1-ce60-3ea9-87af-89d5096b7be9", act: "summons", obj: "wie n. 888", y: null, ev: "K. F. desgleichen an zahlreiche (noch nicht bekannte) Reichsangehörige.", f: "Summary"},
  {k: "llm-v1:H4:890:A1", r: "b6bd9a3f-86f5-3c7c-9891-6b4aa946a239", act: "enfeoffment", obj: "Urberger Hof zu Sachsenhausen (für die Stadt Frankfurt)", y: null, ev: "belehnt er mit diesem Hof samt allen Rechten und Zugehörungen Arnold von Holzhausen und Wicker Frosch d. J.", f: "Summary"},
  {k: "llm-v1:H4:891:A1", r: "7d795fec-1aa6-3164-948e-2b684659aac9", act: "request", obj: "Anreise mit kleinem Gefolge zum Frankfurter Tag", y: null, ev: "mit kleinem Gefolge zu kommen", f: "Summary"},
  {k: "llm-v1:H4:892:A1", r: "953e28c1-75c8-364c-8541-fc5e32070d60", act: "summons", obj: "Tag zu Frankfurt (20. Januar 1486)", y: null, ev: "auf den St. Fabianstag (1486 Januar 20) festgesetzt hat", f: "Summary"},
  {k: "llm-v1:H4:893:A1", r: "03c045f7-936c-344b-90bf-52d1340aab13", act: "request", obj: "Benachrichtigung der Kurfürsten und Fürsten über die verzögerte Ankunft", y: null, ev: "dies den von ihm auf sand Fabian und Sebastian (Januar 20) nach Frankfurt geladenen Kff. und Fürsten", f: "Summary"},
  {k: "llm-v1:H4:894:A1", r: "f4315685-0d02-34d5-bee4-f6fca59b5fe3", act: "receipt", obj: "Stadtsteuer 1484 (928 fl. rh.)", y: 1484, ev: "K. F. quittiert Bürgermeister und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:895:A1", r: "23bad438-ab56-37c5-b9e1-8437cbbfde07", act: "enfeoffment", obj: "Regalien des Erzstifts Mainz", y: null, ev: "verleiht Eb. Berthold von Mainz die Regalien.", f: "Summary"},
  {k: "llm-v1:H4:896:A1", r: "dcac8493-5bdf-33e1-ae3e-dad0d01ef09c", act: "privilege_confirmation", obj: "Privilegien", y: null, ev: "bestätigt Pfgf. Philipp bei Rhein die Privilegien.", f: "Summary"},
  {k: "llm-v1:H4:897:A1", r: "5149537f-25aa-367a-922a-c0370ec147d1", act: "privilege_confirmation", obj: "Privilegien", y: null, ev: "bestätigt Hz. Heinrich von Braunschweig die Privilegien.", f: "Summary"},
  {k: "llm-v1:H4:898:A1", r: "dcba90e7-265f-32ac-8f0e-b33b8fcb6ca4", act: "privilege_confirmation", obj: "Privilegien", y: null, ev: "bestätigt Bf. Johann von Worms die Privilegien.", f: "Summary"},
  {k: "llm-v1:H4:899:A1", r: "7294c3a8-2a8a-3da5-8a96-82e044368952", act: "privilege_grant", obj: "Jahrmarkt in Lorch für vier Jahre", y: null, ev: "bewilligt Eb. Berthold von Mainz für vier Jahre die Einrichtung eines Jahrmarkts in Lorch.", f: "Summary"},
  {k: "llm-v1:H4:900:A1", r: "d116ad20-c769-3579-9c41-624d4413af3b", act: "consent", obj: "Wahl Ehz. Maximilians zum römischen König", y: null, ev: "erklärt seine Zustimmung zur Wahl seines Sohnes Ehz. Maximilian zum römischen Kg.", f: "Summary"},
  {k: "llm-v1:H4:901:A1", r: "6c41551d-c030-3524-9545-48382e29d17a", act: "summons", obj: "gütlicher Tag zur Fehde gegen Frankfurt (24. Februar 1486)", y: null, ev: "einen Tag vor sich am ksl. Hof", f: "Summary"},
  {k: "llm-v1:H4:901:A2", r: "6c41551d-c030-3524-9545-48382e29d17a", act: "prohibition", obj: "Feindseligkeiten gegen Frankfurt bis zum Tag", y: null, ev: "verbietet ihnen bei Strafe, in der Zwischenzeit irgendetwas gegen die Frankfurter zu unternehmen", f: "Summary"},
  {k: "llm-v1:H4:902:A1", r: "d6b0cb0f-cbc0-3c81-a304-2dbb76ec67eb", act: "summons", obj: null, y: null, ev: "K. F. lädt Philipp Gans von Otzberg rechtlich vor sich.", f: "Summary"},
  {k: "llm-v1:H4:903:A1", r: "3896561c-2048-3f4e-afdf-039e7b9cf037", act: "summons", obj: null, y: null, ev: "K. F. lädt Heilmann von Praunheim u. a. rechtlich vor sich.", f: "Summary"},
  {k: "llm-v1:H4:904:A1", r: "8cb52305-9721-3f88-8355-32affc8f2a63", act: "commission", obj: "Anschlag von 400 Zentnern Pulver auf die Juden im Reich gegen Ungarn", y: null, ev: "bevollmächtigt und befiehlt dem Juden Levi", f: "Summary"},
  {k: "llm-v1:H4:905:A1", r: "c347634c-9730-3bb9-b46e-338b23e36889", act: "mandate", obj: "Lieferung des Pulveranteils an den Juden Levi", y: null, ev: "die unverzügliche Aushändigung des auf jeden von ihnen entfallenden Anteils an Levi", f: "Summary"},
  {k: "llm-v1:H4:906:A1", r: "13a10c8a-535c-3dd5-9bc5-21e1d535d58f", act: "mandate", obj: "Zwang säumiger Juden zur Pulverabgabe", y: null, ev: "jeden die Entrichtung seines Anteils", f: "Summary"},
  {k: "llm-v1:H4:907:A1", r: "c6ab20a2-3bdd-3897-93e6-a39e85e2dcbb", act: "other", obj: "Sühne der Fehde zwischen Heilmann von Praunheim u. a. und Frankfurt", y: null, ev: "verhört und gütlich beigelegt hat", f: "Summary"},
  {k: "llm-v1:H4:908:A1", r: "59e7b9a9-e956-3e7c-ab84-b64270baac4c", act: "commission", obj: "Erhebung der Ehrung von 1000 fl. rh. zur Königswahl Maximilians", y: null, ev: "beauftragt den Juden Levi mit der Erhebung", f: "Summary"},
  {k: "llm-v1:H4:909:A1", r: "5f170fe2-efbe-31bc-ba0a-a64079939e41", act: "mandate", obj: "Ehrung von 1000 fl. rh. an Kg. Maximilian", y: null, ev: "den Betrag von 1000 fl. rh. dem diesen Brief vorweisenden Juden Levi auszuhändigen", f: "Summary"},
  {k: "llm-v1:H4:910:A1", r: "1ca17859-7238-3467-a5c9-227e0035f720", act: "receipt", obj: "1600 fl. rh. Depot von Kg. Johann von Portugal und Eb. Hermann von Köln", y: null, ev: "quittiert Bürgermeistern und Rat der Stadt Frankfurt die Übergabe der 1600 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:911:A1", r: "c2a70de0-cedc-3cea-8188-814d2115d1e1", act: "receipt", obj: "10466 fl. rh. elsässische Stadtsteuern 1481–1486", y: null, ev: "erklärt sich gänzlich zufriedengestellt und enthebt die Frankfurter jeglicher Ansprüche an das Geld", f: "Summary"},
  {k: "llm-v1:H4:912:A1", r: "08b594a1-8365-3294-a072-34f63cf6f3ba", act: "receipt", obj: "400 fl. rh. für die Stadt Neuss", y: null, ev: "quittiert Bürgermeistern und Rat der Stadt Frankfurt die im Namen der Stadt Neuss erfolgte Bezahlung von 400 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:913:A1", r: "5f364a20-3e02-39f7-b1e7-b09d16f9b453", act: "receipt", obj: "Anteil am Mainzer Zoll seit 1480 (4288 fl. rh.)", y: null, ev: "quittiert Bürgermeistern und Rat der Stadt Frankfurt die an ihn erfolgte Bezahlung seines Anteils am Mainzer Zoll", f: "Summary"},
  {k: "llm-v1:H4:914:A1", r: "10339ec8-09c5-379d-bf25-614ba22eee40", act: "summons", obj: "Klage Frankfurts (16. März 1486)", y: null, ev: "lädt Abt Johann von Fulda auf Klage Frankfurts", f: "Summary"},
  {k: "llm-v1:H4:915:A1", r: "37ee134c-55f6-3c94-8424-7b5df3cbcb7d", act: "public_peace", obj: "zehnjähriger Landfriede (Frankfurter Landfriede 1486)", y: null, ev: "einen zehnjährigen gemeinen bestenntlichen friden durch das ganntz reych tewtscher naccion beschlossen hat", f: "Summary"},
  {k: "llm-v1:H4:916:A1", r: "0d011966-d67d-32a5-878d-b2e91ce42b18", act: "mandate", obj: "Anteil an der eilenden Hilfe gegen Ungarn (6240 fl. rh.) bis 3. Juni in Nürnberg", y: null, ev: "in Höhe von 6240 fl. rh. an sand Erasmen tag (Juni 3) in Nürnberg zu haben", f: "Summary"},
  {k: "llm-v1:H4:917:A1", r: "418ef59b-dd25-3316-9556-782605407ff4", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "Erfüllung der eilenden Hilfe gegenUngarn.", f: "Summary"},
  {k: "llm-v1:H4:918:A1", r: "0b458a5c-dba7-3163-ba81-092c0985eefa", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:919:A1", r: "aab56162-c1ee-3e7f-91c1-4aaac0292e24", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:920:A1", r: "ab32cfa5-f5b6-32c6-9787-bbf177b4ee81", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "K. F. befiehlt Hamburg Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:921:A1", r: "c6f3a6f0-4587-35dd-b35f-11be22f782c0", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "K. F. befiehlt Goslar Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:922:A1", r: "bb41a484-0829-3df7-aeef-038374f02b73", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "K. F. befiehlt Nordhausen Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:923:A1", r: "01ad1459-9924-3949-a23a-a7fe45eaf529", act: "mandate", obj: "eilende Hilfe gegen Ungarn", y: null, ev: "Erfüllung der eilenden Hilfe gegen Ungarn.", f: "Summary"},
  {k: "llm-v1:H4:924:A1", r: "6cddc477-54ff-3f91-9c50-b6921584e411", act: "commission", obj: "Zustellung und Durchsetzung der Mandate zu den Frankfurter Anschlägen", y: null, ev: "erteilt Hz. Albrecht von Sachsen eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:925:A1", r: "53191554-e4ff-3339-884d-864ca3d6d6c9", act: "commission", obj: "Überstellung der Gefangenen und gütlicher Ausgleich zwischen Fulda und Frankfurt", y: null, ev: "die Streitigkeiten zwischen dem Abt und Frankfurt an seiner Statt und in seinem Namen gütlich beizulegen", f: "Summary"},
  {k: "llm-v1:H4:926:A1", r: "ca82768c-e569-3fc1-ae4b-efdcb6ebc48e", act: "mandate", obj: "Unterstützung des Juden Levi beim Einzug des Pulveranschlags", y: null, ev: "den von ihm mit der Umlage und Eintreibung eines Anschlags über 400 Zentner Pulver", f: "Summary"},
  {k: "llm-v1:H4:927:A1", r: "48082a60-e7da-35e2-a5c1-c118003e8130", act: "credential", obj: "Verhandlungen über die Zahlung des Anschlags gegen Ungarn", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt Eb. Johann von Gran", f: "Summary"},
  {k: "llm-v1:H4:928:A1", r: "c6d99e86-4827-3c87-8564-55aa2cf7b26b", act: "receipt", obj: "Anteil am Frankfurter Anschlag zur Unterhaltung der Erblande", y: null, ev: "quittiert Bürgermeistern, Rat und Gemeinde der Stadt diese Leistung", f: "Summary"},
  {k: "llm-v1:H4:929:A1", r: "2b97bd54-53d4-3ce1-b0cd-da7f8d0c7794", act: "communication", obj: "Dank für die Hilfe gegen Ungarn; Annahme der Entschuldigung", y: null, ev: "dankt Bürgermeistern und Rat der Stadt Frankfurt auch im Namen Kg. Maximilians", f: "Summary"},
  {k: "llm-v1:H4:930:A1", r: "39a252fe-0ba4-37fd-861f-cd765a72e998", act: "mandate", obj: "Hinterlegung von 600 fl. rh. beim Frankfurter Rat", y: null, ev: "die für ihn (K. F.) bestimmten 600 fl. rh. beim Rat der Stadt Frankfurt zu hinterlegen.", f: "Summary"},
  {k: "llm-v1:H4:931:A1", r: "b9a4a970-6b4c-3c6d-94ac-5dcb54b96204", act: "summons", obj: "Verharren der Städtegesandten in Speyer bis zur Ankunft des Kaisers", y: null, ev: "dort bis zu seiner Ankunft zu verharren", f: "Summary"},
  {k: "llm-v1:H4:932:A1", r: "83774c98-fe31-3e7f-a074-740a7fd507f0", act: "credential", obj: "Abholung der deponierten Truhen durch Niclas Kadmeyr", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Türhüter Niclas Kadmeyr", f: "Summary"},
  {k: "llm-v1:H4:932:A2", r: "83774c98-fe31-3e7f-a074-740a7fd507f0", act: "mandate", obj: "Aushändigung der Truhen und Überführung einer Truhe nach Speyer", y: null, ev: "befiehlt ihnen, Kadmeyr die Truhen auszuhändigen", f: "Summary"},
  {k: "llm-v1:H4:932a:A1", r: "10577982-ab15-3697-9fc9-c4640f4e082d", act: "ban_enforcement", obj: "Acht gegen Jörg, Arnold und Friedrich von Rosenberg wegen Fehde gegen Würzburg", y: null, ev: "zu offenbaren Feinden von Kaiser und Reich", f: "Summary"},
  {k: "llm-v1:H4:933:A1", r: "9df46297-a768-37ba-9cea-33042ae8fc0a", act: "credential", obj: "Truhen des Kaisers", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt seinen Türhüter Hans Bernigsdorfer", f: "Summary"},
  {k: "llm-v1:H4:934:A1", r: "98678f45-f44c-339f-9c03-d4f9040cb3fa", act: "receipt", obj: "Anteil am Frankfurter Anschlag (200 fl. rh.)", y: null, ev: "quittiert Bürgermeistern, Rat und gemeiner Stadt Wetzlar", f: "Summary"},
  {k: "llm-v1:H4:935:A1", r: "433206a9-57cc-3824-8ed7-9a5060e7918c", act: "privilege_grant", obj: "Wegezoll am Hof Rieden zur Instandhaltung der Straße Frankfurt–Hanau", y: null, ev: "einen Zoll in Höhe von drei Pfennigen Landeswährung je beladenem Wagen", f: "Summary"},
  {k: "llm-v1:H4:936:A1", r: "c973b9c3-bf28-3cd4-8e25-c45ce8eddf34", act: "mandate", obj: "Inventarisierung und Verwahrung des Nachlasses des Selbstmörders Peter Beck", y: null, ev: "im einzelnen zu beschreiben und als ihm und dem Reich heimgefallene Güter in guter Verwahrung zu halten", f: "Summary"},
  {k: "llm-v1:H4:937:A1", r: "77ddfcae-19c1-3397-a55d-7e593d7cd43c", act: "other", obj: "Rückgabe der Wittumsgüter an die Witwe Peter Becks", y: null, ev: "gibt der Witwe des ehemaligen Frankfurter Bürgers Peter Beck", f: "Summary"},
  {k: "llm-v1:H4:938:A1", r: "5ad0e7f0-5de6-3edc-ad4f-ba11e08dd95b", act: "summons", obj: "Ungarntag zu Nürnberg (18. März 1487)", y: null, ev: "dorthin ihre bevollmächtigte Botschaft zu schicken", f: "Summary"},
  {k: "llm-v1:H4:939:A1", r: "5dfb5361-7156-32eb-b49f-2f5e96d3a0ed", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Köln zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:940:A1", r: "263a2ea2-6b1b-37d3-b241-d45b0ce203a2", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Straßburg zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:941:A1", r: "8889021e-0370-31d2-ab78-d604c8e5b3dd", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Lübeck zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:942:A1", r: "cbfc0437-ab0c-3843-b444-5b61ebc2f261", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Basel zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:943:A1", r: "742bed8e-4699-3dda-9e03-9dfbd323fc8a", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Speyer zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:944:A1", r: "fb4cc55a-fd17-3f0c-b3af-6b2298a3274c", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Augsburg zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:945:A1", r: "3ecb3596-5128-3680-b21b-1c2f717d3824", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Ulm zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:946:A1", r: "376d0d62-b8f4-347c-9dbb-3af6a91992d1", act: "summons", obj: "Ungarntag zu Nürnberg", y: null, ev: "K. F. lädt Nürnberg zu einem Ungarntag nach Nürnberg.", f: "Summary"},
  {k: "llm-v1:H4:947:A1", r: "fcb71c67-fc70-3abc-bc9e-9d81675f7542", act: "mandate", obj: "Zahlung von 32 fl. rh. Goldenem Opferpfennig an Gabriel Kolbmann", y: null, ev: "seinem Untermarschall Gabriel Kolbmann oder dessen Vertreter unverzüglich 32 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:948:A1", r: "0d7d0ec5-764a-3b95-ad86-4d2bd43d32fb", act: "request", obj: "Übersendung der Stadtsteuern 1486 und 1487 nach Nürnberg", y: null, ev: "unverzüglich nach Nürnberg zu schicken", f: "Summary"},
  {k: "llm-v1:H4:949:A1", r: "db3601e8-0ebc-33c6-8905-637a6a3be8e6", act: "receipt", obj: "Anteil an den Frankfurter Anschlägen", y: null, ev: "quittiert der Stadt Lübeck die Bezahlung ihres Anteils", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

// Rechtsakte 1001–1100
UNWIND [
  {k: "llm-v1:H4:950:A1", r: "9b15fd8f-1052-3afd-97bc-d72a4ebe5890", act: "mandate", obj: "Zahlung der Stadtsteuern 1486/1487 und der Würzburger 600 fl. rh.", y: null, ev: "unverzüglich zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:950:A2", r: "9b15fd8f-1052-3afd-97bc-d72a4ebe5890", act: "request", obj: "Darlehen von 2000 fl. rh. zur Rettung Wiener Neustadts", y: null, ev: "ein Darlehen von 2000 fl. rh. zu gewähren", f: "Summary"},
  {k: "llm-v1:H4:951:A1", r: "616c1764-64f3-3c23-a802-c82eb29d7617", act: "request", obj: "Antwort in Reichsangelegenheiten", y: null, ev: "und fordert Antwort.", f: "Summary"},
  {k: "llm-v1:H4:952:A1", r: "f56f99fd-7e08-3fb6-8cb4-8ef22c7a9ab6", act: "receipt", obj: "Stadtsteuer 1485 (928 fl. rh.)", y: 1485, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:953:A1", r: "ea2b1be2-0fde-31fa-afe3-90be42315d0a", act: "receipt", obj: "Stadtsteuer 1486 (928 fl. rh.)", y: 1486, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:954:A1", r: "1bf2b47b-3c06-3a35-9573-5b2ce333bfe2", act: "receipt", obj: "von Bf. Rudolf von Würzburg hinterlegte 600 fl. rh.", y: null, ev: "von Bf. Rudolf von Würzburg, seinem Fürsten und Rat, für ihn hinterlegten 600 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:955:A1", r: "a669456a-1304-3059-9812-562f87bc690d", act: "enfeoffment", obj: "Regalien und Lehen", y: null, ev: "verleiht den Hzz. von Sachsen, Kf. Friedrich, dessen Bruder Johann und ihrem Vetter Albrecht, ihre Regalien und Lehen.", f: "Summary"},
  {k: "llm-v1:H4:956:A1", r: "511a9a18-fde2-3188-ab51-dc4c531c3240", act: "mandate", obj: "Anteil von 1300 fl. rh. an der Hilfe zum Entsatz Wiener Neustadts", y: null, ev: "das Geld, welches bis zum sand Jacobs tag (Juli 25) bezahlt sein soll", f: "Summary"},
  {k: "llm-v1:H4:957:A1", r: "7cc8784c-4449-3a20-9bf5-56c094237903", act: "mandate", obj: "Anteil von 3000 fl. rh. an der Hilfe zum Entsatz Wiener Neustadts", y: null, ev: "den auf sie entfallenden Anteil an der Hilfe zum Entsatz Wiener Neustadts in Höhe von 3000 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:958:A1", r: "4296af70-c7b3-3791-ae91-314bdcaea7d2", act: "privilege_grant", obj: "Zunftprivileg der Meister des Schwerts (Fechtmeister)", y: null, ev: "gewährt den Meistern des Schwerts die besondere Vergünstigung", f: "Summary"},
  {k: "llm-v1:H4:959:A1", r: "6219bf41-0224-3a07-bd1f-7688ce097b14", act: "request", obj: "vorzeitige Übersendung der Stadtsteuer 1487 an den Hof", y: null, ev: "die am kommenden sant Martins tag (1487 November 11) fällig werdende Stadtsteuer", f: "Summary"},
  {k: "llm-v1:H4:960:A1", r: "c975374f-1d3d-3b67-be98-ac033149a49e", act: "mandate", obj: "Übersendung der Stadtsteuer 1486 an den Hof", y: null, ev: "unverzüglich an den ksl. Hof zu schicken", f: "Summary"},
  {k: "llm-v1:H4:961:A1", r: "8e590551-84a3-3e17-8009-ba017a561059", act: "commission", obj: "Rechtsstreit Hoemberger gegen Fronhofer", y: null, ev: "ernennt Jakob Buseck, Sänger des St. Leonhardsstiftes zu Frankfurt, zu seinem Kommissar", f: "Summary"},
  {k: "llm-v1:H4:962:A1", r: "1b28541f-eabf-37cf-9c19-621c95ea5c7a", act: "commission", obj: "Appellation Eberhard Fronhofers", y: null, ev: "erteilt Heinrich von Helmstadt, Dekan und Domherrn zu Speyer, eine ksl. Kommission", f: "Summary"},
  {k: "llm-v1:H4:963:A1", r: "63f42ac1-0ac3-3b13-85a6-2dd5e3d69c1e", act: "mandate", obj: "Erscheinen bestgerüstet im Feld bei Augsburg (23. April 1488) gegen Ungarn", y: null, ev: "sich für den Kampf gegen den Ungarnkönig bestgerüstet ebenfalls dort einzufinden", f: "Summary"},
  {k: "llm-v1:H4:964:A1", r: "e5bf2332-1ac8-380d-b317-7219150291c8", act: "mandate", obj: "Zahlung der Stadtsteuer 1487 an Protonotar Johann Waldner", y: null, ev: "unverzüglich an seinen Protonotar Johann Waldner oder dessen Anwalt zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:965:A1", r: "1694f33e-cb9d-3b40-93a7-7eee014d7b5c", act: "receipt", obj: "Stadtsteuer 1487 (928 fl. rh.)", y: 1487, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:966:A1", r: "a356023e-fe2d-300e-8cf6-255b2d93ce83", act: "summons", obj: "Klage des Fiskals wegen der Verträge zwischen Stadt und Geistlichkeit von Worms", y: null, ev: "lädt Bürgermeister und Rat der Stadt Worms aufgrund der Klage seines Kammerprokurator-Fiskals", f: "Summary"},
  {k: "llm-v1:H4:966:A2", r: "a356023e-fe2d-300e-8cf6-255b2d93ce83", act: "prohibition", obj: "Erfüllung der Verbindlichkeiten gegenüber Bischof und Geistlichkeit", y: null, ev: "die unbefugt eingegangenen Verbindlichkeiten gegenüber Bf. und Geistlichkeit", f: "Summary"},
  {k: "llm-v1:H4:967:A1", r: "3443099e-8096-3d06-8b40-ac5513737505", act: "summons", obj: "Klage des Fiskals wegen Verträgen ohne kaiserliche Einwilligung", y: null, ev: "lädt Bf. Johann und die Geistlichkeit von Worms", f: "Summary"},
  {k: "llm-v1:H4:968:A1", r: "8af91445-8200-3b95-95e4-b42dcf6988ae", act: "mandate", obj: "Truppen zum 23. April 1488 nach Augsburg", y: null, ev: "wo sie ihre ihm zugesagten Truppen pünktlich zum Feldzug bereithalten sollen", f: "Summary"},
  {k: "llm-v1:H4:969:A1", r: "02ffa2a9-93c5-34e7-b048-eb8984c605d1", act: "mandate", obj: "wie n. 968", y: null, ev: "K. F. desgleichen an die Stadt Lübeck.", f: "Summary"},
  {k: "llm-v1:H4:970:A1", r: "abf538d9-0efb-398e-bff2-f8e65721dc64", act: "prohibition", obj: "Münzprägung Philipps d. Ä. von Weinsberg in Frankfurt", y: null, ev: "keinerlei Gold- oder Silbermünzen mehr in Frankfurt schlagen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:971:A1", r: "850c7a8a-30fa-30cf-81a9-db756b49155a", act: "prohibition", obj: "Münzprägung Friedrich Nachtrabes in Frankfurt", y: null, ev: "den Friedrich Nachtrabe künftig keine Gulden oder Silbermünzen mehr in Frankfurt schlagen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:972:A1", r: "305bf517-b20b-3120-89ce-2be3b8c8b1b9", act: "other", obj: "Verschreibung des Goldenen Opferpfennigs der Frankfurter Juden", y: null, ev: "verschreibt Bernhard Sittich, seinem Romerich", f: "Summary"},
  {k: "llm-v1:H4:973:A1", r: "f7f9fe47-93aa-3e26-b313-3aac3e05b06e", act: "ban_enforcement", obj: "Acht gegen die 'bösen Räte' Hz. Sigmunds von Tirol", y: null, ev: "erklärt die 'bösen Räte' Hz. Sigmunds von Tirol", f: "Summary"},
  {k: "llm-v1:H4:974:A1", r: "e1d7ceec-2c89-30a0-b235-937a5cf0bc55", act: "commission", obj: "Appellationsprozeß Katharina Wisse gegen Matern Gerthener", y: null, ev: "erteilt dem Mainzer Domherrn Wolf(gang) von Bicken und dem Lic. Johann Fust eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:975:A1", r: "df1c93ec-4eb2-39d0-b2cb-dd534ba96f50", act: "mandate", obj: "Truppenkontingent nach Köln zur Befreiung Kg. Maximilians aus Brügge", y: null, ev: "nunmehr zum gleichen Termin bestgerüstet zu ihm nach Köln zu schicken", f: "Summary"},
  {k: "llm-v1:H4:976:A1", r: "cd55fdac-5be1-3d06-82cb-f05686d6b2e1", act: "mandate", obj: "Truppen trotz Zusage an Ehz. Philipp zum 23. April nach Köln", y: null, ev: "ihre Truppen entsprechend seinem vormaligen Befehl[2] am sannd Georgen tag (April 23) bei ihm in Köln", f: "Summary"},
  {k: "llm-v1:H4:977:A1", r: "348dc21a-8acf-3658-940e-0536eb14783d", act: "request", obj: "zollfreie Passage des Frankfurter Proviants rheinabwärts", y: null, ev: "alle Zollstätten abgabenfrei passieren zu lassen", f: "Summary"},
  {k: "llm-v1:H4:978:A1", r: "34a90a1f-b21a-373d-8200-b76dc05b0714", act: "mandate", obj: "Verbleib und Verstärkung der Frankfurter Truppen in Flandern", y: null, ev: "nun keinesfalls ihre Truppen abzuziehen", f: "Summary"},
  {k: "llm-v1:H4:979:A1", r: "9b861dc2-618b-3b16-8a64-bb690c91a694", act: "request", obj: "zwei weitere Monate Felddienst der Frankfurter Truppen in Flandern", y: null, ev: "noch zwei Monate über die zugesagte Verlängerung hinaus im Feld zu bleiben", f: "Summary"},
  {k: "llm-v1:H4:980:A1", r: "eff4a7c4-d8a4-33e6-8505-2ad461e4d913", act: "commission", obj: "Prozeß Johann Sigwein gegen Kraft zur Alten Waage und Jakob Guldenlewe", y: null, ev: "erteilt Abt Werner von Selbold eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:981:A1", r: "74a40ee9-3487-3050-aecf-0e1354eb9ceb", act: "summons", obj: "Tag zu Speyer (6. Januar 1489) über einen Zug in die Niederlande", y: null, ev: "auf der heiligen dreyer kunig tag (1489 Januar 6) ihre Botschaft nach Speyer zu schicken", f: "Summary"},
  {k: "llm-v1:H4:982:A1", r: "28dc78a5-6fe9-37fb-8707-1174e6eabf3f", act: "summons", obj: "Reichstag zu Speyer (6. Januar 1489)", y: null, ev: "am Dreikönigstag zum Reichstag nach Speyer zu kommen.", f: "Summary"},
  {k: "llm-v1:H4:983:A1", r: "d47ae980-9a40-397d-9e4e-046dd5ca0d1f", act: "summons", obj: "Reichstag zu Speyer (6. Januar 1489)", y: null, ev: "am Dreikönigstag zum Reichstag nach Speyer zu kommen.", f: "Summary"},
  {k: "llm-v1:H4:984:A1", r: "c304ac19-7a66-3c19-8eac-443037b53c5b", act: "summons", obj: "Reichstag zu Speyer (6. Januar 1489)", y: null, ev: "am Dreikönigstag zum Reichstag nach Speyer zu kommen.", f: "Summary"},
  {k: "llm-v1:H4:985:A1", r: "23f75baf-9da4-3631-8958-bc79a4254c60", act: "receipt", obj: "Stadtsteuer 1488 (928 fl. rh.)", y: 1488, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurtdie", f: "Summary"},
  {k: "llm-v1:H4:986:A1", r: "a66b1e56-d849-3a5a-b5fe-3a4b40b8b303", act: "ban_enforcement", obj: "Acht gegen Swicker von Sickingen wegen Landfriedensbruchs gegen Köln", y: null, ev: "verkündet die über Swicker von Sickingen und seine Helfer", f: "Summary"},
  {k: "llm-v1:H4:987:A1", r: "eaa35402-01c8-3806-96bc-68280f99a9da", act: "ban_enforcement", obj: "keine Unterstützung für die Ächter Swicker von Sickingen und Helfer", y: null, ev: "entsprechend dem Urteil als Ächter[2] zu behandeln", f: "Summary"},
  {k: "llm-v1:H4:988:A1", r: "0128d136-8cf9-3617-aec0-0209b57250dc", act: "mandate", obj: "Zahlung der Stadtsteuer 1488 an Protonotar Hans Waldner", y: null, ev: "unverzüglich an seinen Protonotar Hans Waldner oder dessen Anwalt zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:989:A1", r: "02fc743e-816f-3398-9da3-2273b73c6d76", act: "receipt", obj: "Stadtsteuer 1489 (im Voraus)", y: 1489, ev: "quittiert den Frankfurtern die Bezahlung der am kommenden Martinstag", f: "Summary"},
  {k: "llm-v1:H4:990:A1", r: "d8497e33-18f8-343b-8851-aa5f18cc60f9", act: "summons", obj: "Reichstag zu Frankfurt (Pfingsten 1489) gegen Frankreich und Ungarn", y: null, ev: "auf pfingsten (Juni 7) mit voller Macht in Frankfurt vertreten zu sein", f: "Summary"},
  {k: "llm-v1:H4:991:A1", r: "0b8d5a35-1c90-3322-94b6-826031f7b386", act: "summons", obj: "Reichstag zu Frankfurt (Pfingsten 1489)", y: null, ev: "zu Pfingsten am Reichstag in Frankfurt zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:992:A1", r: "1fd40274-60ea-331c-9a57-85309dc07220", act: "summons", obj: "Reichstag zu Frankfurt (Pfingsten 1489)", y: null, ev: "zu Pfingsten am Reichstag in Frankfurt zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:993:A1", r: "2d2a0ebb-402b-310d-adcc-631a25c9456e", act: "summons", obj: "Reichstag zu Frankfurt (Pfingsten 1489)", y: null, ev: "zu Pfingsten am Reichstag in Frankfurt zu erscheinen.", f: "Summary"},
  {k: "llm-v1:H4:994:A1", r: "2d1e277a-0f90-3bc7-9f9e-dd1b24539d40", act: "credential", obj: "Vertretung des Kaisers auf dem Frankfurter Tag (7. Juni 1489)", y: null, ev: "bevollmächtigt Kg. Maximilian und Bf. Wilhelm von Eichstätt als seine Vertreter", f: "Summary"},
  {k: "llm-v1:H4:995:A1", r: "05022448-1171-3e69-bbe8-c0228dadcdd3", act: "credential", obj: "Vertretung des Kaisers auf dem Frankfurter Tag (7. Juni 1489)", y: null, ev: "als seine Vertreter Kg.Maximilian und Bf. Wilhelm von Eichstätt", f: "Summary"},
  {k: "llm-v1:H4:996:A1", r: "ddd1e5c1-ecd6-3ea9-8094-f247772f9c69", act: "other", obj: "Ungültigerklärung der Verträge und des Eides der Stadt Worms gegenüber Bf. Johann", y: null, ev: "ohne seine Einwilligung abgeschlossenen Verträge", f: "Summary"},
  {k: "llm-v1:H4:997:A1", r: "c37bf859-faf3-3280-8d73-9a41fe5af151", act: "receipt", obj: "Stadtsteuer 1489 (928 fl. rh.)", y: 1489, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:998:A1", r: "2ad55c21-c550-3af3-b52b-1412e7f2c882", act: "mandate", obj: "Zwangsmaßnahmen gegen die Frankfurter Juden und ihren Hochmeister zugunsten Kg. Maximilians", y: null, ev: "diese mit Leib und Gut zu arrestieren und zu der Wiedergutmachung zu zwingen", f: "Summary"},
  {k: "llm-v1:H4:999:A1", r: "4eb269bd-f2d3-3b36-9eb8-37c219d26eac", act: "mandate", obj: "Rüstung zum Feldzug gegen Ungarn", y: null, ev: "sich unverzüglich zum Feldzug gegen den König (Matthias) von Ungarn zu rüsten.", f: "Summary"},
  {k: "llm-v1:H4:1000:A1", r: "7cdfe69d-3167-3c26-a595-2ddc911753f1", act: "mandate", obj: "Rüstung zum Feldzug gegen Ungarn", y: null, ev: "sich unverzüglich zum Feldzug gegen den König (Matthias) von Ungarn zu rüsten.", f: "Summary"},
  {k: "llm-v1:H4:1001:A1", r: "7a32a66d-beef-33a2-9b75-cbc58c48d99b", act: "mandate", obj: "Rüstung zum Feldzug gegen Ungarn", y: null, ev: "sich unverzüglich zum Feldzug gegen den König (Matthias) von Ungarn zu rüsten.", f: "Summary"},
  {k: "llm-v1:H4:1002:A1", r: "42cb0d05-673d-3a22-8896-3eed7670cbf0", act: "mandate", obj: "Rüstung zum Feldzug gegen Ungarn", y: null, ev: "sich unverzüglich zum Feldzug gegen den Kg. (Matthias) von Ungarn zu rüsten.", f: "Summary"},
  {k: "llm-v1:H4:1003:A1", r: "2da08906-59d7-3243-8ffb-45f04f2cebd5", act: "other", obj: "Kammergerichtsurteil gegen Regensburg: Rückkehr unter das Reich binnen Monatsfrist", y: null, ev: "sich binnen Monatsfrist wieder in seine (K. F.) und des Reiches Gewalt zu begeben", f: "Summary"},
  {k: "llm-v1:H4:1004:A1", r: "1cbaba34-0c7c-36e6-8cff-5a48d576c1df", act: "consent", obj: "Ablösung der Pfandschaften Ortenberg, Offenburg, Gengenbach und Zell", y: null, ev: "gestattet Ehz. Sigmund von Tirol", f: "Summary"},
  {k: "llm-v1:H4:1005:A1", r: "5f67cf29-b119-3a3b-97f2-c05ca0567f99", act: "mandate", obj: "Einstellung und Abbruch der Befestigung des Deutschordens bei Sachsenhausen", y: null, ev: "unverzüglich einzustellen und die Bauten niederzulegen", f: "Summary"},
  {k: "llm-v1:H4:1006:A1", r: "c68493da-478c-3992-a62f-eefd6ecf0b46", act: "commission", obj: "Abbruch der Befestigungen des Komturs Pankraz von Reinstein", y: null, ev: "die von Pankraz rechtswidrig errichteten Befestigungen im Falle dessen Ungehorsams durch ihre eigenen Leute abreißen zu lassen", f: "Summary"},
  {k: "llm-v1:H4:1007:A1", r: "e98d4d23-0c6d-35b5-b496-2864e240eb86", act: "mandate", obj: "Einwirkung auf den Komtur zur Abtragung der Bauten", y: null, ev: "Pankraz bestimmen, dem Befehl des K. nachzukommen", f: "Summary"},
  {k: "llm-v1:H4:1008:A1", r: "7b3e533d-fdbe-3897-9504-14ca339f1997", act: "commission", obj: "Gesandtschaft zu Kg. Matthias von Ungarn nach Wien", y: null, ev: "beauftragt Wilhelm von Bibra, Sigmund von Rohrbach und Marquard Brisacher mit einer Gesandtschaft", f: "Summary"},
  {k: "llm-v1:H4:1009:A1", r: "06ee4842-cff7-3cdd-9cd3-53d33226fede", act: "consent", obj: "Kauf des Schlosses Rannariedl durch Sigmund Prueschenk", y: null, ev: "genehmigt den Kauf des Schlosses Rannariedl", f: "Summary"},
  {k: "llm-v1:H4:1009:A2", r: "06ee4842-cff7-3cdd-9cd3-53d33226fede", act: "privilege_grant", obj: "Donauzoll", y: null, ev: "bewilligt Prueschenk die Erhebung eines Zolls auf der Donau", f: "Summary"},
  {k: "llm-v1:H4:1010:A1", r: "5124026d-6fde-31bb-a5fb-e3c317642f7b", act: "mandate", obj: "Truppen nach Linz zur Rückeroberung der Erblande nach dem Tod Kg. Matthias'", y: null, ev: "unverzüglich eine Anzahl bestausgerüsteter Reiter und Fußtruppen nach Linz zu schicken", f: "Summary"},
  {k: "llm-v1:H4:1011:A1", r: "5f8ef76d-45ef-3c1a-9ff9-a1d9443d3250", act: "credential", obj: "mündliche Werbung in Reichssachen", y: null, ev: "seinen Rat und Kammerprokurator-Fiskal Heinrich Martin zu mündlicher Werbung", f: "Summary"},
  {k: "llm-v1:H4:1012:A1", r: "50302545-219e-3be5-88c3-9a65b85a046b", act: "mandate", obj: "Wahrung des Kölner Zolls und Stapels durch die Frankfurter", y: null, ev: "dafür zu sorgen, daß ihre Mitbürger sich an diese Verfügung halten", f: "Summary"},
  {k: "llm-v1:H4:1013:A1", r: "1a47daf9-eda5-3fb8-8c36-fd23e6943915", act: "mandate", obj: "zehn Reisige gegen Kg. Wladislaw und ungarische Stände", y: null, ev: "zehn Reisige zuzuschicken", f: "Summary"},
  {k: "llm-v1:H4:1014:A1", r: "5c4c8e0b-2d44-30b0-9177-6616f2b5a2aa", act: "receipt", obj: "Stadtsteuer 1490 (928 fl. rh.)", y: 1490, ev: "K. F. quittiert Bürgermeistern und Rat der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:1015:A1", r: "a5d0288a-3093-3e10-95b5-94764173f8ca", act: "other", obj: "Verschreibung von 100 fl. rh. auf die Frankfurter Judenschaft", y: null, ev: "verschreibt seinem Astronomen und Leibarzt Johann von Linden 100 fl. rh.", f: "Summary"},
  {k: "llm-v1:H4:1016:A1", r: "0599a20d-3fb5-3fe4-ab31-2b506c17e5cc", act: "receipt", obj: "100 fl. rh. an Johann von Linden", y: null, ev: "quittiert den Frankfurter Juden die (an seinen Astronomen und Leibarzt Johann von Linden) erfolgte Bezahlung", f: "Summary"},
  {k: "llm-v1:H4:1017:A1", r: "c8d11d99-5975-3c69-b9ca-72711eb01817", act: "mandate", obj: "Zahlung von 100 fl. rh. an Johann von Linden", y: null, ev: "seinem Diener Johann von Linden gegen ksl. Quittung 100 fl. rh. zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:1018:A1", r: "7b5ebd86-0c3b-31f9-a331-55a5073a2688", act: "mandate", obj: "Truppen ins Feld bei Wien (23. April 1491) gegen Wladislaw und ungarische Stände", y: null, ev: "ins Feld bei Wien zu schicken", f: "Summary"},
  {k: "llm-v1:H4:1019:A1", r: "2e10bdb9-8979-3ae3-bfff-75cced4aed18", act: "credential", obj: "Verhandlungen über Hilfe gegen Ungarn", y: null, ev: "bevollmächtigt Kg. Maximilian und seinen Rat Bf. Wilhelm von Eichstätt", f: "Summary"},
  {k: "llm-v1:H4:1020:A1", r: "a6ab964a-2ccd-33f9-a23f-60abc2df9194", act: "credential", obj: "Verhandlungen über Hilfe gegen Ungarn", y: null, ev: "beglaubigt diese bei ihnen und fordert den schuldigen Gehorsam", f: "Summary"},
  {k: "llm-v1:H4:1021:A1", r: "72b85ce2-7535-38d0-bdaf-0ab74d3f7160", act: "request", obj: "päpstliche Bestätigung der Frankfurter Zinsordnung für jüdische Geldwechsler", y: null, ev: "bittet ihn, diese Ordnung zu bestätigen", f: "Summary"},
  {k: "llm-v1:H4:1022:A1", r: "e60e6144-d773-302a-aa11-19851fd95324", act: "other", obj: "Erklärung der Rechtmäßigkeit des Frankfurter Vorgehens gegen Ansprüche Johanns von Schwarzenberg", y: null, ev: "keineswegs gegen die Goldene Bulle", f: "Summary"},
  {k: "llm-v1:H4:1023:A1", r: "84b948fb-2691-3deb-abe9-75e029779133", act: "privilege_grant", obj: "Straffreiheit bei unwissentlichem Verstoß gegen das Kölner Zollgebot", y: null, ev: "weder den angedrohten Strafen und weiteren ksl. Maßnahmen verfallen", f: "Summary"},
  {k: "llm-v1:H4:1024:A1", r: "6c5da330-79ec-3b27-98aa-c272ffef3124", act: "mandate", obj: "Zahlung der Stadtsteuer 1490 an Protonotar Johann Waldner", y: null, ev: "unverzüglich an seinen Protonotar und Rat Johann Waldner oder dessen Anwalt zu bezahlen", f: "Summary"},
  {k: "llm-v1:H4:1025:A1", r: "17c528e8-659d-3a6c-8e7f-6497e524ac3b", act: "credential", obj: "Verhandlungen über die Stadtsteuer 1490", y: null, ev: "beglaubigt bei Bürgermeistern und Rat der Stadt Frankfurt den Lehrer der Rechte Ludwig vom Paradies", f: "Summary"},
  {k: "llm-v1:H4:1026:A1", r: "e8ecbab3-e43a-3e78-a430-75c4a91a5028", act: "summons", obj: "Klage des Fiskals wegen Landfriedensbruchs vom Schloß Lindheim aus", y: null, ev: "lädt Bggf. Baumeister, Burgmannen und Ganerben des Schlosses Lindheim", f: "Summary"},
  {k: "llm-v1:H4:1027:A1", r: "08e85df7-974a-3ba8-9cb4-0d8a168d1dd1", act: "commission", obj: "Eintreibung von 100 fl. rh. bei den Frankfurter Juden", y: null, ev: "ermächtigt seinen Diener Johann von Linden", f: "Summary"},
  {k: "llm-v1:H4:1028:A1", r: "056ebd76-45d9-3256-9007-9c2dcd13b751", act: "mandate", obj: "Zwang der Frankfurter Juden zur Zahlung durch jüdischen Bann", y: null, ev: "die Juden im Falle der Weigerung durch die Verhängung des jüdischen Bannes", f: "Summary"},
  {k: "llm-v1:H4:1029:A1", r: "04e0ee7f-57cb-39fc-a867-7b2f946c35af", act: "mandate", obj: "Pfandsetzung Arnold Holzhausens für eine Schuld von 2400 fl. rh.", y: null, ev: "daß Arnold entsprechende Pfänder setzt", f: "Summary"},
  {k: "llm-v1:H4:1030:A1", r: "805a5b51-5b50-3ed7-9280-6510e6319028", act: "commission", obj: "Veranschlagung der Juden im Reich zu einer Geldbeihilfe", y: null, ev: "bevollmächtigt seinen Sohn Kg. Maximilian", f: "Summary"},
  {k: "llm-v1:H4:1031:A1", r: "db307b25-665b-3909-93b8-60983944a0db", act: "prohibition", obj: "Abhaltung des von Kurfürsten und Fürsten geplanten Frankfurter Tages", y: null, ev: "jedes Ersuchen der Kff. und Fürsten, den Tag in ihren Mauern abzuhalten, abzulehnen", f: "Summary"},
  {k: "llm-v1:H4:1032:A1", r: "82c658d1-9ed3-3baf-b90b-2294a894395d", act: "ban_enforcement", obj: "Vollstreckung der Acht gegen Regensburg", y: null, ev: "ihm zu helfen, die execution zu prosequirn", f: "Summary"},
  {k: "llm-v1:H4:1033:A1", r: "062df99a-e302-3af1-95b0-200481f66a6a", act: "ban_enforcement", obj: "Acht gegen Helfer Regensburgs; Zuzug zum Reichsheer unter Mgf. Friedrich von Brandenburg", y: null, ev: "Mgf. Friedrich von Brandenburg als seinem obersten Hauptmann und dem Reichsbanner auf Erfordern mit ganzem Vermögen zuzuziehen", f: "Summary"},
  {k: "llm-v1:H4:1034:A1", r: "89b30fee-9ead-3bac-912b-667b2ab498f4", act: "appointment", obj: "oberster Hauptmann gegen Regensburg mit dem Reichsbanner", y: null, ev: "ernennt Mgf. Friedrich von Brandenburg zu seinem obersten Hauptmann", f: "Summary"},
  {k: "llm-v1:H4:1035:A1", r: "589d5d2f-a9e8-3b17-9b76-0e68f93fee94", act: "commission", obj: "Streit zwischen dem Rat von Speyer und den Münzerhausgenossen", y: null, ev: "erteilt den Städten Worms und Frankfurt einzeln oder gemeinsam eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:1036:A1", r: "82b9e886-9350-3807-b970-9fa3e2292fd5", act: "summons", obj: "Klage Frankfurts", y: null, ev: "lädt den Gf. (Ludwig) von Isenburg(-Büdingen) auf Klage der Stadt Frankfurt", f: "Summary"},
  {k: "llm-v1:H4:1037:A1", r: "6b833a35-a4cf-3a68-83b4-f414a4d922f9", act: "summons", obj: null, y: null, ev: "K. F. lädt Gf. Philipp von Hanau rechtlich vor sich.", f: "Summary"},
  {k: "llm-v1:H4:1038:A1", r: "af268f9b-59a8-35a1-b5f3-eb36fb214e15", act: "summons", obj: null, y: null, ev: "K. F. lädt Gf. Philipp von Solms rechtlich vor sich.", f: "Summary"},
  {k: "llm-v1:H4:1039:A1", r: "603305f5-5b8a-3e64-908f-a2ba82885b00", act: "commission", obj: "Streit Frankfurts mit den Gff. von Isenburg, Hanau und Solms", y: null, ev: "erteilt mehreren Unbekannten einen Kommissionsauftrag", f: "Summary"},
  {k: "llm-v1:H4:1040:A1", r: "6f919dc2-ad42-3a2a-9ae6-b607237c8144", act: "commission", obj: "Prozeß Niklas Lower gegen Heinrich Sneider", y: null, ev: "erteilt Bürgermeistern und Rat der Stadt Frankfurt eine Kommission", f: "Summary"},
  {k: "llm-v1:H4:1041:A1", r: "6a6e71ca-b082-3a75-b5eb-f6c3112dbfac", act: "mandate", obj: "Truppen nach Metz (2. August 1492) gegen Kg. Karl VIII. von Frankreich", y: null, ev: "ihre wohlgerüsteten Truppen in Metz bei ihm", f: "Summary"},
  {k: "llm-v1:H4:1042:A1", r: "a15d0270-aae0-3fa1-a1a4-ec6fb6f40d3e", act: "mandate", obj: "wie n. 1041", y: null, ev: "K. F. desgleichen an die Stadt Konstanz.", f: "Summary"},
  {k: "llm-v1:H4:1043:A1", r: "1f6d8266-2563-3539-9784-bab7590248bc", act: "credential", obj: "Vertretung auf dem Tag zu Koblenz", y: null, ev: "bevollmächtigt Bf. Wilhelm von Eichstätt und Gf. Eitelfritz von Zollern", f: "Summary"},
  {k: "llm-v1:H4:1044:A1", r: "baa26bc0-bae7-3654-8ca3-166a23541804", act: "privilege_grant", obj: "Freiheit Butzbachs von westfälischen und fremden Gerichten", y: null, ev: "gewährt Bürgermeistern und Rat der Stadt Butzbach die besondere Gnade", f: "Summary"},
  {k: "llm-v1:H4:1045:A1", r: "daaff569-565a-37e1-a26f-48c2fe04a6bc", act: "mandate", obj: "Übersendung der rückständigen Stadtsteuern an den Hof", y: null, ev: "die ihm schuldigen verfallenen Stadtsteuern[1] unverzüglich an den ksl. Hof zu schicken", f: "Summary"},
  {k: "llm-v1:H4:1046:A1", r: "94bc8b7e-4631-3224-b1b5-7fe25cc4e61f", act: "commission", obj: "allgemeines Aufgebot gegen Kg. Karl VIII. von Frankreich", y: null, ev: "bevollmächtigt Kg. Maximilian", f: "Summary"}
] AS row
MATCH (r:Regesta {uuid: row.r})
OPTIONAL MATCH (r)<-[:PART_OF]-(c:Content) WHERE row.f IN labels(c)
WITH row, r, head(collect(c)) AS c
MERGE (a:Annotation {importKey: row.k})
  ON CREATE SET a.uuid = randomUUID(), a.type = 'ri:legalAct', a.label = 'ri:legalAct',
    a.act = row.act, a.object = row.obj, a.year_ref = row.y, a.evidence = row.ev, a.evidence_field = row.f,
    a.source = 'llm', a.model = 'claude-opus-5-5', a.prompt_version = 'v1', a.status = 'unreviewed', a.created = datetime()
MERGE (r)-[:HAS_ANNOTATION]->(a)
FOREACH (_ IN CASE WHEN c IS NULL THEN [] ELSE [1] END | MERGE (a)-[:REFERS_TO]->(c));

