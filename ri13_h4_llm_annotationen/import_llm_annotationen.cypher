  {k: "llm-v1:H4:8:A1", r: "04d6b3a5-db48-3f7f-8913-64b32ee791a4", act: "communication", obj: "Absage des Nürnberger Tags", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:8:A2", r: "04d6b3a5-db48-3f7f-8913-64b32ee791a4", act: "summons", obj: "Tag zu Mainz (2. Februar 1441)", y: null, ev: "gebietet ihnen, dort ebenfalls vertreten zu sein", f: "Summary"},
  {k: "llm-v1:H4:9:A1", r: "52500293-2dd3-385b-9d78-698bc7713256", act: "summons", obj: "Rechttag Konrads von Bebenburg gegen Schwäbisch Hall", y: null, ev: "setzt Konrad von Bebenburg einen Rechttag", f: "Summary"},
  {k: "llm-v1:H4:10:A1", r: "a264646d-60ca-30dc-aeb9-79cea9e6c57b", act: "summons", obj: "rechtliche Verantwortung auf Klage Konrads von Bebenburg", y: null, ev: "lädt die Stadt (Schwäbisch-)Hall zu rechtlicher Verantwortung", f: "Summary"},
  {k: "llm-v1:H4:11:A1", r: "bc0046fb-904e-34ec-b99e-496b7a2aa971", act: "mandate", obj: "Verschreibung an die Pfandherren von Burg und Stadt Friedberg", y: null, ev: "Er gebietet ihnen, unverzüglich nach Erhalt dieses Briefes", f: "Summary"},
  {k: "llm-v1:H4:12:A1", r: "14fad6d1-9af0-3648-ab34-6b66b02eb659", act: "commission", obj: "gütliche Einigung oder rechtliche Entscheidung im Streit um die Pfandschaft Friedberg", y: null, ev: "Er bevollmächtigt ihn, die Parteien vorzuladen", f: "Summary"},
  {k: "llm-v1:H4:13:A1", r: "823f1eb0-1fb6-32a6-a0e7-c73b33932495", act: "summons", obj: "Tag zu Frankfurt (11. November 1441)", y: null, ev: "nach Frankfurt anberaumten Tag", f: "Summary"},
  {k: "llm-v1:H4:14:A1", r: "93770d7c-4fd3-3b30-83ad-fb98e1ab381c", act: "communication", obj: "Ordnung des Hofgerichts", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit", f: "Summary"},
  {k: "llm-v1:H4:14:A2", r: "93770d7c-4fd3-3b30-83ad-fb98e1ab381c", act: "appointment", obj: "Hofrichter", y: null, ev: "zu unserm hofrichter in unserm kunigclichen hof ernannt", f: "Summary"},
  {k: "llm-v1:H4:14:A3", r: "93770d7c-4fd3-3b30-83ad-fb98e1ab381c", act: "credential", obj: null, y: null, ev: "welchen er hiermit zu mündlichem Bericht beglaubigt", f: "Summary"},
  {k: "llm-v1:H4:15:A1", r: "6404c1c8-e70b-3899-8caf-2014003bf0ae", act: "communication", obj: "Zusage zur Stadtsteuer gemäß Privileg", y: null, ev: "Kg. F. teilt Bürgermeistern und Rat der Stadt Frankfurt mit, er wolle ihre schriftlich vorgetragene Bitte", f: "Summary"},
  {k: "llm-v1:H4:16:A1", r: "9c7b2a59-93b5-3193-945e-794093962d67", act: "summons", obj: "Tag zu Frankfurt (15. April 1442)", y: null, ev: "einen gemainen tag nach Frankfurt angesetzt hat", f: "Summary"},
  {k: "llm-v1:H4:17:A1", r: "29a42154-fa53-3a26-be42-b44d482e1030", act: "prohibition", obj: "Prozeß gegen Memmingen, Dinkelsbühl und Bundesgenossen", y: null, ev: "Kg. F. verbietet dem Landrichter Bartholomäus Truchseß von Pommersfelden", f: "Summary"},
  {k: "llm-v1:H4:18:A1", r: "4f87316a-ad81-3298-bec1-04de3351aba9", act: "prohibition", obj: "Verfahren Hans Rot gegen Ulm am Landgericht Nürnberg", y: null, ev: "nichts mehr zu unternehmen und nicht zu richten", f: "Summary"},
  {k: "llm-v1:H4:19:A1", r: "2e81ad6e-e300-33b1-be57-69065eec15e8", act: "communication", obj: "Ungültigkeit der Acht gegen Ulm", y: null, ev: "Kg. F. teilt allen Reichsuntertanen und seinen erbländischen Untertanen mit", f: "Summary"},
  {k: "llm-v1:H4:19:A2", r: "2e81ad6e-e300-33b1-be57-69065eec15e8", act: "mandate", obj: "Ulmer nicht zu beeinträchtigen", y: null, ev: "befiehlt ihnen, diese Entscheidung zu befolgen", f: "Summary"},
  {k: "llm-v1:H4:20:A1", r: "8e95ecf8-9eb4-31bf-841b-c406be264e42", act: "prohibition", obj: "Beeinträchtigung aufgrund ungültiger Urteile des Landgerichts Nürnberg", y: null, ev: "Kg. F. verbietet allen Reichsuntertanen die weitere Beeinträchtigung", f: "Summary"},
