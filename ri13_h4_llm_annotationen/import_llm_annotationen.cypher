  {k: "llm-v1:H4:595:A1", r: "eefddfee-8e8d-3af6-84eb-4a2cb94d3593", act: "communication", obj: "Verlegung des Reichstages", y: null, ev: "die Verlegung des Reichstages mit.", f: "Summary"},
